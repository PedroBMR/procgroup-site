# Configuração de servidor para a Hostinger (Apache/cPanel).
#
# Fica em public/ porque o Astro copia essa pasta como está para a raiz do
# build — então este arquivo chega em public_html junto com o site.
#
# ATENÇÃO: nada aqui vale no GitHub Pages, que ignora .htaccess. Só entra em
# vigor no deploy para a Hostinger.

# ---------------------------------------------------------------------------
# Página de erro
# ---------------------------------------------------------------------------
# Gerada por src/pages/404.astro. O caminho pressupõe o site na RAIZ do domínio,
# que é o estado de produção (base: '/'). Enquanto o build sair com
# base: '/procgroup-site', ajuste para /procgroup-site/404.html.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Enderecos do site antigo (virada de 2026-09-25)
# ---------------------------------------------------------------------------
# O WordPress deixou 7 paginas e 19 posts indexados. Sem estes 301 o historico
# de busca deles morre no dia da troca, e o blog e metade do conteudo indexado
# da Proc. As regras vem ANTES de qualquer outra reescrita de conteudo.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Posts: /AAAA/MM/DD/slug/ -> /blog/slug. Uma regra cobre os 19 e os que
  # vierem, porque o padrao de data e do WordPress, nao de cada post.
  RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/([^/]+)/?$ /blog/$4 [R=301,L]

  # Categorias. Novidades tem equivalente; Eventos e Tudo sobre tecnologia nao
  # geram pagina propria no site novo, entao caem na listagem do blog.
  RewriteRule ^category/novidades/?$ /blog/categoria/novidades [R=301,L]
  RewriteRule ^category/[^/]+/?$ /blog [R=301,L]

  # As 59 tags do WordPress nao existem no site novo.
  RewriteRule ^tag/[^/]+/?$ /blog [R=301,L]

  # Paginas que mudaram de endereco.
  RewriteRule ^infraestrutura-de-ti/?$ /solucoes/infraestrutura-de-ti [R=301,L]
  RewriteRule ^sobre-nos/?$ /empresa [R=301,L]

  # /seguranca-publica ficou RESERVADA para o site de cidade e governo, que
  # ainda nao existe (decisao do Pedro em 2026-09-25). Ate la, home: cidade e
  # governo sairam deste site em 2026-08-27 e nenhuma pagina daqui responde
  # pela promessa que essa busca carrega.
  RewriteRule ^seguranca-publica/?$ / [R=301,L]

  # Restos do WordPress: sem PHP no ar, estes enderecos so gerariam 404.
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) / [R=301,L]
  RewriteRule ^feed/?$ /blog [R=301,L]
  RewriteRule ^comments/feed/?$ /blog [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Canonicalizacao apex <-> www: NAO habilitada de proposito.
# Verificado em 2026-09-25: o servidor ja responde 301 de www.procgroup.com.br
# para procgroup.com.br sozinho, e o site inteiro (canonical, og:url, hreflang,
# sitemap) usa a forma SEM www. Uma regra aqui na mesma direcao geraria loop.
#
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} ^procgroup\.com\.br$ [NC]
#   RewriteRule ^ https://www.procgroup.com.br%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------------------
# Cabeçalhos de segurança
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Impede o navegador de "adivinhar" o tipo do arquivo e executar como script
  # algo que foi servido como outra coisa.
  Header always set X-Content-Type-Options "nosniff"

  # Não vaza o caminho completo da página de origem para sites externos.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Bloqueia clickjacking. frame-ancestors (abaixo) cobre navegadores modernos;
  # este fica para os antigos.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Recursos que este site nunca usa.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # HSTS: só ative depois de confirmar que TODOS os subdomínios servem HTTPS —
  # o navegador passa a recusar HTTP por 1 ano e não há como voltar atrás rápido.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP parcial, deliberadamente SEM script-src.
  #
  # O Astro embute scripts de componentes como <script type="module"> inline
  # (menu do header, StatCounter, e o IIFE de /evento) — 68 blocos no build
  # atual. Um script-src 'self' quebraria todos eles, e um script-src
  # 'unsafe-inline' seria proteção de fachada. As diretivas abaixo, porém, não
  # dependem disso e valem por si:
  #   frame-ancestors  clickjacking
  #   base-uri         impede injetar <base> e sequestrar caminhos relativos
  #   form-action      impede que um POST seja desviado para outro domínio
  #   object-src       mata <object>/<embed>
  # Para ganhar script-src, seria preciso externalizar esses scripts inline ou
  # gerar hashes no build. Registrado no ROADMAP.
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Tudo em /_astro/ tem hash de conteúdo no nome: se o conteúdo muda, o nome
  # muda. Pode ser cacheado para sempre.
  <FilesMatch "\.(js|css|woff2?)$">
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>

  # O HTML é o que aponta para os assets com hash — precisa ser revalidado,
  # senão o visitante fica preso numa versão antiga da página.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# Compressão
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/ld+json
</IfModule>

# ---------------------------------------------------------------------------
# Exposição desnecessária
# ---------------------------------------------------------------------------
# Sem listagem de diretório quando falta um index.
Options -Indexes

# Arquivos ocultos e de configuração nunca devem ser servidos.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
