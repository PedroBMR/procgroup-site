---
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../utils/url";
import { ehProducao } from "../utils/deploy";
import { socialProfiles } from "../data/social";
import { getLangFromUrl, useTranslations, logicalPath, localePath, isSingleVersionPath, isPtOnlyContentPath } from "../i18n/utils";
import { locales, defaultLocale, htmlLangAttr, ogLocaleAttr } from "../i18n/config";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/fonts.css";
// URLs com hash dos arquivos que valem preload: o peso 800 da display (todo
// h1/h2) e a variável Space Grotesk (corpo inteiro). O Vite dedupe com o
// url() do fonts.css — não duplica o asset.
import barlow800Url from "../assets/fonts/barlow-condensed-800.woff2?url";
import spaceGroteskUrl from "../assets/fonts/space-grotesk-var.woff2?url";
import { metricool, pixelMetricool } from "../data/medicao";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Página sem o chrome do site: sem TopBar, Header nem Footer. Para páginas
   * que existem para uma decisão só e trazem a própria barra de marca — hoje
   * a abertura da home. Não confundir com uma landing solta: o <head> continua vindo
   * daqui, então canonical, hreflang, OG, schema e o noindex de preview seguem
   * corretos.
   */
  bare?: boolean;
  /**
   * Força `noindex,nofollow` numa página específica (404, /evento). Fora isso
   * NÃO precisa ser passado: enquanto o build não sai no domínio da Proc, o
   * padrão já é `true` — ver o cálculo de `bloquearIndexacao` abaixo.
   */
  noIndex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  // PNG, não SVG: Facebook, LinkedIn e WhatsApp não renderizam SVG em
  // og:image — o card saía sem imagem nenhuma. Gerado por scripts/gerar-og.mjs
  // a partir de src/assets/og-default.svg.
  ogImage = "/og-default.png",
  schema,
  noIndex,
  bare = false,
} = Astro.props;

// Enquanto o site é preview no github.io, TODA página sai com noindex.
//
// O robots.txt sozinho não resolve: robô lê robots.txt só na raiz da origem, e
// com `base: '/procgroup-site'` o nosso é servido num subcaminho que ninguém
// consulta. A meta é o que impede a entrada no índice, mesmo que alguém linke
// a página de fora.
//
// Sai sozinho na virada: quando `site` virar www.procgroup.com.br no
// astro.config.mjs (PUBLICACAO.md 3.1), `ehProducao` passa a ser true e o
// padrão vira false. Não há nada para lembrar de reverter — de propósito, já
// que um noindex esquecido em produção não quebra nada visualmente e faria o
// site oficial nascer invisível no Google.
//
// Uma página ainda pode forçar noindex explicitamente (404, /evento).
const bloquearIndexacao = noIndex ?? !ehProducao(Astro.site?.host);

const siteName = "Proc Group";
const siteUrl = "https://procgroup.com.br";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// path comes from Astro.url.pathname by default, which already includes the
// GitHub Pages base prefix (e.g. /procgroup-site). siteUrl is the future
// custom domain, which will serve from root, so strip the base before
// building canonical/og URLs.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalPath = base && path.startsWith(base) ? path.slice(base.length) || "/" : path;
// Caminho lógico (sem base, sem prefixo de idioma). Serve ao canonical do blog
// logo abaixo e ao hreflang mais adiante.
const logical = logicalPath(Astro.url);
// O blog tem casca nos três idiomas e o MESMO texto português nos três. As
// versões /en e /es apontam canonical para a portuguesa: sem isso as três
// competiriam entre si como conteúdo duplicado e o buscador escolheria uma na
// sorte. O visitante não perde nada — continua navegando no idioma que pediu.
const canonical = new URL(isPtOnlyContentPath(logical) ? logical : canonicalPath, siteUrl).toString();

// A imagem social é o único caso que NÃO pode usar siteUrl: o canonical aponta
// para o domínio futuro (www.procgroup.com.br), que ainda não serve os arquivos
// — /og-default.png dá 404 lá. Um card compartilhado hoje sairia sem imagem.
// Por isso o og:image é montado contra a origem real de deploy (Astro.site +
// base), que o Astro mantém em sincronia com o host atual (github.io). Quando o
// domínio próprio entrar no ar, basta ajustar `site`/`base` no astro.config.
// As capas do blog chegam já com o prefixo de base (astro:assets); removemos e
// recolocamos para não duplicar.
const ogPath = base && ogImage.startsWith(base) ? ogImage.slice(base.length) : ogImage;
const deployOrigin = Astro.site ?? new URL(siteUrl);
const ogImageUrl = new URL(base + ogPath, deployOrigin).toString();

// i18n: idioma da URL + versões alternativas da página em cada idioma (hreflang).
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const htmlLang = htmlLangAttr[lang];
const ogLocale = ogLocaleAttr[lang];
// Duas situações em que não existe alternativa de idioma para declarar:
//  - /404 existe numa versão só. Apontar hreflang para /es/404 gerava uma
//    alternativa que dá 404, e o Google descarta o cluster inteiro quando isso
//    acontece.
//  - o blog tem três URLs, mas com o mesmo texto português nas três. São a
//    mesma página com o menu traduzido, não traduções uma da outra; quem manda
//    nelas é o canonical acima.
const semAlternativaDeIdioma = isSingleVersionPath(logical) || isPtOnlyContentPath(logical);
const alternates = semAlternativaDeIdioma
  ? []
  : locales.map((l) => ({
      lang: l,
      hrefLang: htmlLangAttr[l],
      href: new URL(localePath(logical, l), siteUrl).toString(),
    }));
const xDefault = semAlternativaDeIdioma ? null : new URL(localePath(logical, defaultLocale), siteUrl).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Proc Group",
  url: siteUrl,
  logo: `${siteUrl}/brand/mark-red.webp`,
  description:
    "Plataforma de Inteligência Artificial, Visão Computacional e Infraestrutura de TI para cidades, empresas e indústrias.",
  foundingDate: "2014",
  email: "comercial@procgroup.com.br",
  telephone: "+55-46-3224-3532",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Caetano Munhoz da Rocha, 480",
    addressLocality: "Pato Branco",
    addressRegion: "PR",
    addressCountry: "BR",
  },
  sameAs: socialProfiles.map((s) => s.href),
};

// Escapar `<` evita que um "</script>" literal em qualquer texto do schema
// (títulos de post vêm do WordPress) feche a tag e injete markup no head.
const ldjson = (s: Record<string, unknown>) => JSON.stringify(s).replace(/</g, "\\u003c");

const schemaList = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Scroll-reveal starts elements at opacity:0 and relies on the JS observer
        below to show them. If JS never runs, force everything visible so the
        page is never left blank. */}
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>
    {/* Tres formatos de proposito. O .ico e o unico que todo navegador aceita,
        e e o que o navegador busca sozinho em /favicon.ico quando nao entende o
        resto. O PNG cobre aba e atalho. O WebP fica por ultimo: e o mais leve,
        mas o Safari nao o aceita como icone, e ate 2026-09-25 era o unico
        declarado, o que deixava a Proc sem icone em parte dos navegadores. O
        apple-touch-icon vai sobre o navy porque o iOS pinta transparencia de
        preto. */}
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/webp" href={withBase("/brand/mark-red.webp")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hrefLang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {bloquearIndexacao && <meta name="robots" content="noindex,nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Fontes self-hosted (ver src/styles/fonts.css) — sem render-blocking do
        Google e sem IP de visitante saindo do site. crossorigin é obrigatório
        em preload de fonte mesmo same-origin (fetch em modo CORS). */}
    <link rel="preload" href={barlow800Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskUrl} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={ldjson(organizationSchema)} />
    {schemaList.map((s) => <script type="application/ld+json" set:html={ldjson(s)} />)}
  </head>
  <body>
    {/* Pixel de medicao de audiencia. Desligado ate a Politica de Privacidade
        citar a ferramenta: ver src/data/medicao.ts, que explica o porque e e o
        unico lugar onde se liga. */}
    {metricool.ativo && (
      <img
        src={pixelMetricool}
        alt=""
        aria-hidden="true"
        width="1"
        height="1"
        decoding="async"
        style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none"
      />
    )}
    <a href="#main" class="visually-hidden">{t.common.skipLink}</a>
    {!bare && <TopBar />}
    {!bare && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}

    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
