---
/**
 * Preview das três páginas de área de negócio.
 *
 * TEMPORÁRIO, fora do site no ar. Usa o BusinessUnitTemplate de produção, o
 * mesmo das páginas de solução que estão publicadas: a área vai como unidade
 * pronta (`unit`) e as soluções do documento vão como conteúdo longo
 * (`richDaArea`). Antes esta página tinha CSS próprio e por isso parecia de
 * outro site.
 *
 * Os blocos que eu reescrevi por causa de regra de LGPD aparecem com o aviso
 * dentro do próprio bloco, dizendo o que saiu e por quê.
 */
import BusinessUnitTemplate from "../../components/BusinessUnitTemplate.astro";
import AvisoPreview from "../../components/preview/AvisoPreview.astro";
import { areas, unidades, unidadeDaArea, richDaArea, navPreview } from "../../data/preview/ajustes";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const unit = unidadeDaArea(area);
const outras = unidades.filter((u) => u.slug !== area.slug);
---

<BusinessUnitTemplate
  slug={area.slug}
  unit={unit}
  outras={outras}
  rich={richDaArea(area)}
  nav={navPreview()}
  metaTitle={`Preview: ${area.nome}`}
  metaDescription="Preview interno da reestruturação do site."
  heroTitle={area.chamada}
  heroLead={area.subchamada}
  solutionsHeading={`Nossas soluções em ${area.nome}`}
  teamDescription={area.fecho.texto}
  faqs={[]}
  finalCtaTitle={area.fecho.titulo}
  finalCtaText={area.fecho.texto}
  noIndex
>
  <AvisoPreview slot="aviso" />
</BusinessUnitTemplate>
