---
/**
 * As três páginas de área de negócio, como ficariam no ar.
 *
 * Fora do site publicado, mas sem nada de preview na tela: usa o
 * BusinessUnitTemplate de produção, o mesmo das páginas de solução que já
 * estão no ar. A área vai como unidade pronta (`unit`) e as soluções do
 * documento vão como conteúdo longo (`richDaArea`).
 *
 * Três blocos de Visão Computacional estão com o texto REESCRITO por causa das
 * regras de LGPD. O que saiu e por quê está em AUDITORIA-AJUSTES-SITE.md, não
 * mais na tela: aqui fica só o texto que eu publicaria.
 */
import BusinessUnitTemplate from "../../components/BusinessUnitTemplate.astro";
import { areas, unidades, unidadeDaArea, richDaArea, navPreview } from "../../data/preview/ajustes";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const unit = unidadeDaArea(area);
const outras = unidades.filter((u) => u.slug !== area.slug);
---

<BusinessUnitTemplate
  slug={area.slug}
  unit={unit}
  outras={outras}
  rich={richDaArea(area)}
  nav={navPreview()}
  metaTitle={area.nome}
  metaDescription={area.subchamada}
  heroTitle={area.chamada}
  heroLead={area.subchamada}
  solutionsHeading={`Nossas soluções em ${area.nome}`}
  teamDescription={area.fecho.texto}
  faqs={[]}
  finalCtaTitle={area.fecho.titulo}
  finalCtaText={area.fecho.texto}
  noIndex
/>
