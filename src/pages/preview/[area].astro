---
/**
 * As três páginas de área de negócio, com o conteúdo INTEGRAL do documento
 * "Ajustes no site". Fora do site publicado, sem nada de preview na tela.
 *
 * Até 2026-10-06 esta página encaixava o documento no BusinessUnitTemplate,
 * e o que não cabia no molde ficou de fora. O comercial apontou que faltava
 * muita coisa, e faltava: medido, só 27% das palavras do PDF estavam na tela.
 * Agora cada página é transcrita bloco a bloco em src/data/preview/paginas/.
 */
import PaginaPreview from "../../components/preview/PaginaPreview.astro";
import { infra } from "../../data/preview/paginas/infra";
import { nuvem } from "../../data/preview/paginas/nuvem";
import { visao } from "../../data/preview/paginas/visao";
import type { Pagina } from "../../data/preview/blocos";

const PAGINAS: Record<string, { pagina: Pagina; title: string }> = {
  "infraestrutura-de-ti": { pagina: infra, title: "Infraestrutura de TI" },
  "hospedagem-em-nuvem": { pagina: nuvem, title: "Hospedagem em Nuvem" },
  "visao-computacional": { pagina: visao, title: "Visão Computacional e Vídeo Analytics" },
};

export function getStaticPaths() {
  return ["infraestrutura-de-ti", "hospedagem-em-nuvem", "visao-computacional"].map((area) => ({
    params: { area },
  }));
}

const { pagina, title } = PAGINAS[Astro.params.area as string];
---

<PaginaPreview pagina={pagina} title={title} description={pagina.hero.lead ?? pagina.hero.titulo} />
