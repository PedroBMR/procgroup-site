---
/**
 * Preview da página A Proc, reescrita conforme o documento de 2026-10-05.
 *
 * TEMPORÁRIO, fora do site no ar. Usa as mesmas seções da página Empresa
 * publicada: hero, faixa clara com a linha do tempo, cards de diferencial,
 * missão e visão. Antes esta página tinha fundo e tipografia próprios.
 *
 * Dois avisos aparecem na tela, os dois na auditoria: a atuação em Paraguai,
 * Argentina e Bolívia (R3) e a construção "referência nacional" dentro da
 * Visão, que a skill contexto-proc proíbe.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import AvisoPreview from "../../components/preview/AvisoPreview.astro";
import Button from "../../components/Button.astro";
import { withBase } from "../../utils/url";
import { aProc, navPreview } from "../../data/preview/ajustes";
---

<BaseLayout
  title="Preview: A Proc"
  description="Preview interno da reestruturação do site."
  nav={navPreview()}
  noIndex
>
  <AvisoPreview slot="aviso" />

  <section class="hero-page">
    <div class="container">
      <p class="eyebrow">{aProc.titulo}</p>
      <h1>{aProc.chamada}</h1>
      {aProc.intro.map((p) => <p class="lead">{p}</p>)}
    </div>
  </section>

  <section class="section banda" data-theme="light">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Nossa história</p>
        <h2>Mais de uma década sustentando operações críticas</h2>
      </div>
      <div class="tempo">
        {aProc.linhaDoTempo.map((m) => (
          <div class="marco" data-reveal>
            <span class="ano">{m.ano}</span>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section banda">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Nosso diferencial</p>
        <h2>Tecnologia pode ser adquirida. Experiência precisa ser construída.</h2>
      </div>
      <div class="grade-4">
        {aProc.diferenciais.map((d) => (
          <div class="cartao" data-reveal>
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section banda" data-theme="light">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Alcance</p>
        <h2>{aProc.alcance.titulo}</h2>
        <p class="lead">{aProc.alcance.texto}</p>
      </div>
      <p class="alerta" data-reveal>
        <strong>Precisa de confirmação antes de publicar.</strong> {aProc.alcance.alerta}
      </p>
    </div>
  </section>

  <section class="section banda">
    <div class="container">
      <div class="grade-3">
        <div class="cartao" data-reveal>
          <p class="eyebrow">Nossa Missão</p>
          <p class="mv">{aProc.missao}</p>
        </div>
        <div class="cartao" data-reveal>
          <p class="eyebrow">Nossa Visão</p>
          <p class="mv">{aProc.visao}</p>
          <p class="alerta pequeno">
            <strong>Atenção.</strong> A skill contexto-proc proíbe construções de superioridade e
            cita "referência nacional" entre elas. Isto já está no site hoje, dentro da Visão.
            Decisão sua: mantém como aspiração declarada ou sai.
          </p>
        </div>
        <div class="cartao" data-reveal>
          <p class="eyebrow">Nosso Propósito</p>
          <p class="mv">{aProc.proposito}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section banda" data-theme="light">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Três pilares</p>
        <h2>Sustentar, proteger, transformar</h2>
      </div>
      <div class="grade-3">
        {aProc.pilares.map((p) => (
          <div class="cartao" data-reveal>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section fecho">
    <div class="container fecho-inner" data-reveal>
      <h2>Proc Group. Tecnologia especializada para empresas que não podem parar.</h2>
      <Button href={withBase("/preview/solucoes")} variant="primary" size="lg" data-magnetic>
        Conheça nossas soluções
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-page { padding-block: var(--space-16) var(--space-8); }
  .hero-page h1 { font-size: var(--fs-4xl); margin-top: var(--space-4); max-width: 24ch; }
  .lead { margin-top: var(--space-5); max-width: 72ch; font-size: var(--fs-base); color: var(--color-text-muted); line-height: 1.6; }
  .hero-page .lead:first-of-type { font-size: var(--fs-lg); }

  .section { padding-block: var(--space-16); }
  .banda { background: var(--color-bg); }
  .section-header { max-width: 760px; margin-bottom: var(--space-12); }
  .section-header h2 { margin-top: var(--space-4); font-size: var(--fs-3xl); }

  .tempo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .marco { padding-top: var(--space-5); border-top: 2px solid var(--color-primary); }
  .ano { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); color: var(--color-eyebrow); letter-spacing: 0.06em; }
  .marco h3 { margin-top: var(--space-2); font-size: var(--fs-lg); }
  .marco p { margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--color-text-muted); line-height: 1.55; }

  .grade-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
  .grade-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .cartao {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .cartao h3 { font-size: var(--fs-base); }
  .cartao p { margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--color-text-muted); line-height: 1.55; }
  .mv { margin-top: var(--space-4) !important; }

  .alerta {
    max-width: 76ch;
    padding: var(--space-5);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: rgba(226, 8, 29, 0.07);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .alerta strong { color: var(--color-text); }
  .alerta.pequeno { margin-top: var(--space-4); padding: var(--space-4); }

  .fecho { text-align: center; padding-block: var(--space-16) var(--space-24); }
  .fecho-inner h2 { font-size: var(--fs-3xl); max-width: 26ch; margin-inline: auto; margin-bottom: var(--space-8); }

  @media (max-width: 1000px) { .grade-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .tempo, .grade-3, .grade-4 { grid-template-columns: 1fr; } }
</style>
