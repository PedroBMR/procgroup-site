---
/**
 * Preview do índice de Soluções: as três áreas e o que cada uma reúne.
 * TEMPORÁRIO, fora do site no ar.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CabecalhoAjustes from "../../components/preview/CabecalhoAjustes.astro";
import { withBase } from "../../utils/url";
import { areas } from "../../data/preview/ajustes";
---

<BaseLayout title="Preview: Soluções" description="Preview interno da reestruturação do site." bare noIndex>
  <CabecalhoAjustes atual="/preview/solucoes" />

  <main>
    <section class="topo-pagina">
      <div class="caixa">
        <p class="eyebrow">Soluções</p>
        <h1>Três áreas de negócio. Uma equipe especializada em cada uma.</h1>
        <p class="sub">
          A apresentação segue a ordem definida no documento: Infraestrutura de TI, Hospedagem em
          nuvem, Visão Computacional e Vídeo Analytics.
        </p>
      </div>
    </section>

    <section class="grade">
      <div class="caixa cards">
        {areas.map((a, i) => (
          <a class="card" href={withBase(`/preview/${a.slug}`)}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <h2>{a.nome}</h2>
            <p class="chamada">{a.chamada}</p>
            <ul>
              {a.solucoes.slice(0, 6).map((s) => <li>{s.titulo}</li>)}
              {a.solucoes.length > 6 && <li class="mais">e mais {a.solucoes.length - 6}</li>}
            </ul>
            <span class="ir">Conheça a área</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main { background: var(--navy-950); color: var(--white); min-height: 70vh; }
  .caixa { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-6); }
  .eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }

  .topo-pagina { padding-block: var(--space-24) var(--space-8); }
  .topo-pagina h1 { margin-top: var(--space-4); font-size: clamp(1.9rem, 3.4vw, 3rem); max-width: 22ch; color: var(--white); }
  .sub { margin-top: var(--space-5); color: rgba(255,255,255,0.68); max-width: 64ch; }

  .grade { padding-block: var(--space-12) var(--space-24); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .card {
    display: flex; flex-direction: column;
    padding: var(--space-8);
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    background: rgba(255,255,255,0.03);
    text-decoration: none; color: inherit;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) ease;
  }
  .card:hover { border-color: rgba(255,74,84,0.5); transform: translateY(-3px); }
  .n { font-family: ui-monospace, Consolas, monospace; font-size: var(--fs-xs); color: var(--red-400); letter-spacing: 0.12em; }
  .card h2 { margin-top: var(--space-3); font-size: var(--fs-xl); color: var(--white); }
  .chamada { margin-top: var(--space-3); font-size: var(--fs-sm); color: rgba(255,255,255,0.7); line-height: var(--lh-normal); }
  .card ul { margin-top: var(--space-5); padding: 0; list-style: none; display: grid; gap: var(--space-1); flex: 1; }
  .card li { font-size: var(--fs-xs); color: rgba(255,255,255,0.55); }
  .card li::before { content: "› "; color: var(--red-400); }
  .mais { font-style: italic; }
  .ir { margin-top: var(--space-6); font-size: var(--fs-sm); font-weight: 700; color: var(--red-400); }

  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }
</style>
