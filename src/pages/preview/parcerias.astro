---
/**
 * Preview da página Seja um Parceiro da Proc.
 * TEMPORÁRIO, fora do site no ar.
 *
 * O modelo de Indicação de Oportunidades aparece BLOQUEADO na tela, com o
 * motivo. São dois travamentos, os dois na auditoria: o formulário coleta dado
 * pessoal de terceiro sem base legal declarada (R2), e as 12 regras citam um
 * regulamento completo que ainda não existe (R4).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CabecalhoAjustes from "../../components/preview/CabecalhoAjustes.astro";
import { withBase } from "../../utils/url";
import { parcerias } from "../../data/preview/ajustes";
---

<BaseLayout title="Preview: Parcerias" description="Preview interno da reestruturação do site." bare noIndex>
  <CabecalhoAjustes atual="/preview/parcerias" />

  <main>
    <section class="topo-pagina">
      <div class="caixa">
        <p class="eyebrow">{parcerias.titulo}</p>
        <h1>{parcerias.chamada}</h1>
        <p class="intro">{parcerias.intro}</p>
      </div>
    </section>

    <section class="modelos">
      <div class="caixa">
        {parcerias.modelos.map((m, i) => (
          <article class:list={["modelo", { travado: !!m.bloqueio }]}>
            <header>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2>{m.titulo}</h2>
                <p class="chamada">{m.chamada}</p>
              </div>
            </header>

            <p class="texto">{m.texto}</p>

            <ol class="passos">
              {m.passos.map((p) => <li>{p}</li>)}
            </ol>

            {m.bloqueio && (
              <aside class="bloqueio">
                <p class="bloqueio-titulo">Não entra no ar ainda</p>
                <p>{m.bloqueio}</p>
              </aside>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="fecho">
      <div class="caixa">
        <h2>A tecnologia funciona melhor quando pessoas e empresas trabalham juntas.</h2>
        <p>Vamos crescer juntos. Fale com nossa equipe sobre a parceria ideal para seu negócio.</p>
        <a class="btn" href={withBase("/contato")}>Fale com nossa equipe</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main { background: var(--navy-950); color: var(--white); }
  .caixa { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-6); }
  .eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }

  .topo-pagina { padding-block: var(--space-24) var(--space-10); }
  .topo-pagina h1 { margin-top: var(--space-4); font-size: clamp(2rem, 3.6vw, 3.2rem); color: var(--white); }
  .intro { margin-top: var(--space-5); max-width: 72ch; color: rgba(255,255,255,0.68); line-height: var(--lh-normal); }

  .modelos { padding-bottom: var(--space-16); }
  .modelos .caixa { display: grid; gap: var(--space-6); }
  .modelo { padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,255,255,0.03); }
  .modelo.travado { border-style: dashed; border-color: rgba(255,74,84,0.45); }
  .modelo header { display: flex; gap: var(--space-5); align-items: flex-start; }
  .n { font-family: ui-monospace, Consolas, monospace; font-size: var(--fs-lg); font-weight: 700; color: var(--red-400); }
  .modelo h2 { font-size: var(--fs-xl); color: var(--white); }
  .chamada { margin-top: var(--space-2); font-weight: 600; color: rgba(255,255,255,0.8); }
  .texto { margin-top: var(--space-5); max-width: 76ch; color: rgba(255,255,255,0.62); line-height: var(--lh-normal); }

  .passos { margin-top: var(--space-6); padding-left: var(--space-6); display: grid; gap: var(--space-2); }
  .passos li { font-size: var(--fs-sm); color: rgba(255,255,255,0.6); }

  .bloqueio {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-left: 3px solid var(--red-400);
    border-radius: var(--radius-sm);
    background: rgba(226, 8, 29, 0.1);
    font-size: var(--fs-xs);
    color: rgba(255,255,255,0.78);
  }
  .bloqueio-titulo { font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--red-400); margin-bottom: var(--space-2); }

  .fecho { padding-block: var(--space-16) var(--space-24); text-align: center; }
  .fecho h2 { font-size: var(--fs-2xl); color: var(--white); max-width: 26ch; margin-inline: auto; }
  .fecho p { margin: var(--space-5) auto 0; max-width: 60ch; color: rgba(255,255,255,0.68); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; margin-top: var(--space-8); padding-inline: var(--space-6); border-radius: var(--radius-pill); background: var(--color-primary); color: var(--white); font-weight: 700; font-size: var(--fs-sm); text-decoration: none; }
</style>
