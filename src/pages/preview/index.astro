---
/**
 * Preview da home reestruturada, conforme o documento de 2026-10-05.
 *
 * TEMPORÁRIO, fora do site no ar. Usa o mesmo herói da home publicada, com a
 * CenaTelemetria atrás e os mesmos tamanhos de tipo, e as mesmas faixas de
 * seção. Antes tinha fundo e tipografia próprios, e por isso parecia outro
 * site.
 *
 * Sobre o sorteio dos heróis: o documento pede quatro heróis alternando
 * aleatoriamente. Aqui ele sorteia a cada carregamento, e os botões trocam na
 * mão, porque senão não dá para ver os quatro. Isso deixa visível o problema
 * do R6 da auditoria: cada herói traz um H1 diferente para a mesma URL.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import AvisoPreview from "../../components/preview/AvisoPreview.astro";
import Button from "../../components/Button.astro";
import CenaTelemetria from "../../components/CenaTelemetria.astro";
import UnitIcon from "../../components/UnitIcon.astro";
import { withBase } from "../../utils/url";
import { herois, oQueFazemos, unidades, navPreview } from "../../data/preview/ajustes";
---

<BaseLayout
  title="Preview: home reestruturada"
  description="Preview interno da reestruturação do site."
  nav={navPreview()}
  noIndex
>
  <AvisoPreview slot="aviso" />

  <section class="hero">
    <CenaTelemetria />

    <div class="container trocador" role="group" aria-label="Trocar herói">
      <span class="trocador-rotulo">Herói</span>
      {herois.map((h, i) => (
        <button type="button" data-ir={i} class:list={["trocador-botao", { ativo: i === 0 }]}>
          {h.rotulo}
        </button>
      ))}
      <span class="trocador-nota">o documento pede sorteio a cada visita</span>
    </div>

    {herois.map((h, i) => (
      <div class:list={["container", "hero-inner", { ativo: i === 0 }]} data-heroi={i}>
        <p class="eyebrow">{h.rotulo}</p>
        <h1>{h.titulo}</h1>
        <p class="hero-subtitle">{h.sub}</p>
        <p class="hero-texto">{h.texto}</p>
        <div class="hero-actions">
          <Button href={withBase(h.cta.href)} variant="primary" size="md" data-magnetic>{h.cta.label}</Button>
          <Button href={withBase(h.cta2.href)} variant="ghost" size="md" data-magnetic>{h.cta2.label}</Button>
        </div>
      </div>
    ))}
  </section>

  <section class="section" data-theme="light">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="eyebrow">{oQueFazemos.eyebrow}</p>
        <h2>{oQueFazemos.titulo}</h2>
        <p class="lead">{oQueFazemos.texto}</p>
      </div>
      <div class="cards">
        {oQueFazemos.cards.map((c, i) => (
          <a href={withBase(c.cta.href)} class="card" data-reveal style={`--unit-color: ${unidades[i].color}`}>
            <span class="card-icone"><UnitIcon slug={unidades[i].slug} /></span>
            <h3>{c.titulo}</h3>
            <p class="card-chamada">{c.chamada}</p>
            <p class="card-texto">{c.texto}</p>
            <span class="card-ir">{c.cta.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section fecho">
    <div class="container fecho-inner" data-reveal>
      <h2>{oQueFazemos.fecho.titulo}</h2>
      <p>{oQueFazemos.fecho.texto}</p>
      <Button href={withBase("/contato")} variant="primary" size="lg" data-magnetic>
        {oQueFazemos.fecho.cta}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* Mesmos valores do herói da home publicada. */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--topbar-h) - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (max-width: 1200px) {
    .hero { min-height: calc(100svh - var(--topbar-h) - var(--header-h-mobile)); }
  }
  .hero-inner { position: relative; z-index: 2; max-width: 920px; padding-block: var(--space-12); display: none; }
  .hero-inner.ativo { display: block; }
  .hero h1 { color: var(--white); font-size: clamp(2.25rem, 2.2rem + 2.6vw, 4rem); margin-top: var(--space-4); }
  .hero-subtitle { margin-top: var(--space-6); font-size: var(--fs-lg); color: rgba(255, 255, 255, 0.75); max-width: 620px; }
  .hero-texto { margin-top: var(--space-4); font-size: var(--fs-sm); color: rgba(255, 255, 255, 0.58); max-width: 680px; line-height: 1.6; }
  .hero-actions { display: flex; gap: var(--space-4); margin-top: var(--space-8); flex-wrap: wrap; }

  /* Controle que só existe no preview: o site sorteia e pronto. */
  .trocador {
    position: relative; z-index: 3;
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    padding-top: var(--space-6);
  }
  .trocador-rotulo { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.5); margin-right: var(--space-2); }
  .trocador-botao {
    min-height: 32px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--fs-xs); font-weight: 600;
  }
  .trocador-botao:hover { color: var(--white); border-color: var(--color-border-strong); }
  .trocador-botao.ativo { background: var(--color-primary); border-color: transparent; color: var(--white); }
  .trocador-nota { font-size: var(--fs-xs); color: rgba(255, 255, 255, 0.42); }

  .section { padding-block: var(--space-24); background: var(--color-bg); }
  .section-header { max-width: 760px; margin-bottom: var(--space-12); }
  .section-header h2 { margin-top: var(--space-4); font-size: var(--fs-3xl); }
  .lead { margin-top: var(--space-6); font-size: var(--fs-base); color: var(--color-text-muted); max-width: 70ch; line-height: 1.6; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .card {
    position: relative;
    display: flex; flex-direction: column;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease;
  }
  .card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: color-mix(in srgb, var(--unit-color), white 24%);
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--unit-color), white 36%); }
  /* Cor cheia da unidade: esta faixa é clara, e o tom clareado com branco que
     os cards escuros usam some sobre o branco. */
  .card-icone { color: var(--unit-color); }
  .card-icone :global(.unit-icon) { width: 28px; height: 28px; }
  .card h3 { margin-top: var(--space-4); font-size: var(--fs-lg); }
  .card-chamada { margin-top: var(--space-3); font-size: var(--fs-sm); font-weight: 600; color: var(--color-text); }
  .card-texto { margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--color-text-muted); line-height: 1.55; flex: 1; }
  .card-ir { margin-top: var(--space-6); font-size: var(--fs-sm); font-weight: 700; color: var(--color-eyebrow); }

  .fecho { text-align: center; padding-block: var(--space-16) var(--space-24); }
  .fecho-inner h2 { font-size: var(--fs-3xl); max-width: 26ch; margin-inline: auto; }
  .fecho-inner p { margin: var(--space-5) auto var(--space-8); max-width: 72ch; color: var(--color-text-muted); line-height: 1.6; }

  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }
</style>

<script>
  // Sorteia um herói na carga e deixa trocar na mão. Só existe no preview.
  const paineis = Array.from(document.querySelectorAll<HTMLElement>("[data-heroi]"));
  const botoes = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-ir]"));

  const mostrar = (i: number) => {
    paineis.forEach((p, n) => p.classList.toggle("ativo", n === i));
    botoes.forEach((b, n) => b.classList.toggle("ativo", n === i));
  };

  if (paineis.length > 0) {
    mostrar(Math.floor(Math.random() * paineis.length));
    botoes.forEach((b) => b.addEventListener("click", () => mostrar(Number(b.dataset.ir))));
  }
</script>
