---
/**
 * A home reestruturada, como ficaria no ar.
 *
 * Fora do site publicado, mas sem nada de preview na tela. Mesmo herói da home
 * de hoje, com a CenaTelemetria atrás, e as mesmas faixas de seção.
 *
 * Os quatro heróis alternam em carrossel de 10 s (HeroCarrossel), e as três
 * áreas viram um ecossistema ligado por um trilho (CardsEcossistema). Redesign
 * de 2026-10-20: só apresentação, o texto continua todo em ajustes.ts.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import HeroCarrossel from "../../components/preview/HeroCarrossel.astro";
import CardsEcossistema from "../../components/preview/CardsEcossistema.astro";
import { withBase } from "../../utils/url";
import { oQueFazemos, navPreview } from "../../data/preview/ajustes";
---

<BaseLayout
  title="Tecnologia para operações críticas"
  description="Infraestrutura de TI, hospedagem em nuvem e visão computacional com IA para empresas que não podem parar."
  nav={navPreview()}
  noIndex
>
  <HeroCarrossel />

  <CardsEcossistema />

  <section class="section fecho">
    <div class="container fecho-inner" data-reveal>
      <h2>{oQueFazemos.fecho.titulo}</h2>
      <p>{oQueFazemos.fecho.texto}</p>
      <Button href={withBase("/preview/contato")} variant="primary" size="lg" data-magnetic>
        {oQueFazemos.fecho.cta}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .fecho { position: relative; text-align: center; padding-block: var(--space-16) var(--space-24); background: var(--color-bg); }
  /* Fim do fluxo da página: o trilho dos cards desce e termina num ponto, a decisão. */
  .fecho-inner::before {
    content: "";
    display: block;
    width: 2px;
    height: 56px;
    margin: 0 auto var(--space-8);
    background: linear-gradient(180deg, transparent, var(--red-500));
    mask-image: linear-gradient(180deg, transparent, black 40%);
  }
  .fecho-inner { position: relative; }
  .fecho-inner::after {
    content: "";
    position: absolute;
    top: calc(56px - 5px);
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red-500);
    box-shadow: 0 0 0 0 rgba(226, 8, 29, 0.35);
    animation: fecho-pulso 2.8s ease-out infinite;
  }
  @keyframes fecho-pulso { to { box-shadow: 0 0 0 14px rgba(226, 8, 29, 0); } }
  .fecho-inner h2 { font-size: var(--fs-3xl); max-width: 26ch; margin-inline: auto; }
  .fecho-inner p { margin: var(--space-5) auto var(--space-8); max-width: 72ch; color: var(--color-text-muted); line-height: 1.6; }
  @media (prefers-reduced-motion: reduce) { .fecho-inner::after { animation: none; } }
</style>
