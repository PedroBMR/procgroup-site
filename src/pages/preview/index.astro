---
/**
 * Preview da home reestruturada, conforme o documento de 2026-10-05.
 *
 * TEMPORÁRIO, fora do site no ar. Monta os quatro heróis e o bloco O QUE
 * FAZEMOS com a copy do documento.
 *
 * Sobre o sorteio dos heróis: o documento pede quatro heróis alternando
 * aleatoriamente. Aqui ele sorteia de verdade a cada carregamento, e ainda
 * oferece os botões para trocar na mão, porque senão não dá para ver os
 * quatro. Isso também deixa visível o problema levantado no R6 da auditoria:
 * cada herói traz um H1 diferente para a mesma URL.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CabecalhoAjustes from "../../components/preview/CabecalhoAjustes.astro";
import { withBase } from "../../utils/url";
import { herois, oQueFazemos } from "../../data/preview/ajustes";
---

<BaseLayout
  title="Preview: home reestruturada"
  description="Preview interno da reestruturação do site."
  bare
  noIndex
>
  <CabecalhoAjustes atual="/preview" />

  <main>
    <section class="heroi-area">
      <div class="trocador" role="group" aria-label="Trocar herói">
        <span class="trocador-rotulo">Herói</span>
        {herois.map((h, i) => (
          <button type="button" data-ir={i} class:list={["trocador-botao", { ativo: i === 0 }]}>
            {h.rotulo}
          </button>
        ))}
        <span class="trocador-nota">o documento pede sorteio a cada visita</span>
      </div>

      {herois.map((h, i) => (
        <article class:list={["heroi", { ativo: i === 0 }]} data-heroi={i}>
          <div class="caixa">
            <p class="eyebrow">{h.rotulo}</p>
            <h1>{h.titulo}</h1>
            <p class="heroi-sub">{h.sub}</p>
            <p class="heroi-texto">{h.texto}</p>
            <div class="botoes">
              <a class="btn btn-p" href={withBase(h.cta.href)}>{h.cta.label}</a>
              <a class="btn btn-g" href={withBase(h.cta2.href)}>{h.cta2.label}</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="fazemos">
      <div class="caixa">
        <p class="eyebrow">{oQueFazemos.eyebrow}</p>
        <h2>{oQueFazemos.titulo}</h2>
        <p class="fazemos-lead">{oQueFazemos.texto}</p>

        <div class="cards">
          {oQueFazemos.cards.map((c, i) => (
            <article class="card">
              <span class="card-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{c.titulo}</h3>
              <p class="card-chamada">{c.chamada}</p>
              <p class="card-texto">{c.texto}</p>
              <a class="card-cta" href={withBase(c.cta.href)}>{c.cta.label}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fecho">
      <div class="caixa">
        <h2>{oQueFazemos.fecho.titulo}</h2>
        <p>{oQueFazemos.fecho.texto}</p>
        <a class="btn btn-p" href={withBase("/contato")}>{oQueFazemos.fecho.cta}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main { background: var(--navy-950); color: var(--white); }
  .caixa { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-6); }
  .eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }

  /* ── heróis ── */
  .heroi-area { position: relative; border-bottom: 1px solid var(--color-border); }
  .heroi { display: none; padding-block: var(--space-24) var(--space-16); }
  .heroi.ativo { display: block; }
  .heroi h1 { margin-top: var(--space-4); font-size: clamp(2rem, min(4vw, 6vh), 3.6rem); line-height: 1.05; max-width: 20ch; color: var(--white); }
  .heroi-sub { margin-top: var(--space-5); font-size: var(--fs-lg); color: rgba(255,255,255,0.8); max-width: 54ch; }
  .heroi-texto { margin-top: var(--space-4); font-size: var(--fs-base); color: rgba(255,255,255,0.62); max-width: 62ch; line-height: var(--lh-normal); }

  .botoes { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding-inline: var(--space-6); border-radius: var(--radius-pill); font-weight: 700; font-size: var(--fs-sm); text-decoration: none; }
  .btn-p { background: var(--color-primary); color: var(--white); }
  .btn-p:hover { background: var(--color-primary-dark); }
  .btn-g { border: 1px solid rgba(255,255,255,0.3); color: var(--white); }
  .btn-g:hover { background: rgba(255,255,255,0.07); }

  .trocador {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    max-width: var(--container-max); margin-inline: auto;
    padding: var(--space-5) var(--space-6) 0;
  }
  .trocador-rotulo { font-family: ui-monospace, Consolas, monospace; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-text-faint); margin-right: var(--space-2); }
  .trocador-botao {
    min-height: 44px; padding-inline: var(--space-4);
    border: 1px solid var(--color-border); border-radius: var(--radius-pill);
    background: transparent; color: rgba(255,255,255,0.6);
    font-size: var(--fs-xs); font-weight: 600; cursor: pointer;
  }
  .trocador-botao:hover { color: var(--white); border-color: rgba(255,255,255,0.35); }
  .trocador-botao.ativo { background: var(--white); color: var(--navy-950); border-color: var(--white); }
  .trocador-nota { font-size: var(--fs-xs); color: var(--color-text-faint); font-style: italic; margin-left: var(--space-2); }

  /* ── o que fazemos ── */
  .fazemos { padding-block: var(--space-24); background: var(--navy-900); }
  .fazemos h2 { margin-top: var(--space-4); font-size: var(--fs-3xl); color: var(--white); max-width: 24ch; }
  .fazemos-lead { margin-top: var(--space-5); max-width: 70ch; color: rgba(255,255,255,0.68); line-height: var(--lh-normal); }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-12); }
  .card { padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,255,255,0.03); display: flex; flex-direction: column; }
  .card-n { font-family: ui-monospace, Consolas, monospace; font-size: var(--fs-xs); color: var(--red-400); letter-spacing: 0.12em; }
  .card h3 { margin-top: var(--space-3); font-size: var(--fs-xl); color: var(--white); }
  .card-chamada { margin-top: var(--space-3); font-weight: 600; color: rgba(255,255,255,0.85); }
  .card-texto { margin-top: var(--space-3); font-size: var(--fs-sm); color: rgba(255,255,255,0.6); line-height: var(--lh-normal); flex: 1; }
  .card-cta { margin-top: var(--space-6); font-size: var(--fs-sm); font-weight: 700; color: var(--red-400); text-decoration: none; }
  .card-cta:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── fecho ── */
  .fecho { padding-block: var(--space-24); text-align: center; }
  .fecho h2 { font-size: var(--fs-2xl); color: var(--white); }
  .fecho p { margin: var(--space-5) auto 0; max-width: 68ch; color: rgba(255,255,255,0.68); line-height: var(--lh-normal); }
  .fecho .btn { margin-top: var(--space-8); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .heroi { padding-block: var(--space-16) var(--space-12); }
  }
</style>

<script>
  // Sorteia um herói na carga, como o documento pede, e deixa trocar na mão
  // para dar para conferir os quatro.
  const heroes = [...document.querySelectorAll<HTMLElement>("[data-heroi]")];
  const botoes = [...document.querySelectorAll<HTMLButtonElement>("[data-ir]")];

  const mostrar = (i: number) => {
    heroes.forEach((h, k) => h.classList.toggle("ativo", k === i));
    botoes.forEach((b, k) => b.classList.toggle("ativo", k === i));
  };

  if (heroes.length) mostrar(Math.floor(Math.random() * heroes.length));
  botoes.forEach((b) => b.addEventListener("click", () => mostrar(Number(b.dataset.ir))));
</script>
