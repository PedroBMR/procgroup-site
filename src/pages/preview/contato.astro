---
/**
 * A página de Contato do documento "Ajustes no site" (página 5), como ficaria
 * no ar.
 *
 * O documento pede: e-mail vendas@procgroup.com.br, WhatsApp comercial e um
 * formulário "Fale com vendas" com poucos campos (nome completo, e-mail,
 * WhatsApp, assunto) que envia para esse e-mail.
 *
 * O formulário NÃO envia nada nesta cópia: não existe destino aprovado, e o
 * vendas@ ainda é decisão em aberto (R5 de AUDITORIA-AJUSTES-SITE.md). Quem
 * clica em enviar recebe um aviso dizendo isso, para ninguém achar que a
 * mensagem chegou.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { navPreview } from "../../data/preview/ajustes";

const EMAIL = "vendas@procgroup.com.br";
const WHATSAPP_ROTULO = "+55 46 99141-1324";
const WHATSAPP_LINK = "https://wa.me/5546991411324";
---

<BaseLayout
  title="Contato"
  description="Fale com um especialista Proc e descubra a solução ideal para o seu contexto."
  nav={navPreview()}
  noIndex
>
  <section class="hero-page">
    <div class="container">
      <p class="eyebrow">Contato</p>
      <h1>Fale com um especialista Proc</h1>
      <p class="lead">Descubra a solução ideal para o seu contexto.</p>
    </div>
  </section>

  <section class="section banda" data-theme="light">
    <div class="container grade">
      <div class="canais" data-reveal>
        <h2>Fale com vendas</h2>
        <ul>
          <li>
            <span class="rotulo">E-mail</span>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </li>
          <li>
            <span class="rotulo">WhatsApp</span>
            <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer">{WHATSAPP_ROTULO}</a>
          </li>
        </ul>
      </div>

      <form class="form" data-form-demo novalidate data-reveal>
        <label>
          <span>Nome completo</span>
          <input type="text" name="nome" autocomplete="name" required />
        </label>
        <label>
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          <span>WhatsApp</span>
          <input type="tel" name="whatsapp" autocomplete="tel" required />
        </label>
        <label>
          <span>Assunto</span>
          <input type="text" name="assunto" required />
        </label>
        <button type="submit" class="enviar">Enviar mensagem</button>
        <p class="status" data-form-status role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-page { padding-block: var(--space-16) var(--space-8); }
  .hero-page h1 { font-size: var(--fs-4xl); margin-top: var(--space-4); }
  .lead { margin-top: var(--space-5); max-width: 62ch; font-size: var(--fs-lg); color: var(--color-text-muted); }

  .section { padding-block: var(--space-16) var(--space-24); }
  .banda { background: var(--color-bg); }
  .grade { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-16); align-items: start; }

  .canais h2 { font-size: var(--fs-2xl); }
  .canais ul { margin-top: var(--space-6); display: grid; gap: var(--space-5); }
  .rotulo { display: block; font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-eyebrow); }
  .canais a { display: inline-flex; align-items: center; min-height: 32px; font-size: var(--fs-lg); font-weight: 600; color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; }

  .form {
    display: grid; gap: var(--space-5);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .form label { display: grid; gap: var(--space-2); }
  .form label span { font-size: var(--fs-sm); font-weight: 600; color: var(--color-text); }
  .form input {
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-ui);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .form input:focus-visible { outline: 2px solid var(--color-eyebrow); outline-offset: 1px; }
  .enviar {
    justify-self: start;
    min-height: 48px;
    padding-inline: var(--space-8);
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--white);
    font-weight: 700;
  }
  .enviar:hover { background: var(--color-primary-dark); }
  .status {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    color: var(--color-text);
  }

  @media (max-width: 860px) { .grade { grid-template-columns: 1fr; gap: var(--space-12); } }
</style>

<script>
  // Cópia de avaliação: o formulário não tem para onde enviar. Avisa quem
  // clicar, em vez de fingir que a mensagem foi.
  const form = document.querySelector<HTMLFormElement>("[data-form-demo]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!status) return;
    status.hidden = false;
    status.textContent =
      "Este formulário é de demonstração e ainda não envia mensagens. Para falar com vendas agora, use o e-mail ou o WhatsApp ao lado.";
  });
</script>
