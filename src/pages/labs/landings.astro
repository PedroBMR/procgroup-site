---
/**
 * COMPARADOR DE DIREÇÕES VISUAIS — página temporária, não é parte do site.
 *
 * Cinco landings inteiras, em tela cheia, para o Pedro escolher uma direção.
 * Role (ou use as setas / os números no canto) para pular de uma para outra.
 *
 * A COPY É A MESMA NAS CINCO, de propósito: o que está em jogo aqui é o
 * tratamento visual — composição, tipografia, movimento e temperatura —, não
 * o texto. Trocar as palavras junto embaralharia a comparação.
 *
 * Todas usam o mesmo sistema: navy da marca, Barlow Condensed no display,
 * mono nos rótulos, vermelho PONTUAL (só no evento).
 *
 * Quando a escolha estiver feita, esta página e src/scripts/labCenas.ts saem,
 * e a vencedora vira o herói da home.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProcMark from "../../components/ProcMark.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("pt").home;

const opcoes = [
  {
    id: "controle",
    n: "01",
    nome: "Sala de controle",
    conceito: "O painel de monitores. Uma varredura passa pelos quadros e um deles trava a detecção.",
    aposta: "Reconhecimento imediato — o cliente se vê na cena.",
  },
  {
    id: "corte",
    n: "02",
    nome: "Corte de luz",
    conceito: "Quase preto, um facho horizontal que respira, poeira na luz.",
    aposta: "Menos elementos, mais drama. A tipografia é a estrela.",
  },
  {
    id: "varredura",
    n: "03",
    nome: "Varredura",
    conceito: "Uma planta isométrica que só existe onde a linha já passou.",
    aposta: "A imagem se constrói na frente de quem olha.",
  },
  {
    id: "mesa",
    n: "04",
    nome: "Mesa de operação",
    conceito: "Planta baixa vista de cima, cones de visão varrendo o pátio.",
    aposta: "Tático. A mesa de quem coordena, não a tela de quem assiste.",
  },
  {
    id: "lente",
    n: "05",
    nome: "Lente",
    conceito: "Macro do instrumento: íris, anel de foco, marcas.",
    aposta: "Abstrata e de produto. Mostra a câmera, não o que ela vê.",
  },
];
---

<BaseLayout title="Cinco direções — comparador" description="Página interna de comparação visual." bare>
  <nav class="seletor" aria-label="Escolher direção">
    {opcoes.map((o) => (
      <a href={`#${o.id}`} class="seletor-item">
        <span class="seletor-n">{o.n}</span>
        <span class="seletor-nome">{o.nome}</span>
      </a>
    ))}
  </nav>

  <div class="trilho">
    {opcoes.map((o) => (
      <section class="tela" id={o.id} data-dir={o.id}>
        <span class="cena" data-lab={o.id} aria-hidden="true"><canvas></canvas></span>
        <span class={`veu veu--${o.id}`} aria-hidden="true"></span>

        <div class="conteudo">
          <div class="marca"><ProcMark size={26} /><span>PROC<b> GROUP</b></span></div>

          <div class="texto">
            <p class="eyebrow">{t.heroEyebrow}</p>
            <h1>{t.heroTitle}</h1>
            <p class="sub">{t.heroSubtitle}</p>
            <div class="ctas">
              <span class="btn btn--p">{t.heroCtaPrimary}</span>
              <span class="btn btn--g">{t.heroCtaSecondary}</span>
            </div>
          </div>

          <p class="assinatura">procgroup.com.br</p>

          <aside class="ficha">
            <span class="ficha-n">{o.n}</span>
            <strong>{o.nome}</strong>
            <p>{o.conceito}</p>
            <p class="ficha-aposta">{o.aposta}</p>
          </aside>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  /* ── trilho: uma tela por direção, com encaixe ── */
  .trilho { scroll-snap-type: y mandatory; height: 100vh; overflow-y: auto; }
  .tela {
    position: relative;
    height: 100vh;
    scroll-snap-align: start;
    overflow: hidden;
    background: var(--navy-950);
    color: var(--white);
    isolation: isolate;
  }
  .cena, .cena canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .veu { position: absolute; inset: 0; pointer-events: none; }

  .conteudo {
    position: relative;
    z-index: 2;
    height: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-12);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-6);
  }
  .marca { display: flex; align-items: center; gap: var(--space-3); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); letter-spacing: 0.06em; }
  .marca b { color: var(--color-text-faint); font-weight: 800; }

  /* Assinatura: espelha a ficha no canto oposto. Quem cai numa tela solta
     precisa saber de quem e — a marca no topo sozinha deixava dúvida. */
  .assinatura {
    position: absolute;
    left: var(--space-12);
    bottom: var(--space-8);
    z-index: 3;
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.45);
  }

  .texto { align-self: center; max-width: 60ch; min-height: 0; max-height: 100%; overflow: auto; scrollbar-width: none; }
  .eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }
  .tela h1 { color: var(--white); margin-top: var(--space-4); text-wrap: balance; }
  .sub { margin-top: var(--space-5); font-size: var(--fs-lg); color: rgba(255,255,255,0.75); max-width: 46ch; text-wrap: pretty; }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding-inline: var(--space-6); border-radius: var(--radius-pill); font-weight: 700; font-size: var(--fs-sm); }
  .btn--p { background: var(--color-primary); color: var(--white); }
  .btn--g { border: 1px solid rgba(255,255,255,0.3); color: var(--white); }

  /* Ficha da direção: some da impressão mental depois de um tempo, mas é o
     que deixa o Pedro comparar apostas e não só imagens. */
  /* Fora do fluxo: como linha da grade ela empurrava o conteudo e acabava
     cortada pelo overflow do quadro em 3 das 5 telas. */
  .ficha {
    position: absolute;
    right: var(--space-12);
    bottom: var(--space-8);
    z-index: 3;
    max-width: 32ch;
    padding: var(--space-5);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: var(--radius-md);
    background: rgba(6,10,20,0.6);
    backdrop-filter: blur(6px);
    font-size: var(--fs-xs);
    color: rgba(255,255,255,0.7);
  }
  .ficha-n { font-family: ui-monospace, Consolas, monospace; color: var(--red-400); letter-spacing: 0.1em; }
  .ficha strong { display: block; margin-top: var(--space-1); font-size: var(--fs-base); color: var(--white); }
  .ficha p { margin-top: var(--space-2); }
  .ficha-aposta { color: var(--color-text-faint); font-style: italic; }

  /* ══ tratamento por direção: cada uma tem a sua tipografia e o seu véu ══ */

  /* 01 · sala de controle — HUD: texto à esquerda, mono, régua fina. */
  [data-dir="controle"] .veu { background: linear-gradient(95deg, rgba(6,10,20,0.9) 0%, rgba(6,10,20,0.55) 46%, rgba(6,10,20,0.2) 100%); }
  [data-dir="controle"] .texto { max-width: 44ch; }
  [data-dir="controle"] h1 { font-size: clamp(1.8rem, min(3.4vw, 5vh), 3.4rem); line-height: 1.04; }
  [data-dir="controle"] .eyebrow { font-family: ui-monospace, Consolas, monospace; letter-spacing: 0.3em; }
  [data-dir="controle"] .sub { border-left: 2px solid var(--red-400); padding-left: var(--space-4); }

  /* 02 · corte de luz — título gigante, centrado, tudo o mais some. */
  [data-dir="corte"] .veu { background: radial-gradient(70% 55% at 50% 52%, transparent 20%, rgba(2,4,10,0.86) 78%); }
  [data-dir="corte"] .texto { max-width: 30ch; margin-inline: auto; text-align: center; }
  [data-dir="corte"] h1 { font-size: clamp(1.7rem, min(3.2vw, 4.4vh), 3.4rem); line-height: 0.98; letter-spacing: -0.01em; }
  [data-dir="corte"] .eyebrow { letter-spacing: 0.5em; text-indent: 0.5em; color: rgba(255,255,255,0.5); }
  [data-dir="corte"] .sub { margin-inline: auto; max-width: 40ch; }
  [data-dir="corte"] .ctas { justify-content: center; margin-top: var(--space-6); }

  /* 03 · varredura — técnico: numeração, filetes, alinhamento à esquerda. */
  [data-dir="varredura"] .veu { background: linear-gradient(180deg, rgba(6,10,20,0.82) 0%, rgba(6,10,20,0.25) 46%, rgba(6,10,20,0.9) 100%); }
  [data-dir="varredura"] .texto { max-width: 50ch; }
  [data-dir="varredura"] h1 { font-size: clamp(1.9rem, min(4vw, 5.4vh), 4rem); line-height: 1; }
  [data-dir="varredura"] .eyebrow::before { content: "— "; }
  [data-dir="varredura"] .sub { padding-top: var(--space-5); border-top: 1px solid rgba(255,255,255,0.16); }

  /* 04 · mesa de operação — o texto vira um bloco de briefing no canto. */
  [data-dir="mesa"] .veu { background: radial-gradient(120% 90% at 20% 50%, rgba(6,10,20,0.92) 30%, rgba(6,10,20,0.35) 100%); }
  [data-dir="mesa"] .texto {
    max-width: 46ch;
    padding: var(--space-8);
    border-left: 3px solid var(--red-400);
    background: rgba(6,10,20,0.5);
    backdrop-filter: blur(4px);
  }
  [data-dir="mesa"] h1 { font-size: clamp(1.7rem, min(3vw, 4.2vh), 3rem); line-height: 1.06; }

  /* 05 · lente — HUD centrado, com marcas de canto emoldurando o texto. */
  [data-dir="lente"] .veu { background: radial-gradient(60% 60% at 50% 50%, rgba(2,4,10,0.72) 40%, rgba(2,4,10,0.94) 100%); }
  [data-dir="lente"] .texto { max-width: 40ch; margin-inline: auto; text-align: center; position: relative; padding: var(--space-6); }
  [data-dir="lente"] .texto::before,
  [data-dir="lente"] .texto::after {
    content: "";
    position: absolute;
    width: 26px; height: 26px;
    border: 1px solid var(--red-400);
  }
  [data-dir="lente"] .texto::before { top: 0; left: 0; border-right: 0; border-bottom: 0; }
  [data-dir="lente"] .texto::after { bottom: 0; right: 0; border-left: 0; border-top: 0; }
  [data-dir="lente"] h1 { font-size: clamp(1.55rem, min(2.6vw, 3.8vh), 2.7rem); line-height: 1.04; }
  [data-dir="lente"] .eyebrow { font-family: ui-monospace, Consolas, monospace; letter-spacing: 0.28em; }
  [data-dir="lente"] .ctas { justify-content: center; }

  /* ── seletor fixo ── */
  .seletor {
    position: fixed;
    right: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .seletor-item {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    color: rgba(255,255,255,0.45);
    background: rgba(6,10,20,0.5);
    text-decoration: none;
  }
  .seletor-item:hover { color: var(--white); background: rgba(6,10,20,0.85); }
  .seletor-nome { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width var(--dur-med) ease; }
  .seletor-item:hover .seletor-nome { max-width: 16ch; }

  /* Tela baixa (notebook de 768): o que estourava nao era so a fonte, era o
     respiro somado entre titulo, subtitulo e botoes. */
  @media (max-height: 820px) {
    .tela h1 { margin-top: var(--space-3); }
    .sub { margin-top: var(--space-4); font-size: var(--fs-base); }
    .ctas { margin-top: var(--space-5); }
    .ficha { display: none; }
  }

  @media (max-width: 900px) {
    .conteudo { padding: var(--space-6); grid-template-rows: auto 1fr; }
    .ficha { display: none; }
    .seletor { right: var(--space-2); gap: 0; }
    .assinatura { left: var(--space-6); bottom: var(--space-5); }
    .seletor-nome { display: none; }
    [data-dir="mesa"] .texto { padding: var(--space-5); }
  }
</style>

<script>
  import { montarLab } from "../../scripts/labCenas";
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", montarLab);
  else montarLab();

  // Setas e números pulam de direção — comparar exige ir e voltar rápido.
  const telas = [...document.querySelectorAll<HTMLElement>(".tela")];
  const trilho = document.querySelector<HTMLElement>(".trilho");
  document.addEventListener("keydown", (e) => {
    if (!trilho) return;
    const atual = Math.round(trilho.scrollTop / window.innerHeight);
    let alvo = -1;
    if (e.key === "ArrowDown" || e.key === "ArrowRight") alvo = atual + 1;
    else if (e.key === "ArrowUp" || e.key === "ArrowLeft") alvo = atual - 1;
    else if (/^[1-5]$/.test(e.key)) alvo = Number(e.key) - 1;
    if (alvo < 0 || alvo >= telas.length) return;
    e.preventDefault();
    trilho.scrollTo({ top: alvo * window.innerHeight, behavior: "smooth" });
  });
</script>
