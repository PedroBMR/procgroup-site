// Rota da página de visão computacional, dentro de Ambientes Inteligentes.
// Só gera caminho com a chave ligada em src/data/secoes.ts: enquanto o texto é
// rascunho, a URL simplesmente não existe e nada entra no sitemap.
import SolucaoVisaoComputacional from "../../../../components/paginas/SolucaoVisaoComputacional.astro";
import { secoes } from "../../../../data/secoes";

export function getStaticPaths() {
  if (!secoes.visaoComputacional) return [];
  // PT saiu em 2026-10-20: a versao em portugues e a pagina nova da raiz
  // (src/pages/), e o endereco antigo redireciona (astro.config.mjs).
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}
