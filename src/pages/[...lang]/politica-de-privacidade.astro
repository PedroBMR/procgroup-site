---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import { formatDate } from "../../utils/blog";
import { usePages } from "../../i18n/pages";
import { politicaTraduzida } from "../../data/politicaPrivacidade";
import { defaultLocale, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }, { params: { lang: "es" } }];
}
const lang = (Astro.params.lang as Locale) || defaultLocale;
const t = usePages(lang).privacy;

const page = await getEntry("pages", "politica-de-privacidade");
const { Content } = page ? await render(page) : { Content: undefined };

// PT lê o documento do WordPress, que é a versão canônica. EN e ES leem a
// tradução local (data/politicaPrivacidade.ts), autorizada em 2026-09-25.
// A nota no topo diz qual versão prevalece; o canonical continua apontando
// para a portuguesa.
const traducao = politicaTraduzida[lang];
---

<BaseLayout title={t.title} description={t.metaDescription}>
  {page && Content ? (
    <article class="policy">
      <header class="policy-head container">
        <p class="eyebrow">{t.eyebrow}</p>
        {/* t.title, não page.data.title: o título do WordPress vem sempre em
            português, então o h1 contradizia o <title> e o lang da página. */}
        <h1>{t.title}</h1>
        <p class="updated">{t.updatedPrefix} {formatDate(page.data.modified, lang)}</p>
        {t.langNote && <p class="lang-note">{t.langNote}</p>}
      </header>
      <section class="section" data-theme="light">
        <div class="container">
          {/* Em PT sai o HTML do WordPress. Em EN e ES sai a tradução local,
              montada a partir de blocos — o markup do Elementor não precisa
              atravessar a tradução, só o conteúdo. Sem a tradução (idioma novo
              ainda não traduzido) cai no português com lang="pt-BR" marcado,
              senão o leitor de tela lê português com fonética inglesa
              (WCAG 3.1.2). */}
          {traducao ? (
            <div class="prose">
              {traducao.map((bloco) =>
                bloco.tipo === "h4" ? (
                  <h4><strong>{bloco.texto}</strong></h4>
                ) : bloco.tipo === "ul" ? (
                  <ul>{bloco.itens?.map((item) => <li><p>{item}</p></li>)}</ul>
                ) : (
                  <p set:html={bloco.texto?.split("\n").join("<br>")} />
                ),
              )}
            </div>
          ) : (
            <div class="prose" lang={lang === defaultLocale ? undefined : "pt-BR"}>
              <Content />
            </div>
          )}
        </div>
      </section>
    </article>
  ) : (
    <ComingSoon eyebrow={t.eyebrow} title={t.title} description={t.comingSoonDesc} />
  )}
</BaseLayout>

<style>
  .policy-head { padding-block: var(--space-16) var(--space-8); max-width: 820px; }
  .policy-head h1 { font-size: var(--fs-4xl); margin-top: var(--space-4); line-height: var(--lh-snug); }
  .updated { margin-top: var(--space-4); font-size: var(--fs-sm); color: var(--color-text-faint); }
  .lang-note {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }
  .section { padding-block: var(--space-8) var(--space-24); background: var(--color-bg); }
</style>
