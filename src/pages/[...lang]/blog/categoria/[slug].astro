---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard from "../../../../components/PostCard.astro";
import BlogCategoryChips from "../../../../components/BlogCategoryChips.astro";
import {
  collectCategories,
  postsInCategory,
  categoryColor,
  CATCH_ALL_CATEGORY,
  EVENTS_CATEGORY,
  type BlogPost,
  type BlogCategory,
} from "../../../../utils/blog";
import { locales, defaultLocale, type Locale } from "../../../../i18n/config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // Catch-all lives at /blog; Eventos has its own /eventos page.
  const categories = collectCategories(posts).filter(
    (c) => c.slug !== CATCH_ALL_CATEGORY && c.slug !== EVENTS_CATEGORY,
  );
  // Uma cópia por idioma de casca, como o resto do blog.
  return locales.flatMap((lang) =>
    categories.map((category) => ({
      params: {
        lang: lang === defaultLocale ? undefined : lang,
        slug: category.slug,
      },
      props: { category, posts: postsInCategory(posts, category.slug) },
    })),
  );
}

interface Props {
  category: BlogCategory;
  posts: BlogPost[];
}

const { category, posts } = Astro.props;
const lang = (Astro.params.lang as Locale) || defaultLocale;

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${category.name} | Blog Proc Group`,
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: new URL(`/blog/${post.data.slug}`, "https://procgroup.com.br").toString(),
  })),
};
---

<BaseLayout
  title={`${category.name}, Blog`}
  description={`Conteúdo da Proc Group sobre ${category.name}.`}
  schema={schema}
>
  <section class="hero-page">
    <div class="container">
      <p class="eyebrow">Categoria</p>
      <h1>{category.name}</h1>
      <p class="lead">{posts.length} {posts.length === 1 ? "publicação" : "publicações"} nesta categoria.</p>
      <BlogCategoryChips active={category.slug} />
    </div>
  </section>

  <section class="section posts-section" data-theme="light">
    <div class="container">
      {/* Títulos e resumos são portugueses; em /en e /es o bloco diz isso. */}
      <div class="posts-grid" lang={lang === defaultLocale ? undefined : "pt-BR"}>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-page { padding-block: var(--space-16) var(--space-8); }
  .hero-page h1 { font-size: var(--fs-4xl); margin-top: var(--space-4); max-width: 780px; }
  .lead { margin-top: var(--space-6); font-size: var(--fs-lg); color: var(--color-text-muted); }
  .section { padding-block: var(--space-16) var(--space-24); }
  .posts-section { background: var(--color-bg); }
  .posts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  @media (max-width: 980px) { .posts-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (max-width: 640px) { .posts-grid { grid-template-columns: 1fr; } }
</style>
