---
// A raiz do site: a home corporativa.
//
// Foi o seletor de publico entre 2026-08-26 e 2026-08-27, quando cidade e
// governo sairam para um site proprio (decisao do CEO). Sem dois lados para
// escolher, nao ha o que selecionar: a home assume a raiz.
//
// A abertura (Abertura.astro), o corte de varredura de 700ms que substituiu a
// nuvem de pontos reprovada em 2026-09-17, mora dentro do Home.astro desde
// 2026-09-28. Antes ela era chamada aqui, ao lado do <Home />, e por isso saia
// antes do <html>, o que esvaziava o <head> das tres homes. Nada de markup
// solto aqui: tudo o que a pagina desenha tem que passar pelo BaseLayout.
import Home from "../../components/paginas/Home.astro";
import { defaultLocale, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = (Astro.params.lang as Locale) || defaultLocale;
---

<Home />
