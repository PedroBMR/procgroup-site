---
/**
 * A raiz do site e o seletor de publico (fase 4 de ARQUITETURA-DOIS-PUBLICOS.md;
 * nasceu como /comecar e assumiu a raiz quando o site foi dividido).
 *
 * Uma decisao so: o visitante diz se e governo ou empresa e segue para o lado
 * certo — /governo ou /empresas, dois recortes completos do mesmo site, sem
 * area comum de conteudo. Por isso roda com `bare` no BaseLayout — sem TopBar,
 * Header nem Footer: numa pagina de escolha, o menu e o que compete com a
 * escolha. O <head> continua vindo do BaseLayout (canonical, hreflang, OG,
 * noindex de preview).
 *
 * Abaixo do painel ha um bloco institucional curto: a raiz e a pagina que o
 * Google mais ve, e sem ele o dominio nao teria nada indexavel (decisao 6 da
 * arquitetura). O texto e o mesmo hero institucional da home — nada novo.
 *
 * MEDICAO: cada porta carrega data-escolha="governo|empresa". O site ainda nao
 * tem analytics; quando tiver, o gancho esta no <script> do fim do arquivo.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProcMark from "../../components/ProcMark.astro";
import CenaPorta from "../../components/CenaPorta.astro";
import { usePages } from "../../i18n/pages";
import { useTranslations } from "../../i18n/utils";
import { localizePath, localeAlternates } from "../../i18n/utils";
import { defaultLocale, localeLabels, localeNames, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = (Astro.params.lang as Locale) || defaultLocale;
const c = usePages(lang).comecar;
const th = useTranslations(lang).home;
const alternates = localeAlternates(Astro.url);

const portas = [
  {
    chave: "governo",
    href: localizePath("/governo", lang),
    ...c.gov,
  },
  {
    chave: "empresa",
    href: localizePath("/empresas", lang),
    ...c.emp,
  },
];
---

<BaseLayout title={th.metaTitle} description={th.metaDescription} bare>
  <div class="painel" data-entrada>
    <div class="grade" aria-hidden="true"></div>
    <div class="halo" aria-hidden="true"></div>
    <CenaPorta cena="fundo" />
    <div class="varredura" aria-hidden="true"></div>

    <header class="barra barra--topo">
      <div class="marca">
        <ProcMark size={26} />
        <span class="marca-nome">PROC<span class="marca-sufixo"> GROUP</span></span>
      </div>
      <p class="status">{c.status}</p>
      <nav class="idiomas" aria-label={c.ariaIdioma}>
        {
          alternates.map((a) => (
            <a
              href={a.href}
              class:list={["idioma", { "is-ativo": a.lang === lang }]}
              hreflang={a.lang}
              lang={a.lang}
              title={localeNames[a.lang]}
              aria-current={a.lang === lang ? "true" : undefined}
            >
              {localeLabels[a.lang]}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="miolo">
      <div class="cabecalho">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h1>{c.titleA}<br />{c.titleB}</h1>
        </div>
        <p class="lead">{c.lead}</p>
      </div>

      <div class="canais">
        {
          portas.map((p, i) => (
            <a class="canal" href={p.href} data-escolha={p.chave} style={`--i: ${i}`}>
              <CenaPorta cena={p.chave === "governo" ? "governo" : "empresas"} />
              <span class="canal-progresso" aria-hidden="true"><span class="canal-barra" /></span>
              <span class="canal-corpo">
                <span class="canal-topo">
                  <span class="canal-rotulo">{p.canal}</span>
                  <svg class="canal-icone" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    {i === 0 ? (
                      <path d="M3 20h18M5 20V10l7-5 7 5v10M9.5 20v-5h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    ) : (
                      <path d="M3 21h18M5 21V6l7-3v18M19 21V11l-7-3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                  </svg>
                </span>
                <span class="canal-titulo">{p.title}</span>
                <span class="canal-lead">{p.lead}</span>
                <span class="canal-itens">
                  {p.items.map((it) => <span class="canal-item">{it}</span>)}
                </span>
                <span class="canal-cta">
                  {c.cta}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h13M12.5 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <footer class="barra barra--rodape">
      <a class="email" href="mailto:comercial@procgroup.com.br">comercial@procgroup.com.br</a>
    </footer>
  </div>

  <section class="instituc">
    <div class="instituc-inner">
      <p class="instituc-eyebrow">{c.status}</p>
      <h2>PROC GROUP</h2>
      <p class="instituc-texto">{th.metaDescription}</p>
      <p class="instituc-texto">{th.aboutText}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .instituc { background: var(--color-bg); border-top: 1px solid var(--color-border); padding: var(--space-16) var(--space-12); }
  .instituc-inner { max-width: 720px; margin-inline: auto; }
  .instituc-eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }
  .instituc h2 { margin-top: var(--space-3); font-size: var(--fs-2xl); color: var(--color-text); }
  .instituc-texto { margin-top: var(--space-4); font-size: var(--fs-sm); line-height: var(--lh-normal); color: var(--color-text-muted); }

  /* ── Entrada: o painel liga como um centro de operações ──────────────────
     Grade e halo primeiro, título depois, portas por último e em sequência.
     Tudo com `both`: o estado inicial vale antes do delay, senão o conteúdo
     pisca visível e some. Quem pediu menos movimento recebe tudo já no lugar
     (bloco no fim do arquivo). */
  @keyframes surgir { from { opacity: 0 } to { opacity: 1 } }
  @keyframes subir {
    from { opacity: 0; transform: translateY(26px) }
    to   { opacity: 1; transform: none }
  }
  @keyframes abrirHalo {
    from { opacity: 0; transform: scale(.72) }
    to   { opacity: 1; transform: none }
  }
  @keyframes passarLuz {
    0%   { opacity: 0; transform: translateX(-60%) }
    18%  { opacity: .5 }
    100% { opacity: 0; transform: translateX(160%) }
  }

  [data-entrada] .grade,
  [data-entrada] .cena--fundo { animation: surgir 1.4s ease-out both; }
  [data-entrada] .halo { animation: abrirHalo 1.6s cubic-bezier(.16,1,.3,1) .15s both; }
  [data-entrada] .barra--topo { animation: surgir .8s ease-out .35s both; }
  [data-entrada] .cabecalho > div { animation: subir .9s cubic-bezier(.16,1,.3,1) .45s both; }
  [data-entrada] .cabecalho .lead { animation: subir .9s cubic-bezier(.16,1,.3,1) .6s both; }
  [data-entrada] .canal { animation: subir 1s cubic-bezier(.16,1,.3,1) calc(.78s + var(--i) * .14s) both; }
  [data-entrada] .barra--rodape { animation: surgir .8s ease-out 1.3s both; }

  /* Uma passada de luz, uma vez só: o monitor acordando. Repetir viraria
     enfeite — o manual limita o glow a uso pontual. */
  .varredura {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 40%;
    pointer-events: none;
    background: linear-gradient(100deg, transparent, rgba(255, 74, 84, .07) 45%, rgba(226, 231, 245, .05) 55%, transparent);
    animation: passarLuz 2.4s ease-out .2s both;
  }

  /* A página ocupa a janela inteira: é um pedágio, não tem rolagem em desktop.
     min-height em vez de height para não cortar conteúdo quando a fonte do
     sistema é maior ou a janela é baixa. */
  .painel {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Grade técnica estática: fallback de quem não tem o canvas. Com a cena de
     fundo montada ela sai, senão duas grades diferentes se sobrepõem. */
  [data-cena-ativa] .grade { display: none; }

  .grade {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }
  /* Um único foco de luz — o manual limita a dois por composição. */
  .halo {
    position: absolute;
    top: -18%;
    right: 12%;
    width: min(560px, 60vw);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: radial-gradient(circle, rgba(226, 8, 29, 0.2) 0%, rgba(226, 8, 29, 0.04) 48%, transparent 70%);
    pointer-events: none;
  }

  .barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-12);
  }
  .barra--topo { border-bottom: 1px solid var(--color-border); }
  .barra--rodape { border-top: 1px solid var(--color-border); }

  .marca { display: flex; align-items: center; gap: var(--space-3); }
  .marca-nome {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .marca-sufixo { color: var(--color-text-faint); }

  .status,
  .saida,
  .email {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .saida:hover, .email:hover { color: var(--color-text); }
  .email { display: inline-flex; align-items: center; min-height: 40px; }
  .saida { text-decoration: underline; text-underline-offset: 3px; }

  .idiomas { display: flex; gap: var(--space-1); }
  .idioma {
    /* Alvo de toque: 29px de altura reprovava no celular. O padding sobe a
       area clicavel sem mudar o visual do texto. */
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-text-faint);
    transition: color var(--dur-fast) ease;
  }
  .idioma:hover { color: var(--color-text); }
  .idioma.is-ativo { background: rgba(255, 255, 255, 0.08); color: var(--color-text); }

  .miolo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-12);
    max-width: var(--container-max);
    width: 100%;
    margin-inline: auto;
  }

  .cabecalho {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .cabecalho h1 { font-size: var(--fs-3xl); }
  .lead {
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    max-width: 34ch;
    text-align: right;
    text-wrap: pretty;
  }

  .canais {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .canal {
    display: block;
    position: relative;
    isolation: isolate;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }
  .canal:hover,
  .canal:focus-visible {
    background: var(--color-surface-hover);
    border-color: rgba(226, 8, 29, 0.55);
  }
  .canal:hover .canal-barra,
  .canal:focus-visible .canal-barra { width: 100%; }

  .canal-progresso { display: block; height: 3px; background: rgba(255, 255, 255, 0.06); }
  .canal-barra {
    display: block;
    height: 3px;
    width: 34%;
    background: var(--color-primary);
    transition: width var(--dur-med) cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .canal-corpo { display: block; padding: var(--space-8); }

  .canal-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }
  .canal-rotulo {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .canal-icone { color: var(--color-text-muted); }

  .canal-titulo {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-2xl);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: var(--lh-tight);
  }
  .canal-lead {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* O corpo sobe acima da cena. */
  .canal-corpo, .canal-progresso { position: relative; z-index: 1; }

  .canal-itens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .canal-item {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .canal-item::before { content: "› "; color: var(--color-text-faint); }

  .canal-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    /* 48px de alvo de toque, não 44: a régua do projeto é múltiplo de 4. */
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--white);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .canal:hover .canal-cta,
  .canal:focus-visible .canal-cta { background: var(--color-primary-dark); }

  /* Cortes estruturais do manual: 1200 / 900 / 640. */
  @media (max-width: 1200px) {
    .barra, .miolo { padding-inline: var(--space-8); }
  }
  @media (max-width: 900px) {
    /* Empilhado, a página passa a rolar — e aí a rolagem é esperada, não um bug. */
    .painel { min-height: 0; }
    .cabecalho { flex-direction: column; align-items: flex-start; gap: var(--space-5); }
    .lead { text-align: left; max-width: none; }
    .canais { grid-template-columns: minmax(0, 1fr); }
    .miolo { gap: var(--space-8); padding-block: var(--space-8); }
    .status { display: none; }
  }
  @media (max-width: 640px) {
    .barra, .miolo { padding-inline: var(--space-5); }
    .cabecalho h1 { font-size: var(--fs-2xl); }
    .canal-titulo { font-size: var(--fs-xl); }
    .canal-corpo { padding: var(--space-5); }
    /* No celular a lista de solucoes dobrava a altura do cartao e empurrava a
       segunda porta para fora da dobra — o visitante nem descobria que havia
       duas. Rotulo, titulo, lead e CTA bastam para escolher; a lista completa
       esta na home do lado, um toque adiante. */
    .canal-itens { display: none; }
    .canal-cta { width: 100%; justify-content: center; margin-top: var(--space-4); }
    .miolo { gap: var(--space-6); padding-block: var(--space-6); }
    .barra--rodape { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .canal, .canal-barra, .idioma { transition: none; }
    /* Sem sequência de entrada: tudo já no lugar, e a luz não passa. */
    [data-entrada] .grade, [data-entrada] .cena--fundo,
    [data-entrada] .halo, [data-entrada] .barra--topo,
    [data-entrada] .cabecalho > div, [data-entrada] .cabecalho .lead,
    [data-entrada] .canal, [data-entrada] .barra--rodape { animation: none; }
    .varredura { display: none; }
  }
</style>

<script>
  // Gancho de medição. O site ainda não tem analytics — quando tiver, é aqui que
  // o evento entra, e o resto da página não muda. Exemplos:
  //   Plausible: plausible('Escolha de publico', { props: { publico: escolha } })
  //   Umami:     umami.track('escolha-publico', { publico: escolha })
  // Também grava a escolha, que é o que permite personalizar a visita seguinte.
  document.querySelectorAll<HTMLAnchorElement>("[data-escolha]").forEach((el) => {
    el.addEventListener("click", () => {
      const escolha = el.dataset.escolha;
      if (!escolha) return;
      try {
        localStorage.setItem("proc:publico", escolha);
      } catch {
        // Modo privativo ou storage cheio: a navegação não pode quebrar por isso.
      }
    });
  });
</script>
