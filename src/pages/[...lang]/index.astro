---
/**
 * A raiz do site e o seletor de publico (fase 4 de ARQUITETURA-DOIS-PUBLICOS.md;
 * nasceu como /comecar e assumiu a raiz quando o site foi dividido).
 *
 * Uma decisao so: o visitante diz se e governo ou empresa e segue para o lado
 * certo — /governo ou /empresas, dois recortes completos do mesmo site, sem
 * area comum de conteudo. Por isso roda com `bare` no BaseLayout — sem TopBar,
 * Header nem Footer: numa pagina de escolha, o menu e o que compete com a
 * escolha. O <head> continua vindo do BaseLayout (canonical, hreflang, OG,
 * noindex de preview).
 *
 * FORMATO (2026-08-26): tela dividida ao meio, padrao consagrado em paginas de
 * escolha dupla premiadas — cada metade E a cena (canvas full-bleed), com o
 * nome do publico em tipografia gigante contornada que preenche no hover. A
 * metade sob o cursor expande (flex-grow) e a outra escurece; a costura entre
 * as duas carrega um pulso de luz. Nada de "cards": a escolha ocupa a tela.
 *
 * Abaixo do painel ha um bloco institucional curto: a raiz e a pagina que o
 * Google mais ve, e sem ele o dominio nao teria nada indexavel (decisao 6 da
 * arquitetura). O texto e o mesmo hero institucional da home — nada novo.
 *
 * MEDICAO: cada porta carrega data-escolha="governo|empresa". O site ainda nao
 * tem analytics; quando tiver, o gancho esta no <script> do fim do arquivo.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProcMark from "../../components/ProcMark.astro";
import CenaPorta from "../../components/CenaPorta.astro";
import IntroBoot from "../../components/IntroBoot.astro";
import { usePages } from "../../i18n/pages";
import { useTranslations } from "../../i18n/utils";
import { localizePath, localeAlternates } from "../../i18n/utils";
import { defaultLocale, localeLabels, localeNames, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = (Astro.params.lang as Locale) || defaultLocale;
const c = usePages(lang).comecar;
const th = useTranslations(lang).home;
const alternates = localeAlternates(Astro.url);

/** Primeira palavra vira o letreiro gigante; o resto fica como complemento.
 *  Funciona nos tres idiomas: Governo/e cidades, Government/and cities,
 *  Gobierno/y ciudades — idem para empresas. */
function partirTitulo(title: string) {
  const [nome, ...resto] = title.split(" ");
  return { nome, resto: resto.join(" ") };
}

const portas = [
  { chave: "governo", href: localizePath("/governo", lang), ...c.gov, ...partirTitulo(c.gov.title) },
  { chave: "empresa", href: localizePath("/empresas", lang), ...c.emp, ...partirTitulo(c.emp.title) },
];
---

<BaseLayout title={th.metaTitle} description={th.metaDescription} bare>
  <IntroBoot lang={lang} />

  <div class="painel" data-entrada>
    <header class="barra barra--topo">
      <div class="marca">
        <ProcMark size={26} />
        <span class="marca-nome">PROC<span class="marca-sufixo"> GROUP</span></span>
      </div>
      <p class="status">{c.status}</p>
      <nav class="idiomas" aria-label={c.ariaIdioma}>
        {
          alternates.map((a) => (
            <a
              href={a.href}
              class:list={["idioma", { "is-ativo": a.lang === lang }]}
              hreflang={a.lang}
              lang={a.lang}
              title={localeNames[a.lang]}
              aria-current={a.lang === lang ? "true" : undefined}
            >
              {localeLabels[a.lang]}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="cabecalho">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.titleA} {c.titleB}</h1>
      <p class="lead">{c.lead}</p>
    </div>

    <div class="divisao">
      {
        portas.map((p, i) => (
          <a class="canal" href={p.href} data-escolha={p.chave} style={`--i: ${i}`}>
            <CenaPorta cena={p.chave === "governo" ? "governo" : "empresas"} />
            <span class="canal-sombra" aria-hidden="true" />
            <span class="canal-conteudo">
              <span class="canal-rotulo">{p.canal}</span>
              <span class="canal-nome">
                {p.nome}
                <span class="canal-nome-resto">{p.resto}</span>
              </span>
              <span class="canal-detalhe">
                <span class="canal-lead">{p.lead}</span>
                <span class="canal-itens">
                  {p.items.map((it) => (
                    <span class="canal-item">{it}</span>
                  ))}
                </span>
                <span class="canal-cta">
                  {c.cta}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h13M12.5 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </span>
          </a>
        ))
      }
      <span class="costura" aria-hidden="true"></span>
    </div>

    <div class="varredura" aria-hidden="true"></div>

    <footer class="barra barra--rodape">
      <a class="email" href="mailto:comercial@procgroup.com.br">comercial@procgroup.com.br</a>
    </footer>
  </div>

  <section class="instituc">
    <div class="instituc-inner">
      <p class="instituc-eyebrow">{c.status}</p>
      <h2>PROC GROUP</h2>
      <p class="instituc-texto">{th.metaDescription}</p>
      <p class="instituc-texto">{th.aboutText}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .instituc { background: var(--color-bg); border-top: 1px solid var(--color-border); padding: var(--space-16) var(--space-12); }
  .instituc-inner { max-width: 720px; margin-inline: auto; }
  .instituc-eyebrow { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red-400); }
  .instituc h2 { margin-top: var(--space-3); font-size: var(--fs-2xl); color: var(--color-text); }
  .instituc-texto { margin-top: var(--space-4); font-size: var(--fs-sm); line-height: var(--lh-normal); color: var(--color-text-muted); }

  /* ── Entrada: as duas metades se encontram na costura ────────────────────
     Barra e título primeiro, depois cada metade desliza do seu lado até
     fechar o painel. Tudo com `both`: o estado inicial vale antes do delay,
     senão o conteúdo pisca visível e some. Quem pediu menos movimento recebe
     tudo já no lugar (bloco no fim do arquivo). */
  @keyframes surgir { from { opacity: 0 } to { opacity: 1 } }
  @keyframes subir {
    from { opacity: 0; transform: translateY(22px) }
    to   { opacity: 1; transform: none }
  }
  @keyframes fecharEsq {
    from { opacity: 0; transform: translateX(-32px) }
    to   { opacity: 1; transform: none }
  }
  @keyframes fecharDir {
    from { opacity: 0; transform: translateX(32px) }
    to   { opacity: 1; transform: none }
  }
  @keyframes passarLuz {
    0%   { opacity: 0; transform: translateX(-60%) }
    18%  { opacity: .5 }
    100% { opacity: 0; transform: translateX(160%) }
  }
  @keyframes descerPulso {
    0%   { top: -18%; opacity: 0 }
    12%  { opacity: .55 }
    88%  { opacity: .55 }
    100% { top: 104%; opacity: 0 }
  }

  [data-entrada] .barra--topo { animation: surgir .8s ease-out .1s both; }
  /* Cabeçalho e costura usam `backwards`, não `both`: os dois esmaecem no
     hover via opacity, e um fill forwards venceria essa regra para sempre. */
  [data-entrada] .cabecalho { animation: subir .9s cubic-bezier(.16,1,.3,1) .25s backwards; }
  [data-entrada] .canal:first-child { animation: fecharEsq 1.1s cubic-bezier(.16,1,.3,1) .45s both; }
  [data-entrada] .canal:nth-child(2) { animation: fecharDir 1.1s cubic-bezier(.16,1,.3,1) .45s both; }
  [data-entrada] .costura { animation: surgir 1.2s ease-out 1.2s backwards; }
  [data-entrada] .barra--rodape { animation: surgir .8s ease-out 1.3s both; }

  /* Uma passada de luz, uma vez só: o monitor acordando. Repetir viraria
     enfeite — o manual limita o glow a uso pontual. */
  .varredura {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 40%;
    pointer-events: none;
    z-index: 3;
    background: linear-gradient(100deg, transparent, rgba(255, 74, 84, .07) 45%, rgba(226, 231, 245, .05) 55%, transparent);
    /* A luz passa quando a cortina abre, não atrás dela. */
    animation: passarLuz 2.4s ease-out calc(var(--t) + .35s) both;
  }

  /* A página ocupa a janela inteira: é um pedágio, não tem rolagem em desktop.
     min-height em vez de height para não cortar conteúdo quando a fonte do
     sistema é maior ou a janela é baixa. */
  .painel {
    /* Quanto a página espera pela abertura (IntroBoot.astro). A entrada do
       seletor roda ATRÁS da cortina fechada — quando ela se parte, o que
       aparece já está assentado. Só a passada de luz espera, para acontecer
       no momento da revelação. Sem abertura (pulada ou movimento reduzido),
       zero. */
    --t: 2.45s;
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    overflow: hidden;
  }

  .barra {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-12);
  }
  .barra--rodape { justify-content: center; border-top: 1px solid var(--color-border); }

  .marca { display: flex; align-items: center; gap: var(--space-3); }
  .marca-nome {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .marca-sufixo { color: var(--color-text-faint); }

  .status,
  .email {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .email:hover { color: var(--color-text); }
  .email { display: inline-flex; align-items: center; min-height: 40px; }

  .idiomas { display: flex; gap: var(--space-1); }
  .idioma {
    /* Alvo de toque: 29px de altura reprovava no celular. O padding sobe a
       area clicavel sem mudar o visual do texto. */
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-text-faint);
    transition: color var(--dur-fast) ease;
  }
  .idioma:hover { color: var(--color-text); }
  .idioma.is-ativo { background: rgba(255, 255, 255, 0.08); color: var(--color-text); }

  /* ── Cabeçalho compacto e central: o protagonista é a divisão, não o h1 ── */
  .cabecalho {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--space-4) var(--space-8) var(--space-6);
    transition: opacity var(--dur-med) ease;
  }
  .eyebrow {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--red-400);
  }
  .cabecalho h1 { margin-top: var(--space-2); font-size: var(--fs-2xl); }
  .lead {
    margin-inline: auto;
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    max-width: 52ch;
    text-wrap: pretty;
  }
  /* Com uma metade em foco, o cabeçalho sai de cena sem sair do lugar. */
  .painel:has(.canal:hover) .cabecalho,
  .painel:has(.canal:focus-visible) .cabecalho { opacity: 0.35; }

  /* ── A divisão: duas metades que disputam a tela ─────────────────────────
     flex-grow anima; a metade sob o cursor vai a ~63% e a outra escurece pela
     .canal-sombra. Sem :has (navegador antigo) só a expansão acontece — a
     página continua inteira. */
  .divisao {
    position: relative;
    flex: 1;
    display: flex;
    min-height: 0;
  }

  .canal {
    position: relative;
    isolation: isolate;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    transition: flex-grow 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .canal:hover,
  .canal:focus-visible { flex-grow: 1.7; }

  /* Véu extra da metade preterida — por cima da cena, por baixo do texto. */
  .canal-sombra {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(6, 10, 20, 0.62);
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }
  .divisao:has(.canal:hover) .canal:not(:hover) .canal-sombra,
  .divisao:has(.canal:focus-visible) .canal:not(:focus-visible) .canal-sombra { opacity: 1; }

  /* A costura: onde as duas operações se encontram. Um pulso de luz desce a
     linha de tempos em tempos — devagar e discreto, ritmo de varredura, não
     glow decorativo. */
  .costura {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    z-index: 2;
    background: rgba(226, 231, 245, 0.14);
    pointer-events: none;
  }
  .costura::after {
    content: "";
    position: absolute;
    left: -1px;
    width: 3px;
    height: 140px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, var(--red-400), transparent);
    animation: descerPulso 7s ease-in-out 2.6s infinite;
    opacity: 0;
  }
  /* Com uma metade expandida a linha central mente sobre a fronteira real —
     some junto com o cabeçalho. */
  .divisao:has(.canal:hover) .costura,
  .divisao:has(.canal:focus-visible) .costura { opacity: 0; transition: opacity 0.4s ease; }

  /* Respiro fluido: a meia tela muda muito de tamanho entre um notebook e um
     monitor largo. Em vh no eixo vertical porque o que aperta aqui é a altura
     — a metade é uma faixa larga e baixa.
     A escala do projeto não tem --space-10: token inexistente invalida o
     shorthand inteiro e o padding vira zero (foi o que aconteceu). Só existem
     1,2,3,4,5,6,8,12,16,24,32. */
  .canal-conteudo {
    position: relative;
    z-index: 2;
    display: block;
    padding: clamp(var(--space-8), 6vh, var(--space-16)) clamp(var(--space-8), 4vw, var(--space-24));
    max-width: 720px;
  }

  .canal-rotulo {
    display: block;
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-4);
  }

  /* O letreiro: contorno fantasma que preenche quando a metade é a escolhida.
     -webkit-text-stroke tem suporte real em todos os navegadores atuais; se
     faltar, o fallback é a cor sólida direto (o @supports abaixo). */
  .canal-nome {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    /* min(vw, vh): numa faixa larga e baixa quem estoura é a altura — sem o
       vh o letreiro empurra o detalhe para fora do recorte em notebook. */
    font-size: clamp(2.75rem, min(6.6vw, 12vh), 7rem);
    line-height: 0.94;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--white);
    transition: color 0.55s ease;
  }
  @supports (-webkit-text-stroke: 1px white) {
    .canal-nome {
      color: transparent;
      -webkit-text-stroke: 2px rgba(226, 231, 245, 0.5);
      transition: color 0.55s ease, -webkit-text-stroke-color 0.55s ease;
    }
    .canal:hover .canal-nome,
    .canal:focus-visible .canal-nome {
      color: var(--white);
      -webkit-text-stroke-color: transparent;
    }
  }
  .canal-nome-resto {
    display: block;
    font-size: clamp(1.05rem, 1.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin-top: var(--space-3);
    /* Complemento do letreiro: apagado de propósito. Sólido, competia com o
       nome em contorno e virava o elemento mais forte do cartão. */
    color: var(--color-text-faint);
    -webkit-text-stroke: 0;
  }

  /* O detalhe ocupa o espaço desde o início (o letreiro não pula) e só ganha
     opacidade quando a metade está em foco. */
  .canal-detalhe {
    display: block;
    margin-top: var(--space-5);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.55s ease 0.08s, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }
  .canal:hover .canal-detalhe,
  .canal:focus-visible .canal-detalhe { opacity: 1; transform: none; }

  .canal-lead {
    display: block;
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .canal-itens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
  }
  .canal-item {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .canal-item::before { content: "› "; color: var(--color-text-faint); }

  .canal-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    /* 48px de alvo de toque, não 44: a régua do projeto é múltiplo de 4. */
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--white);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .canal:hover .canal-cta,
  .canal:focus-visible .canal-cta { background: var(--color-primary-dark); }

  /* Cortes estruturais do manual: 1200 / 900 / 640. */
  @media (max-width: 1200px) {
    .barra { padding-inline: var(--space-8); }
  }
  @media (max-width: 900px) {
    /* Empilhado, a página passa a rolar — e aí a rolagem é esperada, não um
       bug. Sem hover, cada metade nasce completa: nome preenchido e detalhe
       visível. A expansão é gesto de cursor, não de toque. */
    .painel { min-height: 0; }
    .divisao { flex-direction: column; }
    /* Em coluna, a base 0 do flex zeraria a altura: o conteúdo volta a mandar. */
    .canal { flex-basis: auto; min-height: 62vw; }
    .canal:hover, .canal:focus-visible { flex-grow: 1; }
    .costura { display: none; }
    .cabecalho { text-align: left; padding-inline: var(--space-8); }
    .lead { margin-inline: 0; }
    .canal-detalhe { opacity: 1; transform: none; }
    .canal-nome { color: var(--white); -webkit-text-stroke: 0; font-size: clamp(2.6rem, 9vw, 4.5rem); }
    .status { display: none; }
  }
  @media (max-width: 640px) {
    .barra { padding-inline: var(--space-5); }
    .cabecalho { padding-inline: var(--space-5); }
    .cabecalho h1 { font-size: var(--fs-xl); }
    .canal { min-height: 0; }
    .canal-conteudo { padding: var(--space-6) var(--space-5); }
    /* No celular a lista de solucoes dobrava a altura e empurrava a segunda
       porta para fora da dobra — o visitante nem descobria que havia duas.
       Rotulo, nome, lead e CTA bastam para escolher; a lista completa esta na
       home do lado, um toque adiante. */
    .canal-itens { display: none; }
    .canal-cta { width: 100%; justify-content: center; margin-top: var(--space-4); }
  }

  /* Toque sem hover em tela larga (TV, tablet grande): mesmo tratamento do
     empilhado — nome preenchido e detalhe visível, sem estados escondidos. */
  @media (hover: none) {
    .canal-detalhe { opacity: 1; transform: none; }
    .canal-nome { color: var(--white); -webkit-text-stroke: 0; }
  }

  /* Abertura pulada (botão, clique ou Esc): a luz não fica devendo 3s. */
  :global(html.intro-pulada) .painel { --t: 0s; }

  @media (prefers-reduced-motion: reduce) {
    .painel { --t: 0s; }
    .canal, .canal-sombra, .canal-nome, .canal-detalhe, .cabecalho, .idioma { transition: none; }
    .canal:hover, .canal:focus-visible { flex-grow: 1; }
    .canal-detalhe { opacity: 1; transform: none; }
    /* Sem sequência de entrada: tudo já no lugar, e nenhuma luz se move. */
    [data-entrada] .barra--topo, [data-entrada] .cabecalho,
    [data-entrada] .canal:first-child, [data-entrada] .canal:nth-child(2),
    [data-entrada] .costura, [data-entrada] .barra--rodape { animation: none; }
    .varredura { display: none; }
    .costura::after { animation: none; }
  }
</style>

<script>
  // Gancho de medição. O site ainda não tem analytics — quando tiver, é aqui que
  // o evento entra, e o resto da página não muda. Exemplos:
  //   Plausible: plausible('Escolha de publico', { props: { publico: escolha } })
  //   Umami:     umami.track('escolha-publico', { publico: escolha })
  // Também grava a escolha, que é o que permite personalizar a visita seguinte.
  document.querySelectorAll<HTMLAnchorElement>("[data-escolha]").forEach((el) => {
    el.addEventListener("click", () => {
      const escolha = el.dataset.escolha;
      if (!escolha) return;
      try {
        localStorage.setItem("proc:publico", escolha);
      } catch {
        // Modo privativo ou storage cheio: a navegação não pode quebrar por isso.
      }
    });
  });
</script>
