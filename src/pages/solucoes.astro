---
/**
 * O índice de Soluções com as três áreas do documento, como ficaria no ar.
 *
 * Fora do site publicado, mas sem nada de preview na tela.
 *
 * Redesign de 2026-10-26: mesmo padrão visual de A Proc, Infraestrutura de TI
 * e Hospedagem em Nuvem (src/styles/aproc.css e src/scripts/aprocCenas.ts).
 * Herói próprio com o triângulo das três áreas e uma faixa por área com a
 * cena da home, em src/components/solucoes/. O texto não mudou: título,
 * lead e o conteúdo dos cards são os mesmos de antes.
 */
import "../styles/aproc.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navPreview } from "../data/preview/ajustes";
import Hero from "../components/solucoes/Hero.astro";
import Areas from "../components/solucoes/Areas.astro";
---

<BaseLayout
  title="Soluções"
  description="Infraestrutura de TI, hospedagem em nuvem e visão computacional com IA. Três áreas de negócio, uma equipe especializada em cada uma."
  nav={navPreview()}
>
  <Hero
    eyebrow="Soluções"
    titulo="Três áreas de negócio. Uma equipe especializada em cada uma."
    lead="Da infraestrutura que mantém a operação funcionando à inteligência artificial que transforma imagens em informação. Escolha por onde começar."
  />
  <Areas />
</BaseLayout>

<script>
  import { montarCenas } from "../scripts/aprocCenas";
  montarCenas();
</script>
