---
/**
 * Herói de Visão Computacional: texto à esquerda e, à direita, a fotografia da
 * linha de produção com peças detectadas, num quadro com cantos de
 * enquadramento (o mesmo desenho do herói de Hospedagem em Nuvem). A imagem
 * entra com uma aproximação lenta e uma linha de leitura passa por ela de
 * tempos em tempos, como uma câmera analisando a cena.
 *
 * Texto: o hero de visao.ts, sem alteração. O hero do documento não tem CTA.
 */
import { Picture } from "astro:assets";
import foto from "../../assets/images/solucoes/hero-ia-industrial.jpg";

interface Props {
  hero: { eyebrow: string; titulo: string; lead?: string };
}
const { hero } = Astro.props;
---

<section class="ap-secao escura hero" data-cena>
  <div class="container grade">
    <div class="texto">
      <p class="eyebrow ap-entra" style="--i:0">{hero.eyebrow}</p>
      <h1 class="ap-entra" style="--i:1">{hero.titulo}</h1>
      {hero.lead && <p class="lead ap-entra" style="--i:2">{hero.lead}</p>}
    </div>

    <figure class="quadro">
      <div class="foto">
        <Picture
          src={foto}
          formats={["avif", "webp"]}
          widths={[640, 960, 1376]}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Linha de produção com peças na esteira, cada uma marcada por um quadro de detecção da câmera"
          loading="eager"
          fetchpriority="high"
          class="foto-img"
        />
        <span class="leitura" aria-hidden="true"></span>
      </div>
      <span class="canto c1" aria-hidden="true"></span>
      <span class="canto c2" aria-hidden="true"></span>
      <span class="canto c3" aria-hidden="true"></span>
      <span class="canto c4" aria-hidden="true"></span>
      <span class="rec" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-16); }
  .grade { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--space-12); align-items: center; }
  .hero h1 { margin-top: var(--space-5); font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem); color: var(--white); }
  .lead { margin-top: var(--space-8); max-width: 46ch; padding-left: var(--space-6); border-left: 2px solid var(--red-500); font-size: var(--fs-lg); line-height: 1.6; color: rgba(230, 238, 248, 0.8); }

  .quadro { position: relative; margin: 0; padding: 14px; }
  .foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1376 / 768;
    border-radius: var(--radius-md);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .foto :global(.foto-img) { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 3s cubic-bezier(0.22, 1, 0.36, 1); }
  .em-cena .foto :global(.foto-img) { transform: none; }
  /* Linha de leitura que desce pela imagem, de tempos em tempos. */
  .leitura {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 74, 84, 0.9), transparent);
    box-shadow: 0 0 18px 4px rgba(226, 8, 29, 0.35);
    opacity: 0;
  }
  .em-cena .leitura { animation: vc-leitura 5s ease-in-out 1.4s infinite; }
  @keyframes vc-leitura {
    0% { opacity: 0; top: 0; }
    8% { opacity: 1; }
    50% { opacity: 1; top: calc(100% - 2px); }
    58%, 100% { opacity: 0; top: calc(100% - 2px); }
  }

  .canto { position: absolute; width: 34px; height: 34px; border-color: var(--red-500); border-style: solid; border-width: 0; opacity: 0; transition: opacity 0.5s ease 1.2s, transform 0.6s var(--ease-out) 1.2s; }
  .c1 { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; transform: translate(8px, 8px); }
  .c2 { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; transform: translate(-8px, 8px); }
  .c3 { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; transform: translate(-8px, -8px); }
  .c4 { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; transform: translate(8px, -8px); }
  .em-cena .canto { opacity: 1; transform: none; }
  /* Ponto de gravação no canto do quadro. */
  .rec { position: absolute; top: 30px; right: 30px; width: 10px; height: 10px; border-radius: 50%; background: var(--red-500); box-shadow: 0 0 10px rgba(226, 8, 29, 0.9); opacity: 0; }
  .em-cena .rec { animation: vc-rec 1.6s steps(1) 1.6s infinite; }
  @keyframes vc-rec { 0% { opacity: 1; } 50% { opacity: 0.2; } }

  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; gap: var(--space-8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .foto :global(.foto-img) { transform: none; transition: none; }
    .em-cena .leitura, .em-cena .rec { animation: none; }
    .rec { opacity: 1; }
    .canto { transition: none; opacity: 1; transform: none; }
  }
</style>

