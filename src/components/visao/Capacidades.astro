---
/**
 * "O que a Plataforma Proc pode fazer na sua operação?": as informações que a
 * plataforma gera, como etiquetas dentro de um visor de câmera (cantos de
 * enquadramento e ponto de gravação). Quando a seção aparece, as etiquetas
 * acendem uma a uma; depois, uma linha de leitura desce pelo visor de tempos
 * em tempos.
 *
 * Texto: titulo, paragrafos, itensTitulo, itens e depois do bloco, sem
 * alteração.
 */
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
---

<section class="ap-secao escura capacidades" data-cena>
  <div class="container">
    <div class="ap-cabeca">
      {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
      {bloco.paragrafos?.map((p, i) => <p class="ap-p ap-entra" style={`--i:${i + 1}`}>{p}</p>)}
    </div>

    <div class="visor ap-entra" style="--i:2">
      <span class="canto c1" aria-hidden="true"></span>
      <span class="canto c2" aria-hidden="true"></span>
      <span class="canto c3" aria-hidden="true"></span>
      <span class="canto c4" aria-hidden="true"></span>
      <span class="rec" aria-hidden="true"></span>
      <span class="leitura" aria-hidden="true"></span>
      {bloco.itensTitulo && <p class="itens-titulo">{bloco.itensTitulo}</p>}
      <ul class="etiquetas">
        {bloco.itens?.map((it, k) => <li style={`--k:${k}`}>{it}</li>)}
      </ul>
    </div>

    {bloco.depois?.map((p) => <p class="depois ap-entra" style="--i:3">{p}</p>)}
  </div>
</section>

<style>
  .capacidades h2 { color: var(--white); }
  .visor {
    position: relative;
    margin-top: var(--space-12);
    padding: var(--space-12) var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      linear-gradient(rgba(230, 238, 248, 0.04) 1px, transparent 1px) 0 0 / 100% 32px,
      radial-gradient(80% 100% at 50% 0%, rgba(37, 56, 102, 0.5), transparent 70%),
      rgba(6, 10, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .itens-titulo { position: relative; max-width: 70ch; font-size: var(--fs-base); font-weight: 600; color: var(--white); }
  .etiquetas { position: relative; list-style: none; margin: var(--space-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .etiquetas li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #e6eef8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(230, 238, 248, 0.14);
    opacity: 0.15;
    transition: opacity 0.35s ease calc(0.6s + var(--k) * 0.07s), border-color 0.35s ease calc(0.6s + var(--k) * 0.07s);
  }
  .etiquetas li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--red-500); box-shadow: 0 0 6px rgba(226, 8, 29, 0.8); }
  .em-cena .etiquetas li { opacity: 1; border-color: rgba(255, 74, 84, 0.35); }

  .canto { position: absolute; width: 28px; height: 28px; border: 0 solid var(--red-500); }
  .c1 { top: 14px; left: 14px; border-top-width: 2px; border-left-width: 2px; }
  .c2 { top: 14px; right: 14px; border-top-width: 2px; border-right-width: 2px; }
  .c3 { bottom: 14px; right: 14px; border-bottom-width: 2px; border-right-width: 2px; }
  .c4 { bottom: 14px; left: 14px; border-bottom-width: 2px; border-left-width: 2px; }
  .rec { position: absolute; top: 24px; right: 52px; width: 8px; height: 8px; border-radius: 50%; background: var(--red-500); }
  .em-cena .rec { animation: cp-rec 1.6s steps(1) 1s infinite; }
  @keyframes cp-rec { 50% { opacity: 0.2; } }
  .leitura { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, transparent, rgba(255, 74, 84, 0.8), transparent); box-shadow: 0 0 16px 3px rgba(226, 8, 29, 0.3); opacity: 0; pointer-events: none; }
  .em-cena .leitura { animation: cp-leitura 6s ease-in-out 2.4s infinite; }
  @keyframes cp-leitura {
    0% { opacity: 0; top: 0; }
    6% { opacity: 1; }
    45% { opacity: 1; top: calc(100% - 2px); }
    52%, 100% { opacity: 0; top: calc(100% - 2px); }
  }

  .depois { margin-top: var(--space-8); max-width: 68ch; font-size: var(--fs-base); line-height: 1.6; color: rgba(230, 238, 248, 0.78); }

  @media (max-width: 560px) {
    .visor { padding: var(--space-12) var(--space-5) var(--space-8); }
    .etiquetas li { font-size: var(--fs-xs); padding: 6px 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .etiquetas li { opacity: 1; transition: none; border-color: rgba(255, 74, 84, 0.35); }
    .em-cena .rec, .em-cena .leitura { animation: none; }
  }
</style>
