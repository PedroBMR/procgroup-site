---
/**
 * Seção de aplicação: texto de um lado e, do outro, a cena desenhada para o
 * assunto daquele bloco (src/components/visao/cenas.ts). Serve aos blocos que
 * têm a mesma forma no documento (título, subtítulo, parágrafos, lista,
 * fechamento) e mudam no desenho: produção, inspeção, máquinas, expedição,
 * estoque, automação, reaproveitamento e tecnologia própria.
 *
 * As listas entram item a item, com o marcador vermelho do padrão das páginas
 * de área. O desenho fica preso ao lado do texto enquanto a lista rola.
 *
 * Texto: eyebrow, titulo, subtitulo, paragrafos, itensTitulo, itens, depois e
 * fecho do bloco, sem alteração, nesta ordem.
 */
import Cena from "./Cena.astro";
import type { NomeCena } from "./cenas";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
  cena: NomeCena;
  tom?: "clara" | "alt" | "escura";
  /** Cena à esquerda do texto. */
  invertido?: boolean;
}
const { bloco, cena, tom = "clara", invertido = false } = Astro.props;
const escura = tom === "escura";
---

<section
  class:list={["ap-secao aplicacao", { escura, alt: tom === "alt", invertido }]}
  data-theme={escura ? undefined : "light"}
  data-cena
  id={bloco.id}
>
  <div class="container grade">
    <div class="texto">
      <div class="ap-cabeca">
        {bloco.eyebrow && <p class="eyebrow ap-entra">{bloco.eyebrow}</p>}
        {bloco.titulo && <h2 class="ap-entra" style="--i:1">{bloco.titulo}</h2>}
        {bloco.subtitulo && <p class="ap-sub ap-entra" style="--i:2">{bloco.subtitulo}</p>}
        {bloco.paragrafos?.map((p, i) => <p class="ap-p ap-entra" style={`--i:${i + 3}`}>{p}</p>)}
      </div>
      {bloco.itensTitulo && <p class="itens-titulo ap-entra" style="--i:4">{bloco.itensTitulo}</p>}
      {bloco.itens && (
        <ul class="itens">
          {bloco.itens.map((it, k) => <li style={`--k:${k}`}>{it}</li>)}
        </ul>
      )}
      {bloco.depois?.map((p) => <p class="depois ap-entra" style="--i:5">{p}</p>)}
      {bloco.fecho && (
        <div class="frases ap-entra" style="--i:6">
          {bloco.fecho.map((p) => <p>{p}</p>)}
        </div>
      )}
    </div>
    <div class="figura ap-entra" style="--i:2"><Cena nome={cena} /></div>
  </div>
</section>

<style>
  .aplicacao { scroll-margin-top: calc(var(--topbar-h) + var(--header-h)); }
  .alt { background: var(--color-bg-alt); }
  .escura h2 { color: var(--white); }
  .grade { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-16); align-items: start; }
  .invertido .grade { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .invertido .figura { order: -1; }
  .figura { position: sticky; top: calc(var(--topbar-h) + var(--header-h) + var(--space-8)); }

  .itens-titulo { margin-top: var(--space-8); font-size: var(--fs-sm); font-weight: 700; color: var(--color-text); }
  .itens { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2) var(--space-5); }
  .itens li {
    position: relative;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease calc(0.5s + var(--k) * 0.06s), transform 0.5s var(--ease-out) calc(0.5s + var(--k) * 0.06s);
  }
  .escura .itens li { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.07); }
  .itens li::before { content: ""; position: absolute; left: var(--space-3); top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--red-500); }
  .em-cena .itens li { opacity: 1; transform: none; }

  .depois { margin-top: var(--space-6); max-width: 60ch; font-size: var(--fs-base); font-weight: 600; line-height: 1.55; color: var(--color-text); }
  .frases { margin-top: var(--space-8); padding-left: var(--space-6); border-left: 2px solid var(--red-500); }
  .frases p { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); text-transform: uppercase; line-height: var(--lh-snug); color: var(--color-text); }
  .frases p + p { margin-top: var(--space-2); color: var(--red-600); }
  .escura .frases p + p { color: var(--red-400); }

  @media (max-width: 900px) {
    .grade, .invertido .grade { grid-template-columns: 1fr; gap: var(--space-12); }
    .figura { position: static; max-width: 520px; }
    .invertido .figura { order: 0; }
  }
  @media (max-width: 560px) {
    .itens { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .itens li { opacity: 1; transform: none; transition: none; }
  }
</style>
