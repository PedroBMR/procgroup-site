---
/**
 * "Como funciona?": os oito passos numerados como um caminho vertical. Os
 * passos 05 ("Você pode participar junto, ou") e 06 ("A Proc conduz a
 * negociação.") são as duas saídas de uma escolha, então o caminho se divide
 * em dois ali e volta a se juntar no passo 07. O último passo fica em
 * destaque. Os conectores levam um pulso em loop, de cima para baixo.
 *
 * Continua sendo uma única <ol> com os oito itens na ordem: a divisão é só
 * de posição (grade de duas colunas), leitor de tela lê a lista inteira.
 *
 * Texto: titulo, itens (com a numeração 01 a 08 de antes) e depois do bloco,
 * sem alteração.
 */
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const itens = bloco.itens ?? [];
---

<section class="ap-secao como" data-theme="light" data-cena>
  <div class="container">
    <div class="ap-cabeca centro">
      {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
    </div>

    <ol class="caminho">
      {itens.map((it, n) => (
        <li class:list={["passo ap-entra", { fim: n === itens.length - 1 }]} style={`--i:${n + 1}`}>
          <span class="num">{String(n + 1).padStart(2, "0")}</span>
          <span class="txt">{it}</span>
        </li>
      ))}
    </ol>

    {bloco.depois?.map((p) => <p class="depois ap-entra" style="--i:9">{p}</p>)}
  </div>
</section>

<style>
  .centro { margin-inline: auto; text-align: center; }

  /* Conector: linha fina com um pulso que desce. */
  .caminho {
    --gap: 40px;
    --col: 24px;
    --linha: linear-gradient(180deg, transparent 0 42%, var(--red-500) 42% 58%, transparent 58%) 0 0 / 100% 300%, var(--navy-700);
    position: relative;
    isolation: isolate;
    list-style: none;
    margin: var(--space-12) auto 0;
    padding: 0;
    max-width: 760px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col);
    row-gap: var(--gap);
  }
  .passo {
    position: relative;
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 14px 30px -24px rgba(11, 23, 48, 0.4);
  }
  .passo:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--gap));
    width: 2px;
    height: var(--gap);
    margin-left: -1px;
    background: var(--linha);
  }
  .em-cena .passo::before, .em-cena .passo:nth-child(4)::after { animation: pc-desce 2.4s linear calc(2s + var(--i) * 0.2s) infinite; }
  @keyframes pc-desce { from { background-position: 0 100%, 0 0; } to { background-position: 0 0, 0 0; } }

  /* A escolha: 05 e 06 lado a lado, saindo de 04 e voltando para 07. */
  .passo:nth-child(5), .passo:nth-child(6) { grid-column: auto; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .passo:nth-child(5)::before, .passo:nth-child(6)::before, .passo:nth-child(7)::before { top: calc(-0.5 * var(--gap)); height: calc(0.5 * var(--gap)); }
  .passo:nth-child(4)::after { content: ""; position: absolute; left: 50%; top: 100%; width: 2px; height: calc(0.5 * var(--gap)); margin-left: -1px; background: var(--linha); }
  .passo:nth-child(5)::after, .passo:nth-child(6)::after { content: ""; position: absolute; top: calc(-0.5 * var(--gap) - 1px); height: 2px; background: var(--navy-700); }
  .passo:nth-child(5)::after { left: 50%; right: calc(-0.5 * var(--col)); }
  .passo:nth-child(6)::after { left: calc(-0.5 * var(--col)); right: 50%; }
  /* Volta: um U que sai do meio de 05 e de 06 e encontra a linha de 07. */
  .passo:nth-child(7)::after {
    content: "";
    position: absolute;
    top: calc(-1 * var(--gap));
    left: calc((100% - var(--col)) / 4 - 1px);
    right: calc((100% - var(--col)) / 4 - 1px);
    height: calc(0.5 * var(--gap));
    border: 2px solid var(--navy-700);
    border-top: 0;
  }

  .num { flex: none; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); color: var(--red-600); min-width: 2ch; }
  .txt { font-size: var(--fs-base); font-weight: 600; line-height: 1.4; color: var(--color-text); }
  .fim { background: var(--navy-900); border-color: var(--navy-900); box-shadow: 0 20px 40px -20px rgba(226, 8, 29, 0.45); }
  .fim .txt { color: var(--white); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); text-transform: uppercase; }
  .fim .num { color: var(--red-400); }

  .depois { max-width: 62ch; margin: var(--space-12) auto 0; text-align: center; font-size: var(--fs-base); line-height: 1.65; color: var(--color-text-muted); }

  @media (max-width: 560px) {
    .caminho { --col: 12px; }
    .passo { padding: var(--space-3) var(--space-4); gap: var(--space-3); }
    .txt { font-size: var(--fs-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .em-cena .passo::before, .em-cena .passo:nth-child(4)::after { animation: none; }
    .caminho { --linha: var(--navy-700); }
  }
</style>
