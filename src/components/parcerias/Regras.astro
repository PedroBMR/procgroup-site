---
/**
 * "Regras para validar uma indicação": as doze regras como uma lista de
 * verificação. Cada cartão tem o número e um selo de verificação que se
 * desenha quando a seção entra, um depois do outro, e uma barra no alto se
 * enche em doze partes, acompanhando. Depois, um brilho percorre os selos em
 * ordem, em loop: a indicação passando pela checagem.
 *
 * Todas as regras ficam visíveis, sem abas: é texto de regra, não pode ficar
 * escondido atrás de clique.
 *
 * Texto: titulo, paragrafos, cards (n, titulo, itensTitulo, itens,
 * paragrafos) e depois do bloco, sem alteração.
 */
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const cards = bloco.cards ?? [];
---

<section class="ap-secao regras" data-theme="light" style={`--total:${cards.length}`}>
  <div class="container">
    <div class="ap-cabeca" data-cena>
      {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
      {bloco.paragrafos?.map((p, i) => <p class:list={["ap-p ap-entra", { forte: i === 1 }]} style={`--i:${i + 1}`}>{p}</p>)}
    </div>

    <div class="barra" aria-hidden="true" data-cena>
      {cards.map((_, k) => <span style={`--k:${k}`}></span>)}
    </div>

    <ol class="grade">
      {cards.map((c, k) => (
        <li class="regra" data-cena style={`--k:${k}`}>
          <div class="topo">
            {c.n && <span class="n">{c.n}</span>}
            <svg class="selo" viewBox="0 0 40 40" aria-hidden="true">
              <circle class="ap-traco" cx="20" cy="20" r="16" pathLength="1" style="--o:0.4" />
              <path class="ap-traco" d="M13 20.5l4.5 4.5L27 15.5" pathLength="1" style="--o:0.8" />
            </svg>
          </div>
          <h3>{c.titulo}</h3>
          {c.itensTitulo && <p class="p">{c.itensTitulo}</p>}
          {c.itens && <ul class="dados">{c.itens.map((it) => <li>{it}</li>)}</ul>}
          {c.paragrafos?.map((p) => <p class="p">{p}</p>)}
        </li>
      ))}
    </ol>

    <div data-cena>{bloco.depois?.map((p) => <p class="nota ap-entra">{p}</p>)}</div>
  </div>
</section>

<style>
  .forte { color: var(--color-text); font-weight: 600; }

  .barra { display: grid; grid-template-columns: repeat(var(--total), 1fr); gap: 4px; margin-top: var(--space-12); }
  .barra span { height: 4px; border-radius: 2px; background: var(--color-border); position: relative; overflow: hidden; }
  .barra span::after { content: ""; position: absolute; inset: 0; background: var(--red-600); transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease calc(0.9s + var(--k) * 0.15s); }
  .barra.em-cena span::after { transform: none; }

  .grade { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .regra {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 14px 30px -26px rgba(11, 23, 48, 0.4);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s var(--ease-out) calc(var(--k) * 0.04s), transform 0.8s var(--ease-out) calc(var(--k) * 0.04s);
  }
  /* Cada cartão é uma cena própria: a seção inteira é alta demais para o
     gatilho de 25% no celular. */
  .regra.em-cena { opacity: 1; transform: none; }
  .topo { display: flex; justify-content: space-between; align-items: center; }
  .n { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); color: var(--red-600); }
  .selo { width: 36px; height: 36px; fill: none; stroke: var(--red-600); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; border-radius: 50%; }
  .em-cena .selo { animation: pc-brilho 6s ease-in-out calc(2s + var(--k) * 0.5s) infinite; }
  @keyframes pc-brilho { 0%, 12%, 100% { filter: none; } 6% { filter: drop-shadow(0 0 6px rgba(226, 8, 29, 0.7)); } }
  .regra h3 { margin-top: var(--space-3); font-size: var(--fs-lg); line-height: var(--lh-snug); }
  .p { margin-top: var(--space-3); font-size: var(--fs-sm); line-height: 1.6; color: var(--color-text-muted); }
  .dados { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .dados li { padding: 6px 12px; border-radius: var(--radius-pill); background: var(--color-bg-alt); border: 1px solid var(--color-border); font-size: var(--fs-xs); font-weight: 600; color: var(--color-text); }

  .nota { max-width: 72ch; margin-top: var(--space-8); padding-left: var(--space-5); border-left: 2px solid var(--red-600); font-size: var(--fs-sm); line-height: 1.6; color: var(--color-text-muted); }

  @media (max-width: 1000px) {
    .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .grade { grid-template-columns: 1fr; }
    .regra { padding: var(--space-5); }
  }
  @media (prefers-reduced-motion: reduce) {
    .barra span::after { transition: none; transform: none; }
    .regra { transition: none; opacity: 1; transform: none; }
    .em-cena .selo { animation: none; }
  }
</style>
