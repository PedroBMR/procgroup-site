---
/**
 * "Parceria com desenvolvedores de software" (âncora #software do menu):
 * "Sua solução. Nossa infraestrutura." em desenho. À direita, uma pilha: a
 * aplicação do parceiro no alto e, embaixo dela, as sete camadas que o quinto
 * parágrafo cita (servidor, banco de dados, armazenamento, backup, segurança,
 * conectividade, suporte), só com ícones, sustentadas por uma base com a
 * marca da Proc. As camadas sobem uma a uma na entrada; depois, dados passam
 * pela espinha da pilha, em loop.
 *
 * O texto segue a ordem do documento: o problema comum ("Muitas software
 * houses...") e o que o cliente precisa ficam num quadro, porque é a virada
 * do argumento.
 *
 * Texto: id, titulo, subtitulo e paragrafos do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import { withBase } from "../../utils/url";
import type { Bloco } from "../../data/preview/blocos";
import type { NomeIconeMenu } from "../../data/iconesMenu";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const ps = bloco.paragrafos ?? [];
// Parágrafos 4 e 5 (índices 3 e 4): o problema. Antes, a apresentação; depois, a saída.
const antes = ps.slice(0, 3);
const problema = ps.slice(3, 5);
const depois = ps.slice(5);
const CAMADAS: NomeIconeMenu[] = ["servidores", "camadas", "caixas", "nuvemBackup", "escudo", "rede", "suporte"];
---

<section id={bloco.id} class="ap-secao software" data-theme="light" data-cena>
  <div class="container grade">
    <div class="texto">
      <div class="ap-cabeca">
        {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
        {bloco.subtitulo && <p class="ap-sub sub ap-entra" style="--i:1">{bloco.subtitulo}</p>}
      </div>
      {antes.map((p, i) => <p class:list={["ap-p ap-entra", { primeiro: i === 0 }]} style={`--i:${i + 2}`}>{p}</p>)}
      {problema.length > 0 && (
        <div class="problema ap-entra" style="--i:3">
          {problema.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        </div>
      )}
      {depois.map((p, i) => <p class:list={["ap-p ap-entra", { forte: i === depois.length - 1 }]} style={`--i:${i + 4}`}>{p}</p>)}
    </div>

    <div class="pilha" aria-hidden="true">
      <span class="app"><MenuIcon nome="codigo" /><MenuIcon nome="erp" /><MenuIcon nome="aplicativo" /></span>
      <span class="espinha"></span>
      <ul class="camadas">
        {CAMADAS.map((icone, k) => <li style={`--k:${CAMADAS.length - 1 - k}`}><MenuIcon nome={icone} /></li>)}
      </ul>
      <span class="base"><img src={withBase("/brand/logo-white.png")} alt="" width="234" height="74" loading="lazy" decoding="async" /></span>
    </div>
  </div>
</section>

<style>
  .grade { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--space-16); align-items: start; }
  .sub { color: var(--red-600); }
  .primeiro { font-size: var(--fs-lg); font-weight: 600; color: var(--color-text); }
  .forte { color: var(--color-text); font-weight: 600; }
  .problema {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--navy-900);
    box-shadow: 0 20px 40px -28px rgba(11, 23, 48, 0.7);
  }
  .problema p { font-size: var(--fs-base); line-height: 1.6; color: rgba(230, 238, 248, 0.82); }
  .problema p + p { margin-top: var(--space-3); }
  .problema .lead { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); text-transform: uppercase; color: var(--white); }

  .pilha { position: sticky; top: calc(var(--topbar-h) + var(--header-h) + var(--space-8)); display: grid; justify-items: center; gap: 10px; padding: var(--space-8) var(--space-6); border-radius: var(--radius-lg); background: var(--color-bg-alt); border: 1px solid var(--color-border); }
  .app {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 2px solid var(--red-600);
    color: var(--red-600);
    box-shadow: 0 16px 30px -20px rgba(226, 8, 29, 0.5);
  }
  .app :global(.menu-icon) { width: 28px; height: 28px; }
  /* Espinha: liga a aplicação à base, por trás das camadas, com um pulso. */
  .espinha { position: absolute; top: 60px; bottom: 60px; left: 50%; width: 2px; margin-left: -1px; background: linear-gradient(180deg, transparent 0 46%, var(--red-500) 48% 52%, transparent 54%) 0 0 / 100% 300%, var(--color-border-strong); }
  .em-cena .espinha { animation: pc-sobe 3s linear 2.5s infinite; }
  @keyframes pc-sobe { from { background-position: 0 0, 0 0; } to { background-position: 0 100%, 0 0; } }
  .camadas { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; width: 86%; }
  .camadas li {
    display: grid;
    place-items: center;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    color: var(--navy-700);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.4s ease calc(0.5s + var(--k) * 0.16s), transform 0.5s var(--ease-out) calc(0.5s + var(--k) * 0.16s);
  }
  .camadas li :global(.menu-icon) { width: 22px; height: 22px; }
  .em-cena .camadas li { opacity: 1; transform: none; }
  .base { position: relative; display: grid; place-items: center; width: 100%; height: 56px; border-radius: var(--radius-md); background: var(--navy-900); }
  .base img { width: 84px; height: auto; }

  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; gap: var(--space-10, 2.5rem); }
    .pilha { position: relative; top: auto; max-width: 420px; width: 100%; margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .camadas li { transition: none; opacity: 1; transform: none; }
    .em-cena .espinha { animation: none; }
  }
</style>
