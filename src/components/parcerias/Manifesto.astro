---
/**
 * O manifesto que fecha a página ("A tecnologia funciona melhor quando
 * pessoas e empresas trabalham juntas."). Acima do texto, duas linhas saem das
 * bordas da faixa, uma de cada lado, e se encontram num anel no centro com o
 * aperto de mãos: duas partes que andam juntas. Dados correm das duas pontas
 * para o centro, em loop.
 *
 * Texto: eyebrow, titulo, subtitulo e paragrafos do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const ESQ = "M20 60 C200 60 260 100 400 60";
const DIR = "M780 60 C600 60 540 20 400 60";
---

<section class="ap-secao escura manifesto" data-cena>
  <div class="encontro" aria-hidden="true">
    <svg viewBox="0 0 800 120" preserveAspectRatio="none">
      <path class="ap-traco linha" d={ESQ} pathLength="1" style="--o:0.2" vector-effect="non-scaling-stroke" />
      <path class="ap-traco linha" d={DIR} pathLength="1" style="--o:0.2" vector-effect="non-scaling-stroke" />
      <path class="ap-fluxo" d={ESQ} pathLength="1" style="--dur:3.2s" vector-effect="non-scaling-stroke" />
      <path class="ap-fluxo" d={DIR} pathLength="1" style="--dur:3.2s; --k:1" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="pc-no ativo aperto"><MenuIcon nome="parceria" /></span>
  </div>

  <div class="container texto">
    {bloco.eyebrow && <p class="eyebrow ap-entra">{bloco.eyebrow}</p>}
    {bloco.titulo && <h2 class="ap-entra" style="--i:1">{bloco.titulo}</h2>}
    {bloco.subtitulo && <p class="ap-fecho ap-entra" style="--i:2">{bloco.subtitulo}</p>}
    {bloco.paragrafos?.map((p) => <p class="ap-p ap-entra" style="--i:3">{p}</p>)}
  </div>
</section>

<style>
  .manifesto {
    text-align: center;
    padding-block: var(--space-24);
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(226, 8, 29, 0.12), transparent 65%),
      linear-gradient(135deg, var(--navy-900), var(--navy-950));
  }
  .encontro { position: relative; height: 120px; margin-bottom: var(--space-10, 2.5rem); }
  .encontro svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; overflow: visible; }
  .linha { stroke: rgba(230, 238, 248, 0.3); stroke-width: 1.6; }
  .aperto { position: absolute; left: 50%; top: 50%; width: 88px; height: 88px; transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: opacity 0.5s ease 1.3s, transform 0.6s var(--ease-out) 1.3s; }
  .aperto :global(.menu-icon) { width: 40px; height: 40px; }
  .em-cena .aperto { opacity: 1; transform: translate(-50%, -50%); }

  .texto h2 { max-width: 24ch; margin-inline: auto; font-size: var(--fs-3xl); color: var(--white); }
  .texto .eyebrow { justify-content: center; }
  .texto .ap-fecho { color: var(--red-400); }
  .texto .ap-p { margin-inline: auto; font-size: var(--fs-lg); color: rgba(230, 238, 248, 0.85); }

  @media (prefers-reduced-motion: reduce) {
    .aperto { transition: none; opacity: 1; transform: translate(-50%, -50%); }
  }
</style>
