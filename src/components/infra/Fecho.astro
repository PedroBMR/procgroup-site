---
/**
 * Último bloco da página: "Infraestrutura de TI para empresas que precisam de
 * disponibilidade, segurança e continuidade.", o fecho e o botão.
 *
 * Fecha o desenho que abriu a página: o mesmo diagrama do herói, compacto, ao
 * lado do texto. A infraestrutura do começo, agora inteira e funcionando.
 *
 * Texto: eyebrow, titulo, fecho e ctas do bloco, sem alteração.
 */
import Button from "../Button.astro";
import HubInfra from "./HubInfra.astro";
import { withBase } from "../../utils/url";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const L = (href: string) => (href.startsWith("#") || href.startsWith("http") ? href : withBase(href));
---

<section class="ap-secao escura fecho" data-cena>
  <div class="container grade">
    <div class="texto">
      {bloco.eyebrow && <p class="eyebrow ap-entra">{bloco.eyebrow}</p>}
      {bloco.titulo && <h2 class="ap-entra" style="--i:1">{bloco.titulo}</h2>}
      {bloco.fecho && (
        <div class="frases ap-entra" style="--i:2">
          {bloco.fecho.map((p) => <p>{p}</p>)}
        </div>
      )}
      {bloco.ctas && (
        <div class="ctas ap-entra" style="--i:3">
          {bloco.ctas.map((c, n) => (
            <Button href={L(c.href)} variant={n === 0 ? "primary" : "ghost"} size="lg">{c.label}</Button>
          ))}
        </div>
      )}
    </div>
    <div class="ap-entra" style="--i:2"><HubInfra compacto /></div>
  </div>
</section>

<style>
  .fecho {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background:
      radial-gradient(60% 70% at 85% 50%, rgba(37, 56, 102, 0.45), transparent 70%),
      linear-gradient(180deg, var(--navy-900), var(--navy-950));
  }
  .grade { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-12); align-items: center; }
  .fecho h2 { margin-top: var(--space-4); max-width: 24ch; font-size: var(--fs-3xl); color: var(--white); }
  .frases { margin-top: var(--space-6); padding-left: var(--space-6); border-left: 2px solid var(--red-500); }
  .frases p { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); text-transform: uppercase; line-height: var(--lh-snug); color: var(--white); }
  .frases p + p { color: var(--red-400); }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
  }
</style>
