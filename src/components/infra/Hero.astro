---
/**
 * Herói da página de Infraestrutura de TI: eyebrow, título e lead à esquerda,
 * e à direita o diagrama da infraestrutura integrada (HubInfra), que se monta
 * quando a página abre.
 *
 * Texto: o hero de infra.ts, sem alteração. O hero do documento não tem CTA.
 */
import HubInfra from "./HubInfra.astro";

interface Props {
  hero: { eyebrow: string; titulo: string; lead?: string };
}
const { hero } = Astro.props;
---

<section class="ap-secao escura hero" data-cena>
  <div class="container grade">
    <div class="texto">
      <p class="eyebrow ap-entra" style="--i:0">{hero.eyebrow}</p>
      <h1 class="ap-entra" style="--i:1">{hero.titulo}</h1>
      {hero.lead && <p class="lead ap-entra" style="--i:2">{hero.lead}</p>}
    </div>
    <div class="ap-entra" style="--i:1"><HubInfra /></div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-16); min-height: min(82svh, 760px); display: flex; align-items: center; }
  .hero .container { width: 100%; }
  .grade { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-12); align-items: center; }
  .hero h1 { margin-top: var(--space-5); max-width: 20ch; font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.75rem); color: var(--white); }
  .lead {
    margin-top: var(--space-8);
    max-width: 48ch;
    padding-left: var(--space-6);
    border-left: 2px solid var(--red-500);
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: rgba(230, 238, 248, 0.78);
  }
  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
    .hero { min-height: 0; }
  }
</style>
