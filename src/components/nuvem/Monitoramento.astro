---
/**
 * "Monitoramento contínuo": um mostrador de 24 horas ao lado do texto. As 24
 * marcas se acendem uma a uma, numa única volta do ponteiro, quando a seção
 * aparece: o dia inteiro coberto, não só o horário comercial (que é o que o
 * texto diz). Depois o mostrador fica parado, com o ponteiro na volta
 * completa.
 *
 * Texto: titulo, subtitulo, paragrafos e fecho do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const MARCAS = Array.from({ length: 24 }, (_, k) => {
  const a = ((k * 15 - 90) * Math.PI) / 180;
  const r0 = k % 6 === 0 ? 118 : 126;
  return { k, d: `M${(160 + Math.cos(a) * r0).toFixed(1)} ${(160 + Math.sin(a) * r0).toFixed(1)} L${(160 + Math.cos(a) * 140).toFixed(1)} ${(160 + Math.sin(a) * 140).toFixed(1)}` };
});
---

<section class="ap-secao monitoramento" data-theme="light" data-cena>
  <div class="container grade">
    <div>
      <div class="ap-cabeca">
        {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
        {bloco.subtitulo && <p class="ap-sub ap-entra" style="--i:1">{bloco.subtitulo}</p>}
        {bloco.paragrafos?.map((p, i) => <p class="ap-p ap-entra" style={`--i:${i + 2}`}>{p}</p>)}
      </div>
      {bloco.fecho?.map((p) => <p class="ap-fecho ap-entra" style="--i:5">{p}</p>)}
    </div>

    <div class="mostrador" aria-hidden="true">
      <svg viewBox="0 0 320 320">
        <circle class="aro" cx="160" cy="160" r="150" />
        {MARCAS.map((m) => <path class="marca" d={m.d} style={`--k:${m.k}`} />)}
        <g class="ponteiro"><path d="M160 160 L160 44" /></g>
        <circle class="eixo" cx="160" cy="160" r="6" />
      </svg>
      <span class="olho"><MenuIcon nome="monitor" /></span>
    </div>
  </div>
</section>

<style>
  .grade { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-12); align-items: center; }
  .mostrador { position: relative; width: 100%; max-width: 360px; aspect-ratio: 1; margin-inline: auto; }
  .mostrador svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; }
  .aro { fill: var(--navy-950); stroke: rgba(11, 23, 48, 0.15); stroke-width: 8; }
  .marca { stroke: rgba(230, 238, 248, 0.18); stroke-width: 3; stroke-linecap: round; transition: stroke 0.2s ease calc(0.5s + var(--k) * 0.1s); }
  .em-cena .marca { stroke: var(--red-500); }
  .ponteiro { transform-origin: 160px 160px; transform: rotate(0deg); }
  .ponteiro path { stroke: var(--white); stroke-width: 3; stroke-linecap: round; }
  .em-cena .ponteiro { transform: rotate(360deg); transition: transform 2.4s linear 0.5s; }
  .eixo { fill: var(--red-500); }
  .olho { position: absolute; left: 50%; top: 66%; display: grid; place-items: center; width: 44px; height: 44px; margin-left: -22px; border-radius: 12px; background: var(--navy-800); color: var(--white); }
  .olho :global(.menu-icon) { width: 22px; height: 22px; }

  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
    .mostrador { max-width: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marca { transition: none; }
    .em-cena .ponteiro { transition: none; }
  }
</style>
