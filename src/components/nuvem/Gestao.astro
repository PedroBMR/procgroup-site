---
/**
 * "Gestão completa do ambiente": os oito papéis da Proc (dimensionamento até
 * evolução) como um trilho, na ordem da página. Cada card tem ícone próprio e
 * um ponto no trilho; o trilho de cada linha se acende da esquerda para a
 * direita quando a seção aparece, card por card.
 *
 * Texto: titulo, subtitulo, paragrafos e cards do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import type { Bloco } from "../../data/preview/blocos";
import type { NomeIconeMenu } from "../../data/iconesMenu";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const iconeDe = (t: string): NomeIconeMenu =>
  /dimension/i.test(t) ? "modulos"
  : /implant/i.test(t) ? "camadas"
  : /gerenc/i.test(t) ? "engrenagem"
  : /monitor/i.test(t) ? "monitor"
  : /segur/i.test(t) ? "cadeado"
  : /backup/i.test(t) ? "nuvemBackup"
  : /suporte/i.test(t) ? "suporte"
  : "crescimento";
---

<section class="ap-secao escura gestao" data-cena>
  <div class="container">
    <div class="ap-cabeca">
      {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
      {bloco.subtitulo && <p class="ap-sub ap-entra" style="--i:1">{bloco.subtitulo}</p>}
      {bloco.paragrafos?.map((p, i) => <p class="ap-p ap-entra" style={`--i:${i + 2}`}>{p}</p>)}
    </div>

    <ol class="trilho">
      {bloco.cards?.map((c, k) => (
        <li class="papel" style={`--k:${k}`}>
          <span class="marco" aria-hidden="true"></span>
          <span class="p-icone" aria-hidden="true"><MenuIcon nome={iconeDe(c.titulo)} /></span>
          <h3>{c.titulo}</h3>
          {c.paragrafos?.map((p) => <p>{p}</p>)}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .gestao h2 { color: var(--white); }
  .trilho { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-10, 2.5rem) var(--space-4); }
  .papel { position: relative; padding: var(--space-8) var(--space-5) var(--space-5); border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.08); transition: border-color 0.3s ease, transform 0.3s var(--ease-out); }
  .papel:hover { border-color: rgba(255, 74, 84, 0.45); transform: translateY(-4px); }

  /* Trilho: o marco no topo do card e a ligação até o próximo da mesma linha. */
  .marco { position: absolute; top: -7px; left: var(--space-5); width: 14px; height: 14px; border-radius: 50%; background: var(--navy-950); border: 2px solid rgba(230, 238, 248, 0.25); transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.4s ease; transition-delay: calc(0.4s + var(--k) * 0.22s); }
  .em-cena .marco { border-color: var(--red-500); background: var(--red-500); box-shadow: 0 0 10px rgba(226, 8, 29, 0.6); animation: gs-pulso 4.8s ease-in-out calc(2.4s + var(--k) * 0.6s) infinite; }
  /* Um marco de cada vez ganha brilho: o trabalho passando de papel em papel. */
  @keyframes gs-pulso { 0%, 20%, 100% { box-shadow: 0 0 10px rgba(226, 8, 29, 0.6); } 8% { box-shadow: 0 0 0 7px rgba(226, 8, 29, 0.2), 0 0 18px rgba(226, 8, 29, 0.9); } }
  .papel:not(:nth-child(4n))::after {
    content: "";
    position: absolute;
    top: -1px;
    left: calc(var(--space-5) + 14px);
    width: calc(100% - 14px + var(--space-4));
    height: 2px;
    background: var(--red-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s linear calc(0.45s + var(--k) * 0.22s);
  }
  .em-cena .papel:not(:nth-child(4n))::after { transform: scaleX(1); }

  .p-icone { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--navy-900); border: 1px solid rgba(230, 238, 248, 0.18); color: #e6eef8; }
  .p-icone :global(.menu-icon) { width: 22px; height: 22px; }
  .papel h3 { margin-top: var(--space-4); font-size: var(--fs-base); color: var(--white); }
  .papel p { margin-top: var(--space-2); font-size: var(--fs-sm); line-height: 1.55; color: var(--color-text-muted); }

  @media (max-width: 1000px) {
    .trilho { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .papel:not(:nth-child(4n))::after { display: none; }
    .papel:nth-child(odd)::after { display: block; width: calc(100% - 14px + var(--space-4)); }
  }
  @media (max-width: 560px) {
    .trilho { grid-template-columns: 1fr; }
    .papel::after, .papel:nth-child(odd)::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marco, .papel::after { transition: none; }
    .em-cena .marco { animation: none; }
    .papel:hover { transform: none; }
  }
</style>
