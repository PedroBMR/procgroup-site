---
/**
 * As duas opções de datacenter (Proc Cloud e Oracle Cloud Infrastructure),
 * cada uma com um diagrama da própria arquitetura, para a diferença ser
 * visível sem ler o texto:
 *
 *   Proc Cloud  uma estrutura só, cercada (estrutura própria, controle sobre a
 *               infraestrutura), com a equipe Proc acompanhando e a empresa
 *               ligada a ela
 *   OCI         a infraestrutura global da Oracle (um globo com regiões
 *               ligadas) e, por cima, a camada de gestão técnica da Proc
 *
 * Os dois cards têm o mesmo peso: nenhum é destacado. Cada um leva o id da
 * opção (#proc-cloud, #oci), que é para onde o mega-menu aponta.
 *
 * Texto: os dois cards do bloco (n, titulo, paragrafos, fecho), sem
 * alteração. Diagramas sem palavra nenhuma.
 */
import { ICONES_MENU, type NomeIconeMenu } from "../../data/iconesMenu";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const cards = bloco.cards ?? [];

const ic = (nome: NomeIconeMenu, x: number, y: number, s = 2) =>
  `<g transform="translate(${x} ${y}) scale(${s})">${ICONES_MENU[nome]}</g>`;

// Regiões da OCI em volta do globo (posições do desenho, não geográficas).
const REGIOES = [[78, 52], [262, 48], [292, 124], [58, 134], [176, 170]];

const DIAGRAMAS: Record<string, string> = {
  "proc-cloud":
    '<rect class="tr cerca" x="96" y="26" width="168" height="112" rx="14" pathLength="1"/>' +
    ic("servidores", 112, 58, 1.7) + ic("servidores", 160, 58, 1.7) + ic("servidores", 208, 58, 1.7) +
    '<path class="tr fraco" pathLength="1" d="M32 82 H96 M264 82 H300"/>' +
    ic("predio", 6, 66, 1.4) +
    '<circle class="no-proc" cx="300" cy="82" r="18"/>' + ic("pessoas", 288, 70, 1) +
    '<path class="tr destaque" pathLength="1" d="M120 146 H240"/>' +
    // Vida contínua: dados entre a empresa, a estrutura e a equipe Proc, e
    // os LEDs dos racks piscando fora de fase.
    '<path class="fluxo" style="--k:0" pathLength="1" d="M32 82 H96"/>' +
    '<path class="fluxo" style="--k:1" pathLength="1" d="M300 82 H264"/>' +
    [112, 160, 208].flatMap((x, r) => [[x + 11.9, 69.9], [x + 11.9, 86.9]].map(([cx, cy], j) =>
      `<circle class="led" style="--k:${r * 2 + j}" cx="${cx}" cy="${cy}" r="1.8"/>`)).join(""),
  oci:
    REGIOES.map(([x, y]) => `<path class="tr fraco" pathLength="1" d="M180 98 L${x} ${y}"/>`).join("") +
    ic("globo", 146, 64, 2.8) +
    REGIOES.map(([x, y], k) => `<circle class="regiao" style="--k:${k}" cx="${x}" cy="${y}" r="6"/>`).join("") +
    '<rect class="tr destaque camada" x="40" y="12" width="280" height="18" rx="9" pathLength="1"/>' +
    '<path class="tr destaque" pathLength="1" d="M180 30 V60"/>' +
    // Vida contínua: dados entre o globo e as regiões, e a gestão da Proc
    // descendo para a infraestrutura.
    REGIOES.map(([x, y], k) => `<path class="fluxo" style="--k:${k}" pathLength="1" d="M180 98 L${x} ${y}"/>`).join("") +
    '<path class="fluxo" style="--k:5" pathLength="1" d="M180 30 V60"/>',
};
---

<section class="ap-secao escura datacenters" data-cena>
  <div class="container grade">
    {cards.map((c, i) => (
      <article class="opcao ap-entra" id={c.id} style={`--i:${i * 2}`}>
        <svg class="diagrama" viewBox="0 0 340 180" aria-hidden="true" set:html={DIAGRAMAS[c.id ?? ""] ?? ""} />
        <div class="corpo">
          {c.n && <p class="n" aria-hidden="true">{c.n}</p>}
          <h3>{c.titulo}</h3>
          {c.paragrafos?.map((p) => <p class="p">{p}</p>)}
          {c.fecho?.map((p) => <p class="fecho">{p}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .grade { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); align-items: stretch; }
  .opcao {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.1);
    scroll-margin-top: calc(var(--topbar-h) + var(--header-h) + var(--space-6));
  }
  .em-cena .opcao { transition: opacity 0.7s var(--ease-out) calc(var(--i) * 0.12s), transform 0.35s var(--ease-out), border-color 0.3s ease, box-shadow 0.35s ease; }
  .em-cena .opcao:hover { transform: translateY(-6px); border-color: rgba(255, 74, 84, 0.45); box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.9); }

  .diagrama {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 340 / 180;
    padding: var(--space-4);
    background: radial-gradient(70% 90% at 50% 30%, rgba(37, 56, 102, 0.55), transparent 70%), rgba(6, 10, 20, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    fill: none;
    stroke: #e6eef8;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .diagrama :global(.tr) { stroke-width: 1.4; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s cubic-bezier(0.33, 1, 0.68, 1) 0.5s; }
  .em-cena .diagrama :global(.tr) { stroke-dashoffset: 0; }
  .diagrama :global(.tr.fraco) { stroke: rgba(230, 238, 248, 0.3); }
  .diagrama :global(.tr.cerca) { stroke: rgba(230, 238, 248, 0.55); }
  .diagrama :global(.tr.destaque) { stroke: #ff4a54; stroke-width: 2; filter: drop-shadow(0 0 4px rgba(255, 74, 84, 0.5)); transition-delay: 1.1s; }
  .diagrama :global(.no-proc) { fill: var(--navy-900); stroke: #ff4a54; stroke-width: 1.6; }
  .diagrama :global(.regiao) { fill: #60a5fa; stroke: none; opacity: 0; transition: opacity 0.4s ease 1.3s; }
  .em-cena .diagrama :global(.regiao) { opacity: 1; animation: dc-regiao 2.8s ease-in-out calc(2s + var(--k, 0) * 0.3s) infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes dc-regiao { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.35); } }
  .diagrama :global(.fluxo) { stroke: #ff4a54; stroke-width: 2.6; stroke-dasharray: 0.08 0.92; stroke-dashoffset: 0.08; opacity: 0; filter: drop-shadow(0 0 3px rgba(255, 74, 84, 0.7)); }
  .em-cena .diagrama :global(.fluxo) { opacity: 1; animation: dc-fluxo 2.2s linear calc(1.8s + var(--k) * 0.35s) infinite; }
  @keyframes dc-fluxo { to { stroke-dashoffset: -0.92; } }
  .diagrama :global(.led) { fill: #60a5fa; stroke: none; opacity: 0.25; }
  .em-cena .diagrama :global(.led) { animation: dc-led 1.6s steps(1) calc(1.6s + var(--k) * 0.27s) infinite; }
  @keyframes dc-led { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }

  .corpo { padding: var(--space-8); }
  .n { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-2xl); line-height: 1; color: var(--red-400); }
  .opcao h3 { margin-top: var(--space-2); font-size: var(--fs-2xl); color: var(--white); }
  .p { margin-top: var(--space-4); font-size: var(--fs-sm); line-height: 1.65; color: var(--color-text-muted); }
  .fecho { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid rgba(255, 255, 255, 0.08); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); text-transform: uppercase; line-height: var(--lh-snug); color: var(--white); }

  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .em-cena .opcao:hover { transform: none; }
    .diagrama :global(.tr) { transition: none; stroke-dasharray: none; stroke-dashoffset: 0; }
    .em-cena .diagrama :global(.fluxo), .em-cena .diagrama :global(.led), .em-cena .diagrama :global(.regiao) { animation: none; }
    .diagrama :global(.fluxo) { display: none; }
  }
</style>
