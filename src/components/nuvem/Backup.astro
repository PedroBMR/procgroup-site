---
/**
 * "Backup e proteção dos seus dados": o percurso dos dados em três tempos,
 * acima do texto. O ambiente faz a cópia protegida (seta cheia para a direita)
 * e, em caso de falha, exclusão ou incidente, a restauração volta ao ambiente
 * (seta tracejada para a esquerda), que é o que o terceiro parágrafo diz.
 *
 * Texto: titulo, paragrafos e fecho do bloco, sem alteração.
 */
import { ICONES_MENU, type NomeIconeMenu } from "../../data/iconesMenu";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const ic = (nome: NomeIconeMenu, x: number, y: number, s = 3) =>
  `<g transform="translate(${x} ${y}) scale(${s})">${ICONES_MENU[nome]}</g>`;
const DESENHO =
  '<rect class="caixa" x="40" y="30" width="120" height="120" rx="22"/>' + ic("servidores", 64, 54, 3) +
  '<rect class="caixa" x="440" y="30" width="120" height="120" rx="22"/>' + ic("nuvemBackup", 464, 54, 3) +
  '<path class="ida" pathLength="1" d="M176 74 H424 M410 62 L424 74 L410 86"/>' +
  '<path class="volta" pathLength="1" d="M424 112 H176 M190 100 L176 112 L190 124"/>' +
  '<path class="ap-fluxo" style="--dur:2.4s; --atraso:2.8s" pathLength="1" d="M176 74 H424"/>' +
  '<path class="ap-fluxo volta-fluxo" style="--dur:2.4s; --atraso:4s" pathLength="1" d="M424 112 H176"/>' +
  '<circle class="pacote" r="5"><animateMotion dur="2.4s" begin="indefinite" fill="freeze" path="M176 74 H424" data-pacote/></circle>';
---

<section class="ap-secao backup" data-theme="light" data-cena>
  <div class="container">
    <svg class="percurso" viewBox="0 0 600 180" aria-hidden="true" set:html={DESENHO} data-backup />
    <div class="texto">
      {bloco.titulo && <h2 class="ap-entra">{bloco.titulo}</h2>}
      <div class="colunas">
        {bloco.paragrafos?.map((p, i) => <p class="ap-p ap-entra" style={`--i:${i + 1}`}>{p}</p>)}
      </div>
      {bloco.fecho?.map((p) => <p class="ap-fecho ap-entra" style="--i:5">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .backup { background: linear-gradient(180deg, var(--color-bg-alt), var(--color-bg)); }
  .percurso { display: block; width: 100%; max-width: 640px; height: auto; margin: 0 auto var(--space-12); fill: none; overflow: visible; }
  .percurso :global(.caixa) { fill: var(--navy-900); stroke: none; }
  .percurso :global(g) { stroke: var(--white); stroke-width: 0.6; stroke-linecap: round; stroke-linejoin: round; }
  .percurso :global(.ida) { stroke: var(--red-600); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s ease 0.4s; }
  .percurso :global(.volta) { stroke: var(--navy-600); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 0.02 0.02; opacity: 0; transition: opacity 0.6s ease 2.6s; }
  .percurso :global(.pacote) { fill: var(--red-600); opacity: 0; }
  .percurso :global(.volta-fluxo) { stroke: var(--navy-600); filter: none; }
  .em-cena .percurso :global(.ida) { stroke-dashoffset: 0; }
  .em-cena .percurso :global(.volta) { opacity: 1; }

  .texto { text-align: center; }
  .texto h2 { max-width: 22ch; margin-inline: auto; font-size: var(--fs-3xl); }
  .colunas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-6); text-align: left; }
  .colunas .ap-p { margin-top: 0; }

  @media (max-width: 900px) {
    .colunas { grid-template-columns: 1fr; gap: 0; }
    .colunas .ap-p { margin-top: var(--space-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .percurso :global(.ida), .percurso :global(.volta) { transition: none; stroke-dashoffset: 0; opacity: 1; }
  }
</style>

<script>
  import { semMovimento } from "../../scripts/aprocCenas";
  // Um pacote faz a ida uma vez, junto com a seta.
  document.querySelectorAll<SVGSVGElement>("[data-backup]").forEach((svg) => {
    const secao = svg.closest<HTMLElement>("[data-cena]");
    const anim = svg.querySelector<SVGAnimateMotionElement>("[data-pacote]");
    const pacote = anim?.parentElement as SVGElement | null | undefined;
    const ir = () => {
      if (semMovimento || !anim || !pacote) return;
      window.setTimeout(() => {
        pacote.style.opacity = "1";
        anim.beginElement();
        window.setTimeout(() => (pacote.style.opacity = "0"), 2400);
      }, 400);
    };
    if (secao?.classList.contains("em-cena")) ir();
    else secao?.addEventListener("cena", ir, { once: true });
  });
</script>
