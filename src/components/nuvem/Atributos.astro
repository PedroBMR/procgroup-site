---
/**
 * Primeiro bloco depois do herói: os três parágrafos sobre o que é hospedar
 * em nuvem com a Proc e, abaixo, uma linha que atravessa a seção passando por
 * sete atributos (segurança, disponibilidade, estabilidade, performance,
 * escalabilidade, suporte, gerenciamento), todos ligados a uma nuvem no alto:
 * não são benefícios soltos, são partes do mesmo serviço.
 *
 * Só ícones, sem rótulo: os nomes dos atributos não estão no texto do bloco,
 * e o briefing proíbe acrescentá-los.
 *
 * Entrada: a nuvem aparece, as hastes descem até a linha, um pulso percorre a
 * linha da esquerda para a direita uma vez e acende cada atributo quando passa
 * por ele. Depois, o pulso volta a passar de tempos em tempos e pacotes de
 * dados descem da nuvem para cada atributo (pedido do Pedro, 2026-10-21).
 *
 * Texto: paragrafos do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import type { Bloco } from "../../data/preview/blocos";
import type { NomeIconeMenu } from "../../data/iconesMenu";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const ATRIBUTOS: NomeIconeMenu[] = ["escudo", "globo", "nivel", "medidor", "crescimento", "suporte", "engrenagem"];
const W = 1000;
const Y = 200;
const xs = ATRIBUTOS.map((_, k) => 70 + k * (860 / (ATRIBUTOS.length - 1)));
// Linha ondulada que passa exatamente pelos nós (ondula entre eles).
const onda = xs.slice(1).reduce((d, x, k) => {
  const x0 = xs[k];
  const meio = (x0 + x) / 2;
  return d + ` Q${meio} ${k % 2 ? Y + 26 : Y - 26} ${x} ${Y}`;
}, `M20 ${Y} L${xs[0]} ${Y}`) + ` L980 ${Y}`;
---

<section class="ap-secao atributos" data-theme="light" data-cena>
  <div class="container">
    <div class="textos">
      {bloco.paragrafos?.map((p, i) => <p class:list={["ap-entra", { primeiro: i === 0 }]} style={`--i:${i}`}>{p}</p>)}
    </div>

    <div class="estrutura" aria-hidden="true">
      <svg viewBox={`0 0 ${W} 260`} preserveAspectRatio="xMidYMid meet">
        {xs.map((x, k) => (
          <path class="ap-traco haste" d={`M500 70 C500 130 ${x} 120 ${x} ${Y}`} pathLength="1" style={`--o:${(0.3 + Math.abs(k - 3) * 0.12).toFixed(2)}`} />
        ))}
        {xs.map((x, k) => (
          <path class="fluxo" d={`M500 70 C500 130 ${x} 120 ${x} ${Y}`} pathLength="1" style={`--k:${k}`} />
        ))}
        <path class="ap-traco onda" d={onda} pathLength="1" style="--o:0.2" />
        <path class="pulso" d={onda} pathLength="1" />
      </svg>
      <span class="nuvem-no"><MenuIcon nome="nuvem" /></span>
      {ATRIBUTOS.map((icone, k) => (
        <span class="atributo" style={`--x:${((xs[k] / W) * 100).toFixed(2)}%; --k:${k}`}><MenuIcon nome={icone} /></span>
      ))}
    </div>
  </div>
</section>

<style>
  .textos { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: var(--space-8); align-items: start; }
  .textos p { font-size: var(--fs-sm); line-height: 1.7; color: var(--color-text-muted); }
  .textos .primeiro { font-size: var(--fs-lg); line-height: 1.5; font-weight: 600; color: var(--color-text); }

  .estrutura { position: relative; margin-top: var(--space-12); aspect-ratio: 1000 / 260; }
  .estrutura svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; overflow: visible; }
  .haste { stroke: rgba(11, 23, 48, 0.14); stroke-width: 1.2; }
  .onda { stroke: rgba(11, 23, 48, 0.25); stroke-width: 2; }
  .pulso { stroke: var(--red-500); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 0.06 2; stroke-dashoffset: 0.06; opacity: 0; filter: drop-shadow(0 0 5px rgba(226, 8, 29, 0.6)); }
  /* Depois da entrada, o pulso volta a percorrer a linha de tempos em tempos,
     e dados descem da nuvem para cada atributo, devagar e fora de fase. */
  .em-cena .pulso { animation: nv-pulso 5s linear 1.2s infinite; }
  @keyframes nv-pulso { 0% { opacity: 1; stroke-dashoffset: 0.06; } 55% { opacity: 1; stroke-dashoffset: -1; } 56%, 100% { opacity: 0; stroke-dashoffset: -1; } }
  .fluxo { stroke: var(--red-500); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 0.05 0.95; stroke-dashoffset: 0.05; opacity: 0; }
  .em-cena .fluxo { opacity: 0.8; animation: nv-desce 3.2s linear calc(2.4s + var(--k) * 0.45s) infinite; }
  @keyframes nv-desce { to { stroke-dashoffset: -0.95; } }

  .nuvem-no {
    position: absolute;
    left: 50%;
    top: 0;
    display: grid;
    place-items: center;
    width: 96px;
    height: 72px;
    border-radius: 20px;
    background: var(--navy-900);
    color: var(--white);
    box-shadow: 0 0 0 8px rgba(11, 23, 48, 0.05), 0 18px 34px -16px rgba(11, 23, 48, 0.6);
    transform: translate(-50%, -10%) scale(0.85);
    opacity: 0;
    transition: opacity 0.5s ease 0.1s, transform 0.6s var(--ease-out) 0.1s;
  }
  .nuvem-no :global(.menu-icon) { width: 40px; height: 40px; }
  .em-cena .nuvem-no { opacity: 1; transform: translate(-50%, -10%); }

  .atributo {
    position: absolute;
    left: var(--x);
    top: calc(200 / 260 * 100%);
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    color: var(--navy-700);
    transform: translate(-50%, -50%);
    opacity: 0.35;
    transition: opacity 0.4s ease, border-color 0.4s ease, color 0.4s ease, box-shadow 0.5s ease;
    transition-delay: calc(1.2s + var(--k) * 0.4s);
  }
  .atributo :global(.menu-icon) { width: 26px; height: 26px; }
  .em-cena .atributo { opacity: 1; border-color: var(--red-600); color: var(--red-600); box-shadow: 0 0 0 6px rgba(226, 8, 29, 0.08), 0 12px 24px -14px rgba(11, 23, 48, 0.4); }

  @media (max-width: 900px) {
    .textos { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  /* Celular: a linha horizontal não cabe com sete ícones legíveis. Vira uma
     grade com a nuvem no alto, ligada a todos por um traço. */
  @media (max-width: 640px) {
    .estrutura { aspect-ratio: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); padding-top: 100px; }
    .estrutura svg { display: none; }
    .nuvem-no { left: 50%; }
    .estrutura::before { content: ""; position: absolute; left: 10%; right: 10%; top: 86px; height: 2px; background: rgba(11, 23, 48, 0.15); }
    .atributo { position: relative; left: auto; top: auto; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nuvem-no, .atributo { transition: none; }
    .em-cena .pulso, .em-cena .fluxo { animation: none; opacity: 0; }
  }
</style>
