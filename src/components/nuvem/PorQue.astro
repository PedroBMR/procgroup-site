---
/**
 * "Por que hospedar com a Proc?": os oito motivos num mosaico assimétrico em
 * vez de uma grade de cards iguais. Os dois primeiros (experiência e estrutura
 * própria) ocupam mais espaço; cada motivo tem ícone próprio.
 *
 * Texto: titulo e cards do bloco, sem alteração.
 */
import MenuIcon from "../MenuIcon.astro";
import type { Bloco } from "../../data/preview/blocos";
import type { NomeIconeMenu } from "../../data/iconesMenu";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const iconeDe = (t: string): NomeIconeMenu =>
  /experi/i.test(t) ? "relogio"
  : /estrutura/i.test(t) ? "servidores"
  : /oracle/i.test(t) ? "globo"
  : /equipe/i.test(t) ? "pessoas"
  : /monitor/i.test(t) ? "monitor"
  : /suporte/i.test(t) ? "suporte"
  : /escala/i.test(t) ? "crescimento"
  : "modulos";
---

<section class="ap-secao porque" data-theme="light" data-cena>
  <div class="container">
    {bloco.titulo && <h2 class="titulo ap-entra">{bloco.titulo}</h2>}
    <ul class="mosaico">
      {bloco.cards?.map((c, k) => (
        <li class:list={["motivo ap-entra", { largo: k < 2 }]} style={`--i:${k + 1}`}>
          <span class="m-icone" aria-hidden="true"><MenuIcon nome={iconeDe(c.titulo)} /></span>
          <div>
            <h3>{c.titulo}</h3>
            {c.paragrafos?.map((p) => <p>{p}</p>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .titulo { font-size: var(--fs-3xl); max-width: 18ch; }
  .mosaico { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .motivo {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .em-cena .motivo { transition: opacity 0.7s var(--ease-out) calc(var(--i) * 0.08s), transform 0.3s var(--ease-out), border-color 0.3s ease, box-shadow 0.3s ease; }
  .em-cena .motivo:hover { transform: translateY(-4px); border-color: rgba(184, 8, 26, 0.4); box-shadow: 0 20px 40px -28px rgba(11, 23, 48, 0.4); }
  .largo { grid-column: span 2; flex-direction: row; align-items: flex-start; gap: var(--space-5); background: var(--navy-950); border-color: transparent; }
  .motivo.largo h3 { color: var(--white); margin-top: 0; }
  .motivo.largo p { color: rgba(230, 238, 248, 0.82); }
  .m-icone { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 14px; background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--red-600); }
  .largo .m-icone { width: 64px; height: 64px; background: var(--navy-800); border-color: rgba(255, 74, 84, 0.5); color: var(--red-400); }
  .m-icone :global(.menu-icon) { width: 24px; height: 24px; }
  .largo .m-icone :global(.menu-icon) { width: 30px; height: 30px; }
  .motivo h3 { margin-top: var(--space-4); font-size: var(--fs-base); }
  .largo h3 { font-size: var(--fs-xl); }
  .motivo p { margin-top: var(--space-2); font-size: var(--fs-sm); line-height: 1.55; color: var(--color-text-muted); }

  @media (max-width: 1000px) {
    .mosaico { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .mosaico { grid-template-columns: 1fr; }
    .largo { grid-column: auto; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .em-cena .motivo:hover { transform: none; }
  }
</style>
