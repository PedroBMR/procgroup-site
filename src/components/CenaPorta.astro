---
/**
 * Superfície de uma cena do seletor de público. Só o quadro e o fallback —
 * o desenho e o ciclo de vida vivem em src/scripts/cenas.ts, que monta
 * qualquer [data-cena] da página.
 *
 *   fundo     o painel inteiro (grade em perspectiva, profundidade, paralaxe)
 *   governo   cidade de cima; caixa de detecção travando num veículo
 *   empresas  perímetro em corte; varredura descendo e nós liberando
 *
 * Decorativo: aria-hidden. Sem JS, sem canvas ou com movimento reduzido, o que
 * fica é o gradiente do CSS abaixo — a cena nunca vira um buraco preto.
 */
interface Props {
  /** "fundo" | "governo" | "empresas" */
  cena: string;
}
const { cena } = Astro.props;
const ehFundo = cena === "fundo";
---

<span class:list={["cena", { "cena--fundo": ehFundo }]} aria-hidden="true" data-cena={cena}>
  <canvas></canvas>
  {!ehFundo && <span class="cena-veu"></span>}
</span>

<style>
  .cena {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    /* Base estática: o que aparece sem JS, sem canvas ou com movimento
       reduzido. */
    background:
      radial-gradient(120% 90% at 70% 8%, rgba(255, 74, 84, 0.09), transparent 58%),
      linear-gradient(165deg, var(--navy-800), var(--navy-950) 78%);
  }
  .cena canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* O fundo do painel não leva base própria: o painel já tem a dele, e uma
     segunda camada opaca apagaria o halo que vem de trás. */
  .cena--fundo { background: none; }

  /* Véu: o texto do cartão vem por cima e precisa de contraste. A cena vive no
     topo e à direita; o canto inferior esquerdo é onde o texto respira. */
  .cena-veu {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(15deg, var(--navy-950) 14%, rgba(11, 23, 48, 0.72) 46%, transparent 82%),
      radial-gradient(140% 120% at 50% 50%, transparent 52%, rgba(6, 10, 20, 0.55));
  }
</style>

<script>
  import { montarCenas } from "../scripts/cenas";
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", montarCenas);
  else montarCenas();
</script>
