---
import { getMainNav } from "../data/nav";
import { MAPS_URL } from "../data/contact";
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations, localizePath, logicalPath } from "../i18n/utils";
import { publicoDaUrl, publicoDefs, publicoCopy, caminho } from "../data/audiencia";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).footer;
const common = useTranslations(lang).common;
const publico = publicoDaUrl(logicalPath(Astro.url));
const mainNav = getMainNav(lang, publico);
// No lado governo o item "solucoes" e link direto (uma unidade so); a coluna
// do rodape usa entao o proprio item como linha unica.
const solucoesItem = mainNav.find((i) => i.id === "solucoes");
const solucoes = solucoesItem?.children ?? (solucoesItem ? [{ label: solucoesItem.label, href: solucoesItem.href }] : []);
// Escotilha: o UNICO link entre os dois lados. Quem clicou na porta errada sai
// por aqui em vez de abandonar o site. Fora dos lados, nao existe.
const escotilha = publico
  ? { texto: publicoCopy[lang][publico].escotilha, destino: publicoCopy[lang][publicoDefs[publico].oposto].nome, href: localizePath(caminho(publicoDefs[publico].oposto), lang) }
  : null;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <Logo variant="white" height={32} />
      <p>{t.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label={common.navFooter}>
      {/* h2, não h3: em páginas sem h2 no conteúdo (404, trabalhe-conosco) as
          colunas vinham logo após o h1 e criavam salto h1→h3 no outline. */}
      {mainNav.length > 0 && (
      <div>
        <h2>{t.navHeading}</h2>
        <ul>
          {mainNav.filter((i) => i.id !== "home").map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      )}
      {solucoes.length > 0 && (
      <div>
        <h2>{t.solucoesHeading}</h2>
        <ul>
          {solucoes.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </div>
      )}
      <div>
        <h2>{t.contatoHeading}</h2>
        <ul>
          <li><a href="mailto:comercial@procgroup.com.br">comercial@procgroup.com.br</a></li>
          <li><a href="tel:+554632243532">+55 46 3224-3532</a></li>
          <li>{t.address} · <a href={MAPS_URL} target="_blank" rel="noopener noreferrer">{t.mapLink}</a></li>
          {publico && <li><a href={localizePath(`${publicoDefs[publico].base}/contato`, lang)}>{t.demoLink}</a></li>}
          <li><a href={localizePath("/suporte", lang)}>{t.suporteLink}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  {escotilha && (
    <div class="container footer-escotilha">
      <p>{escotilha.texto} <a href={escotilha.href}>{escotilha.destino} →</a></p>
    </div>
  )}

  <div class="container footer-bottom">
    <p>&copy; {year} Proc Group. {t.rights}</p>
    <div class="footer-legal">
      <a href={localizePath("/politica-de-privacidade", lang)}>{t.privacy}</a>
      <span class="legal-note">{t.lgpdNote}</span>
      <span class="legal-note">{t.staticNote}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: rgba(255,255,255,0.75);
    padding-top: var(--space-24);
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .footer-brand p { margin-top: var(--space-6); max-width: 320px; font-size: var(--fs-sm); line-height: var(--lh-normal); }

  .footer-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  /* Neutraliza o estilo de h2 do base.css (display/uppercase) — o visual
     destas colunas sempre foi o de h3 (sans, sem uppercase). */
  .footer-nav h2 { color: var(--white); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 700; letter-spacing: -0.01em; text-transform: none; margin-bottom: var(--space-4); }
  .footer-nav li { margin-bottom: var(--space-2); }
  .footer-nav a { font-size: var(--fs-sm); transition: color var(--dur-fast) ease; }
  .footer-nav a:hover { color: var(--white); }

  /* Escotilha para o outro publico: discreta de proposito — e rota de fuga
     para quem errou a porta, nao navegacao. Unico link entre os dois lados. */
  .footer-escotilha { padding-top: var(--space-6); font-size: var(--fs-xs); color: rgba(255,255,255,0.5); }
  .footer-escotilha a { color: rgba(255,255,255,0.75); text-decoration: underline; text-underline-offset: 2px; }
  .footer-escotilha a:hover { color: var(--white); }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-block: var(--space-6);
    font-size: var(--fs-xs);
  }
  .footer-legal { display: flex; align-items: center; gap: var(--space-4); }
  .legal-note { color: rgba(255,255,255,0.5); }

  @media (max-width: 780px) {
    .footer-top { grid-template-columns: 1fr; gap: var(--space-12); }
    .footer-nav { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .footer-bottom { flex-direction: column; gap: var(--space-2); text-align: center; }
    .footer-legal { flex-direction: column; gap: var(--space-1); }
  }
</style>
