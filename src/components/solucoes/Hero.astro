---
/**
 * Herói de Soluções: eyebrow, título e lead à esquerda; à direita, o
 * triângulo das três áreas (Trio), que se monta quando a página abre.
 * Mesmo desenho dos heróis de Infraestrutura de TI e Hospedagem em Nuvem.
 *
 * Texto: vem da página, sem alteração.
 */
import Trio from "./Trio.astro";

interface Props {
  eyebrow: string;
  titulo: string;
  lead: string;
}
const { eyebrow, titulo, lead } = Astro.props;
---

<section class="ap-secao escura hero" data-cena>
  <div class="container grade">
    <div class="texto">
      <p class="eyebrow ap-entra" style="--i:0">{eyebrow}</p>
      <h1 class="ap-entra" style="--i:1">{titulo}</h1>
      <p class="lead ap-entra" style="--i:2">{lead}</p>
    </div>
    <div class="ap-entra" style="--i:1"><Trio /></div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-16); min-height: min(76svh, 700px); display: flex; align-items: center; }
  .hero .container { width: 100%; }
  .grade { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-12); align-items: center; }
  .hero h1 { margin-top: var(--space-5); max-width: 20ch; font-size: clamp(2.1rem, 1.5rem + 2.2vw, 3.5rem); color: var(--white); text-wrap: balance; }
  .lead {
    margin-top: var(--space-8);
    max-width: 50ch;
    padding-left: var(--space-6);
    border-left: 2px solid var(--red-500);
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: rgba(230, 238, 248, 0.78);
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
    .hero { min-height: 0; }
  }
</style>
