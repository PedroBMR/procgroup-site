---
/**
 * Os três pilares (Sustentar, Proteger, Transformar) como uma mandala
 * corporativa: a marca da Proc no centro e os três pilares fechando um círculo
 * em volta dela. Geométrico, não ornamental.
 *
 * Sequência (uma vez, quando a seção aparece):
 *   0 s    a marca surge no centro
 *   2 s    Sustentar: o primeiro arco se desenha e encaixa
 *   3,2 s  Proteger
 *   4,4 s  Transformar fecha o círculo; os nós das junções acendem
 * Depois para. Nada gira continuamente.
 *
 * A marca é o PNG oficial (public/brand/logo-white.png) sobre um disco navy:
 * os SVG da pasta Branding estão quebrados, e o PNG é a fonte certa.
 *
 * Os nomes nos arcos são enfeite (aria-hidden): os pilares, com o texto de
 * cada um, estão nos cards logo abaixo, no HTML.
 *
 * Texto: paragrafos e cards do bloco, sem alteração.
 */
import { withBase } from "../../utils/url";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const pilares = bloco.cards ?? [];

const C = 240;
const R = 150;
const pt = (r: number, graus: number) => {
  const a = (graus * Math.PI) / 180;
  return [C + Math.cos(a) * r, C + Math.sin(a) * r].map((n) => n.toFixed(1)).join(" ");
};
// Arco de a0 a a1 graus (sentido horário). "invertido" desenha de a1 para a0,
// para o rótulo do arco de baixo não ficar de cabeça para baixo.
const arco = (r: number, a0: number, a1: number, invertido = false) =>
  invertido ? `M${pt(r, a1)} A${r} ${r} 0 0 0 ${pt(r, a0)}` : `M${pt(r, a0)} A${r} ${r} 0 0 1 ${pt(r, a1)}`;

const VAO = 4;
const SEGMENTOS = pilares.map((_, k) => {
  const a0 = -90 + k * 120 + VAO;
  const a1 = -90 + (k + 1) * 120 - VAO;
  const meio = (a0 + a1) / 2;
  return { a0, a1, meio, invertido: meio > 0 && meio < 180 };
});
const JUNCOES = [0, 1, 2].map((k) => -90 + k * 120);
const MARCAS = Array.from({ length: 36 }, (_, k) => k * 10);
---

<section class="ap-secao pilares" data-theme="light" data-cena>
  <div class="container">
    {bloco.paragrafos?.map((p) => <p class="intro ap-entra">{p}</p>)}

    <div class="mandala">
      <svg viewBox="0 0 480 480" aria-hidden="true">
        <defs>
          {SEGMENTOS.map((s, k) => <path id={`pilar-rotulo-${k}`} d={arco(R, s.a0, s.a1, s.invertido)} />)}
        </defs>

        <g class="estrutura">
          <circle class="ap-traco anel-externo" cx={C} cy={C} r="196" pathLength="1" style="--o:.1" />
          <circle class="ap-traco anel-interno" cx={C} cy={C} r="112" pathLength="1" style="--o:.25" />
          {MARCAS.map((a) => (
            <path class="marca" d={`M${pt(200, a)} L${pt(a % 30 === 0 ? 212 : 206, a)}`} />
          ))}
        </g>

        {SEGMENTOS.map((s, k) => (
          <g class={`pilar p${k}`} style={`--k:${k}`}>
            <path class="faixa" d={arco(R, s.a0, s.a1)} pathLength="1" />
            <path class="circuito" d={`M${pt(R + 26, s.a0 + 10)} L${pt(R + 38, s.a0 + 10)} M${pt(R + 26, s.a1 - 10)} L${pt(R + 38, s.a1 - 10)} M${pt(R - 26, s.meio)} L${pt(R - 38, s.meio)}`} />
            <circle class="circuito-no" cx={pt(R + 38, s.a0 + 10).split(" ")[0]} cy={pt(R + 38, s.a0 + 10).split(" ")[1]} r="3" />
            <circle class="circuito-no" cx={pt(R + 38, s.a1 - 10).split(" ")[0]} cy={pt(R + 38, s.a1 - 10).split(" ")[1]} r="3" />
            <text class="rotulo"><textPath href={`#pilar-rotulo-${k}`} startOffset="50%" text-anchor="middle">{pilares[k].titulo.toUpperCase()}</textPath></text>
          </g>
        ))}

        {JUNCOES.map((a, k) => {
          const [x, y] = pt(R, a).split(" ");
          return <circle class="juncao" cx={x} cy={y} r="7" style={`--k:${k}`} />;
        })}

        <circle class="disco" cx={C} cy={C} r="92" />
      </svg>
      <img class="marca-proc" src={withBase("/brand/logo-white.png")} alt="Proc Group" width="234" height="74" loading="lazy" decoding="async" />
    </div>

    <ul class="cards">
      {pilares.map((c, k) => (
        <li class={`card p${k}`} style={`--k:${k}`}>
          <h3>{c.titulo}</h3>
          {c.paragrafos?.map((p) => <p>{p}</p>)}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pilares {
    --t0: 2s;
    --passo: 1.2s;
    background:
      radial-gradient(60% 55% at 50% 45%, rgba(28, 45, 82, 0.07), transparent 70%),
      var(--color-bg);
  }
  .intro { max-width: 46ch; margin-inline: auto; text-align: center; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-2xl); line-height: var(--lh-snug); text-transform: uppercase; color: var(--color-text); }

  .mandala { position: relative; width: min(100%, 520px); margin: var(--space-12) auto 0; aspect-ratio: 1; }
  .mandala svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .anel-externo { fill: none; stroke: rgba(11, 23, 48, 0.12); stroke-width: 1; }
  .anel-interno { fill: none; stroke: rgba(11, 23, 48, 0.18); stroke-width: 1; stroke-dasharray: 2 6; }
  .em-cena .anel-interno { stroke-dasharray: 2 6; }
  .marca { stroke: rgba(11, 23, 48, 0.2); stroke-width: 1.2; opacity: 0; transition: opacity 1.2s ease 0.4s; }
  .em-cena .marca { opacity: 1; }

  /* Disco e marca: a primeira coisa a aparecer. */
  .disco { fill: var(--navy-950); stroke: rgba(226, 8, 29, 0.6); stroke-width: 2; transform-box: fill-box; transform-origin: center; opacity: 0; transform: scale(0.85); transition: opacity 0.8s ease 0.2s, transform 1s var(--ease-out) 0.2s; }
  .em-cena .disco { opacity: 1; transform: none; }
  .marca-proc { position: absolute; left: 50%; top: 50%; width: 27%; height: auto; transform: translate(-50%, -50%) scale(0.9); opacity: 0; transition: opacity 0.8s ease 0.5s, transform 1s var(--ease-out) 0.5s; }
  .em-cena .marca-proc { opacity: 1; transform: translate(-50%, -50%); }

  /* Cada pilar: o arco se desenha girando um pouco até encaixar. */
  .pilar { transform-origin: 240px 240px; transform: rotate(-14deg) scale(0.96); opacity: 0; transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--t0) + var(--k) * var(--passo)), opacity 0.5s ease calc(var(--t0) + var(--k) * var(--passo)); }
  .em-cena .pilar { transform: none; opacity: 1; }
  .faixa { fill: none; stroke-width: 40; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1s cubic-bezier(0.33, 1, 0.68, 1) calc(var(--t0) + var(--k) * var(--passo)); }
  .em-cena .faixa { stroke-dashoffset: 0; }
  .p0 .faixa { stroke: var(--navy-900); }
  .p1 .faixa { stroke: var(--navy-700); }
  .p2 .faixa { stroke: var(--red-600); }
  .circuito { stroke: rgba(11, 23, 48, 0.35); stroke-width: 1.4; stroke-linecap: round; }
  .circuito-no { fill: var(--color-bg); stroke: rgba(11, 23, 48, 0.45); stroke-width: 1.4; }
  .rotulo { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: 0.22em; fill: var(--white); opacity: 0; transition: opacity 0.5s ease calc(var(--t0) + var(--k) * var(--passo) + 0.7s); }
  .em-cena .rotulo { opacity: 1; }

  /* Junções: acendem quando o círculo fecha. */
  .juncao { fill: var(--white); stroke: var(--red-500); stroke-width: 3; transform-box: fill-box; transform-origin: center; opacity: 0; transform: scale(0.3); transition: opacity 0.4s ease calc(var(--t0) + 3 * var(--passo) + var(--k) * 0.12s), transform 0.5s var(--ease-out) calc(var(--t0) + 3 * var(--passo) + var(--k) * 0.12s); }
  .em-cena .juncao { opacity: 1; transform: none; }

  /* Cards dos pilares: cada um entra junto com o arco dele. */
  .cards { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .card { padding: var(--space-6) var(--space-6) var(--space-8); border-radius: var(--radius-md); background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--navy-900); opacity: 0; transform: translateY(16px); transition: opacity 0.6s var(--ease-out) calc(var(--t0) + var(--k) * var(--passo) + 0.3s), transform 0.7s var(--ease-out) calc(var(--t0) + var(--k) * var(--passo) + 0.3s); }
  .card.p1 { border-top-color: var(--navy-700); }
  .card.p2 { border-top-color: var(--red-600); }
  .em-cena .card { opacity: 1; transform: none; }
  .card h3 { font-family: var(--font-display); font-size: var(--fs-xl); text-transform: uppercase; letter-spacing: 0.06em; }
  .card p { margin-top: var(--space-3); font-size: var(--fs-sm); line-height: 1.6; color: var(--color-text-muted); }

  @media (max-width: 760px) {
    .intro { font-size: var(--fs-xl); }
    .marca, .circuito, .circuito-no { display: none; }
    .rotulo { font-size: 22px; letter-spacing: 0.14em; }
    .cards { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pilar, .faixa, .rotulo, .juncao, .disco, .marca-proc, .card, .marca { transition: none !important; }
  }
</style>
