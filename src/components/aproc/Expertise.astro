---
/**
 * "Nossa expertise": os três resumos de área como feature cards, cada um
 * aberto pela cena em linha da área (a mesma CenaArea dos cards da Home, na
 * linguagem do descanso de tela Sinal). Infraestrutura, nuvem e visão, nessa
 * ordem, que é a ordem dos cards em aproc.ts.
 *
 * As cenas se desenham quando a seção aparece e só andam enquanto ela está na
 * tela. No hover o card sobe um pouco, a borda e o título acendem.
 *
 * Texto: eyebrow, titulo, paragrafos e cards do bloco, sem alteração.
 */
import CenaArea from "../preview/CenaArea.astro";
import type { Bloco } from "../../data/preview/blocos";

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
---

<section class="ap-secao expertise" data-theme="light" data-cena>
  <div class="container">
    <div class="ap-cabeca">
      {bloco.eyebrow && <p class="eyebrow ap-entra" style="--i:0">{bloco.eyebrow}</p>}
      {bloco.titulo && <h2 class="ap-entra" style="--i:1">{bloco.titulo}</h2>}
      {bloco.paragrafos?.map((p) => <p class="ap-p ap-entra" style="--i:2">{p}</p>)}
    </div>

    <div class="eco grade" data-expertise>
      {bloco.cards?.map((c, i) => (
        <article class="card ap-entra" style={`--i:${i + 3}`}>
          <div class="card-visual" aria-hidden="true"><CenaArea indice={i} /></div>
          <div class="card-corpo">
            <h3>{c.titulo}</h3>
            {c.paragrafos?.map((p) => <p>{p}</p>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-12); align-items: stretch; }
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(11, 23, 48, 0.04), 0 12px 32px -18px rgba(11, 23, 48, 0.18);
  }
  /* O ap-entra cuida da entrada; depois dela, o hover. */
  .em-cena .card { transition: opacity 0.7s var(--ease-out) calc(var(--i) * 0.12s), transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out), border-color 0.3s ease; }
  .em-cena .card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: rgba(226, 8, 29, 0.45);
    box-shadow: 0 2px 4px rgba(11, 23, 48, 0.05), 0 28px 56px -24px rgba(11, 23, 48, 0.32);
  }
  .card-visual {
    display: grid;
    place-items: center;
    height: 180px;
    background:
      radial-gradient(70% 90% at 70% 20%, rgba(226, 8, 29, 0.1), transparent 60%),
      radial-gradient(120% 100% at 50% 0%, var(--navy-800), var(--navy-950) 80%);
  }
  .card-corpo { padding: var(--space-8); }
  .card h3 { font-size: var(--fs-lg); transition: color 0.3s ease; }
  .card:hover h3 { color: var(--red-600); }
  .card-corpo p { margin-top: var(--space-3); font-size: var(--fs-sm); line-height: 1.6; color: var(--color-text-muted); }

  @media (max-width: 900px) {
    .grade { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .em-cena .card:hover { transform: none; }
  }
</style>

<script>
  import { semMovimento } from "../../scripts/aprocCenas";

  // As cenas (CenaArea) esperam .desenhado e .vivo no .eco que as contém.
  document.querySelectorAll<HTMLElement>("[data-expertise]").forEach((eco) => {
    const svgs = Array.from(eco.querySelectorAll<SVGSVGElement>("svg[data-cena-area]"));
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) eco.classList.add("desenhado");
        eco.classList.toggle("vivo", e.isIntersecting);
        svgs.forEach((s) => (e.isIntersecting && !semMovimento ? s.unpauseAnimations() : s.pauseAnimations()));
      },
      { threshold: 0.2 },
    ).observe(eco);
  });
</script>
