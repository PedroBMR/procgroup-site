---
/**
 * Cabeçalho do preview da reestruturação: o menu que o documento pede.
 *
 * TEMPORÁRIO, fora do site que está no ar. Diferenças em relação ao Header de
 * produção, todas vindas do documento de 2026-10-05:
 *
 *   1. Não existe item "Home". A logo leva para a raiz.
 *   2. Soluções vira mega-menu de três colunas, uma por área, com os 22
 *      subitens. O Header de produção faz dropdown de coluna única.
 *   3. Entram "Parcerias" e "Proc City".
 *   4. Cases não aparece, o que bate com secoes.cases = false desde 2026-09-25.
 */
import { withBase } from "../../utils/url";
import ProcMark from "../ProcMark.astro";
import { menu } from "../../data/preview/ajustes";

interface Props {
  atual?: string;
}
const { atual = "" } = Astro.props;
---

<div class="aviso-preview">
  <strong>Preview da reestruturação</strong>
  <span>Isto não é o site no ar. É o documento "Ajustes no site" montado para você ver.</span>
  <a href={withBase("/preview")}>Voltar ao início do preview</a>
</div>

<header class="topo">
  <div class="caixa">
    <a href={withBase("/preview")} class="marca" aria-label="Proc Group, início">
      <ProcMark size={30} />
      <span>PROC<b> GROUP</b></span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul>
        {menu.map((item) => (
          <li class:list={["item", { "tem-mega": "blocos" in item }]}>
            <a
              href={item.externo ? item.href : withBase(item.href)}
              class:list={["link", { ativo: atual === item.href }]}
            >
              {item.label}
              {"blocos" in item && (
                <svg aria-hidden="true" width="10" height="6" viewBox="0 0 10 6" fill="none">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </a>

            {"blocos" in item && (
              <div class="mega">
                <div class="mega-caixa">
                  {item.blocos.map((bloco) => (
                    <div class="coluna">
                      <a href={withBase(bloco.href)} class="coluna-titulo">{bloco.area}</a>
                      <ul>
                        {bloco.itens.map((sub) => (
                          <li><a href={withBase(bloco.href)}>{sub}</a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .aviso-preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--red-600, #b8081a);
    color: var(--white);
    font-size: var(--fs-xs);
  }
  .aviso-preview strong { font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .aviso-preview span { opacity: 0.85; }
  .aviso-preview a {
    margin-left: auto;
    display: inline-flex; align-items: center; min-height: 44px;
    padding-inline: var(--space-2);
    color: var(--white); text-decoration: underline; text-underline-offset: 3px;
  }

  .topo {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(6, 10, 20, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .caixa {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .marca b { color: var(--color-text-faint); font-weight: 800; }

  .nav { margin-left: auto; }
  .nav > ul { display: flex; align-items: center; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .item { position: relative; }
  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    min-height: 44px;
    border-radius: var(--radius-sm);
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .link:hover, .link.ativo { color: var(--white); background: rgba(255, 255, 255, 0.07); }

  /* Mega-menu: três colunas, uma por área de negócio. */
  .mega {
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease, visibility var(--dur-fast);
  }
  .item:hover .mega, .item:focus-within .mega { opacity: 1; visibility: visible; transform: none; }

  .mega-caixa {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--navy-900);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .coluna-titulo {
    display: block;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-base);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .coluna-titulo:hover { color: var(--red-400); }
  .coluna ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .coluna li a {
    display: block;
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    font-size: var(--fs-sm);
    line-height: 1.35;
  }
  .coluna li a:hover { color: var(--white); background: rgba(255, 255, 255, 0.06); }

  @media (max-width: 1100px) {
    .caixa { flex-wrap: wrap; gap: var(--space-4); }
    .nav { margin-left: 0; width: 100%; overflow-x: auto; }
    .mega { position: static; opacity: 1; visibility: visible; transform: none; padding-top: 0; display: none; }
    .item:hover .mega { display: block; }
    .mega-caixa { grid-template-columns: 1fr; }
  }
</style>
