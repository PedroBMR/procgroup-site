---
// Faixa de scroll infinito reforçando a integração da plataforma —
// reinterpretação do ticker "RUAS · BAIRROS · CIDADES · TODOS CONECTADOS"
// visto em site de concorrente, usando a linguagem e o tagline que a Proc
// já usa. O fecho NAO pode afirmar que uma plataforma atende governo e
// corporativo ao mesmo tempo — regra dura de 2026-08-26.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const t = useTranslations(getLangFromUrl(Astro.url)).ticker;
const items = t.items;
// O fecho são duas frases, não uma só: antes vinham grudadas numa string
// ("Engenharia própria. Tudo conectado.") e o ponto final fazia o papel de
// separador — o único ponto da faixa inteira. Como array, cada frase é um item
// como os outros, e quem separa é o losango vermelho.
const highlight = t.highlight;

// A trilha anda exatamente UMA cópia por ciclo (-100%/COPIAS) e recomeça; como
// a cópia seguinte é idêntica, o salto é invisível. Para isso a tela precisa
// estar sempre coberta: (COPIAS - 1) cópias >= largura da viewport. Uma cópia
// mede ~1.200px, então com 2 cópias (o que havia antes) monitores de 1920px
// viam a faixa acabar e voltar do começo. 4 cópias cobrem até ~3.600px.
const COPIAS = 4;
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track" style={`--copias: ${COPIAS}`}>
    {Array.from({ length: COPIAS }).map(() => (
      <div class="ticker-group">
        {items.map((item) => (
          <>
            <span class="item">{item}</span>
            <span class="sep">◆</span>
          </>
        ))}
        {highlight.map((frase) => (
          <>
            <span class="item highlight">{frase}</span>
            <span class="sep">◆</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    background: var(--navy-900);
    border-block: 1px solid rgba(255,255,255,0.1);
    padding-block: var(--space-4);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 28s linear infinite;
  }
  .ticker-group { display: flex; align-items: center; flex-shrink: 0; }
  .item {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgba(255,255,255,0.55);
    white-space: nowrap;
    padding-inline: var(--space-6);
  }
  .item.highlight { color: var(--white); }
  /* --red-400, nao --red-500: sobre navy o vermelho de marca da 3,63:1 e
     reprova o AA. O manual ja manda usar o vermelho claro sobre fundo escuro
     ("labels e enfase sobre navy") — aqui as duas regras apontam para o mesmo
     token. O ticker inteiro e aria-hidden, entao o losango e decoracao pura,
     mas texto visivel abaixo do AA e ruim para quem enxerga pouco de qualquer
     jeito. */
  .sep { color: var(--red-400); font-size: 10px; }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% / var(--copias))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>
