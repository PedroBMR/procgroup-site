    realTag: "Case in operation",
    applicationTag: "Platform application",
    blockProblem: "Problem",
    blockChallenge: "Challenge",
    blockSolution: "Solution",
    finalCtaTitle: "Want a result like this in your operation?",
    finalCtaText: "Talk to a Proc specialist and find the right solution for your context.",
    items: [
      {
        unitSlug: "cidades-inteligentes",
        title: "Pato 360° — intelligent video-surveillance network in Southwest Paraná",
