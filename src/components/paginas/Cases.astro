---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../Breadcrumb.astro";
import Button from "../Button.astro";
import MediaPlaceholder from "../MediaPlaceholder.astro";
import { getBusinessUnit } from "../../data/businessUnits";
import { WHATSAPP_DEMO } from "../../data/contact";
import { getLangFromUrl, logicalPath, useTranslations, localePath } from "../../i18n/utils";
import { publicoDaUrl, publicoDefs } from "../../data/audiencia";
import { defaultLocale, type Locale } from "../../i18n/config";

const lang = getLangFromUrl(Astro.url);
// De que lado do site esta instancia esta montada — sai da URL, como no
// Header. Nas rotas legadas (fora de /governo e /empresas) publico e null:
// base vazia e nenhum filtro, ou seja, o comportamento de sempre.
const publico = publicoDaUrl(logicalPath(Astro.url));
const base = publico ? publicoDefs[publico].base : "";
const unidadesDoLado = publico ? publicoDefs[publico].unidades : null;
const tr = useTranslations(lang);

interface CaseItem {
  unitSlug: string;
  title: string;
  problem: string;
  challenge: string;
  solution: string;
  results: string[];
  isReal?: boolean;
  source?: string;
}
interface CasesCopy {
  metaDescription: string;
  heroEyebrow: string;
  heroTitle: string;
  heroLead: string;
  /** Explica a diferenca entre os dois tipos de bloco. Substitui o antigo
      banner de PLACEHOLDER: em vez de avisar que a pagina esta inacabada,
      diz o que e case em operacao e o que e capacidade da plataforma. */
  legend: string;
  realTag: string;
  applicationTag: string;
  blockProblem: string;
  blockChallenge: string;
  blockSolution: string;
  finalCtaTitle: string;
  finalCtaText: string;
  items: CaseItem[];
}

const casesI18n: Record<Locale, CasesCopy> = {
  pt: {
    metaDescription:
      "Cases de sucesso da Proc Group: problema, desafio, solução e resultados em Cidades Inteligentes, Ambientes Inteligentes, Infraestrutura de TI e IA Industrial.",
    heroEyebrow: "Cases",
    heroTitle: "O que a Proc resolve em cada unidade de negócio",
    heroLead:
      "Conheça como a Proc AI Platform resolve desafios concretos de segurança pública, ambientes corporativos, infraestrutura crítica e indústria.",
    legend:
      "Abaixo, um case em operação e as aplicações que a plataforma entrega nas demais unidades. Cada bloco indica qual é qual.",
    realTag: "Case em operação",
    applicationTag: "Aplicação da plataforma",
    blockProblem: "Problema",
    blockChallenge: "Desafio",
