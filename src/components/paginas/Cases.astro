        results: ["5 municipalities served via CPSI", "700+ AI cameras in Pato Branco", "Real-time alerts to the Military Police"],
        isReal: true,
        source: "Sources: public data from the Pato Branco/PR City Hall and City Council.",
      },
      {
        unitSlug: "ambientes-inteligentes",
        title: "Facial access control without replacing the turnstiles",
        problem: "Card-based turnstiles creating queues at shift changes and vulnerability to credential sharing.",
        challenge: "Raising the bar for access control without interrupting operations or replacing the hardware already installed.",
        solution: "Facial recognition integrated into the existing turnstiles via the Proc AI Platform's open API, with automatic fallback to the legacy devices during the transition.",
        results: ["No card or badge to carry", "A credential that cannot be lent", "Works with the hardware already installed"],
      },
      {
        unitSlug: "infraestrutura-de-ti",
        title: "Migration to hybrid cloud with operational continuity",
        problem: "Aging on-premises infrastructure, without redundancy, at risk of downtime during demand peaks.",
