---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactChannels from "../ContactChannels.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { metaDaPagina } from "../../data/metaPorPagina";
import { usePages } from "../../i18n/pages";
import type { Locale } from "../../i18n/config";

const lang = getLangFromUrl(Astro.url);
// De que lado do site esta instancia esta montada — sai da URL, como no
const tr = useTranslations(lang);
const t = usePages(lang).contato;
const m = metaDaPagina("contato", lang);
---

<BaseLayout title={m?.title ?? tr.nav.contato} description={m?.description ?? t.metaDescription}>
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>{t.heroTitleDefault}</h1>
      <p class="lead">{t.lead}</p>
    </div>
  </section>
  {/* O formulario saiu em 2026-09-25: a pagina entrega os canais diretos, que
       e o que a Proc quer que o visitante use hoje. O markup e o script dele
       estao guardados em components/FormularioContato.astro, sem uso. */}
  <section class="section">
    <div class="container">
      <ContactChannels />
    </div>
  </section>
</BaseLayout>
