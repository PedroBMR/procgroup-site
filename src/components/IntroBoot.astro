---
/**
 * Abertura da raiz: a marca se materializa a partir de um campo de pontos e
 * se dissolve de volta, entregando o seletor de público.
 *
 * Nuvem de pontos dispersa → converge para formar o símbolo e o nome → segura
 * → dispersa em fade. Nada de retícula, moldura ou linha cruzando a marca: a
 * tentativa anterior (cantos de detecção + eixos) cortava o símbolo ao meio e
 * o Pedro reprovou. Aqui não existe geometria por cima do logo — o logo É os
 * pontos.
 *
 * OS PONTOS SÃO A MARCA DE VERDADE: o script amostra os pixels de
 * `/brand/mark-red.webp` (o mesmo arquivo do favicon, sem redesenhar) e de
 * "PROC GROUP" na tipografia do site, e cada ponto carrega a cor que colheu.
 * O vermelho que aparece é o vermelho do próprio símbolo, não decoração.
 *
 * O "gradiente pontilhista": a densidade dos pontos cai com a distância do
 * foco luminoso — o miolo é sólido, as bordas rarefazem. É o gradiente que
 * faz a imagem parecer emergir em vez de simplesmente aparecer.
 *
 * A abertura se desfaz SOZINHA no CSS (fade que zera visibilidade em 3.1s).
 * Deliberado: se o JS falhar ou for bloqueado, o que fica é a marca estática
 * no mesmo lugar, com o mesmo fade — ninguém trava numa tela de carregamento.
 * O canvas só entra quando o script confirma que conseguiu montá-lo.
 *
 * Decorativa: aria-hidden — "PROC GROUP" já está no conteúdo da página, e
 * leitor de tela não deve esperar por uma animação. O botão de pular fica
 * fora, e é focável.
 *
 * (O nome do arquivo é histórico: a primeira versão era uma tela de boot.)
 */
import ProcMark from "./ProcMark.astro";
import { withBase } from "../utils/url";
import { usePages } from "../i18n/pages";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = usePages(lang).comecar.intro;
---

<div class="intro" data-intro data-marca={withBase("/brand/mark-red.webp")}>
  <div class="cena" aria-hidden="true">
    <canvas></canvas>

    <!-- Fallback: é isto que aparece se o canvas não montar. Mesmo lugar,
         mesmo fade — o script esconde este bloco quando assume. -->
    <div class="estatico">
      <ProcMark size={92} />
      <p class="saudacao">{t.saudacao}</p>
      <p class="marca">PROC<span> GROUP</span></p>
    </div>
  </div>

  <button type="button" class="pular" data-pular>{t.pular}</button>
</div>

<style>
  /* ── Linha do tempo ──────────────────────────────────────────────────────
     0.15s  pontos surgem dispersos e começam a convergir (1.15s, escalonado)
     1.75s  marca formada, segurando
     2.30s  pontos dispersam
     2.45s  a tela inteira sai em fade (0.6s)
     3.10s  fora do caminho — a página assume
     Estes tempos e o `--t` do seletor (index.astro) andam juntos. */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--navy-950);
    /* O foco luminoso por trás dos pontos: é o que dá o gradiente à nuvem. */
    background-image: radial-gradient(58% 52% at 50% 46%, rgba(37, 56, 102, 0.5), transparent 72%);
    animation: sairEmFade 0.65s ease-in 2.45s forwards;
  }
  @keyframes sairEmFade {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  .cena { position: absolute; inset: 0; }
  .cena canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* ── Fallback estático (sem canvas) ── */
  .estatico {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    animation: entrarSuave 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .intro.com-canvas .estatico { display: none; }
  @keyframes entrarSuave {
    from { opacity: 0; transform: translateY(10px) }
    to   { opacity: 1; transform: none }
  }

  .saudacao {
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    text-indent: 0.34em; /* o espaçamento da última letra desloca o bloco */
    color: var(--color-text-faint);
  }
  .marca {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 6.5vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--white);
  }
  .marca span { color: var(--color-text-faint); }

  .pular {
    position: absolute;
    right: var(--space-6);
    bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    min-height: 40px;
    border: 0;
    background: transparent;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    cursor: pointer;
    animation: entrarSuave 0.5s ease-out 1.1s both;
  }
  .pular:hover { color: var(--color-text); }

  /* Saída antecipada: some de uma vez e o nó é removido pelo script. */
  .intro.is-pulando { animation: none; opacity: 0; transition: opacity 0.28s ease; pointer-events: none; }

  @media (max-width: 640px) {
    .pular { right: var(--space-4); bottom: var(--space-4); }
  }

  /* Quem pediu menos movimento não recebe abertura nenhuma: a página já começa
     no seletor (o `--t` do painel também zera, em index.astro). */
  @media (prefers-reduced-motion: reduce) {
    .intro { display: none; }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>("[data-intro]");

  if (intro) {
    /** Tira a abertura da frente; `agora` solta a entrada da página na hora. */
    const encerrar = (agora: boolean) => {
      if (agora) {
        document.documentElement.classList.add("intro-pulada");
        intro.classList.add("is-pulando");
      }
      window.setTimeout(() => intro.remove(), agora ? 300 : 0);
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("intro-pulada");
      intro.remove();
    } else {
      const pular = () => encerrar(true);
      intro.querySelector("[data-pular]")?.addEventListener("click", pular);
      intro.querySelector(".cena")?.addEventListener("click", pular);
      document.addEventListener("keydown", (e) => e.key === "Escape" && pular(), { once: true });
      // Fim natural: o CSS já tirou a tela do caminho; isto só limpa o nó.
      window.setTimeout(() => encerrar(false), 3300);

      montarPontos(intro);
    }
  }

  interface Ponto {
    ax: number; ay: number; // de onde vem
    x: number; y: number;   // onde forma a imagem
    r: number; g: number; b: number;
    a: number;              // opacidade final (o gradiente da nuvem)
    d: number;              // atraso próprio, em segundos
    s: number;              // lado do ponto
    fx: number; fy: number; // direção da dispersão
  }

  /* Tempos, em segundos — espelham o comentário da folha de estilo. */
  const CONV_INI = 0.15, CONV_DUR = 1.15, ESCALONA = 0.45;
  const DISP_INI = 2.3, DISP_DUR = 0.8;
  const TETO_PONTOS = 2800;

  async function montarPontos(intro: HTMLElement) {
    const canvas = intro.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const W = window.innerWidth, H = window.innerHeight;
    if (!W || !H) return;

    // A tipografia precisa estar carregada antes de virar pixel: amostrar a
    // fonte de fallback desenharia outra marca.
    try {
      await document.fonts?.ready;
    } catch {
      // Navegador sem a API: segue com o que estiver carregado.
    }

    const marca = await carregarMarca(intro.dataset.marca);
    const pontos = amostrar(W, H, marca);
    if (pontos.length < 80) return; // amostragem falhou: fica o estático

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const inicio = performance.now();
    let raf = 0;
    let montado = false;

    const quadro = (agora: number) => {
      const t = (agora - inicio) / 1000;
      ctx.clearRect(0, 0, W, H);

      // A troca acontece no primeiro quadro DESENHADO, não na montagem: se o
      // rAF nunca rodar, o estático continua no lugar em vez de sobrar uma
      // tela vazia. E como o estático só começa a aparecer em 0.25s, a troca
      // (um quadro depois da montagem) não pisca.
      if (!montado) {
        montado = true;
        intro.classList.add("com-canvas");
      }

      const dispersao = suavizar(faixa(t, DISP_INI, DISP_DUR));

      for (const p of pontos) {
        const c = suavizar(faixa(t, CONV_INI + p.d, CONV_DUR));
        if (c <= 0) continue;

        // Converge da nuvem para a imagem; depois escapa na sua direção.
        const x = p.ax + (p.x - p.ax) * c + p.fx * dispersao * 90;
        const y = p.ay + (p.y - p.ay) * c + p.fy * dispersao * 90;
        const alfa = p.a * c * (1 - dispersao);
        if (alfa <= 0.01) continue;

        ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},${alfa})`;
        ctx.fillRect(x, y, p.s, p.s);
      }

      if (t < DISP_INI + DISP_DUR) raf = requestAnimationFrame(quadro);
    };

    raf = requestAnimationFrame(quadro);
    // O nó some com a abertura; cancelar evita um quadro órfão no meio.
    window.setTimeout(() => cancelAnimationFrame(raf), 3300);
  }

  /** Progresso 0→1 de uma fase que começa em `ini` e dura `dur`. */
  function faixa(t: number, ini: number, dur: number) {
    return Math.min(Math.max((t - ini) / dur, 0), 1);
  }
  /** Desaceleração no fim: o mesmo easing das entradas do site. */
  function suavizar(p: number) {
    return 1 - Math.pow(1 - p, 3);
  }

  function carregarMarca(src?: string): Promise<HTMLImageElement | null> {
    if (!src) return Promise.resolve(null);
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve(img);
      // Sem o símbolo a nuvem forma só o nome — vale mais que travar a abertura.
      img.onerror = () => resolve(null);
      img.src = src;
    });
  }

  /**
   * Desenha a composição num canvas fora da tela, lê os pixels e transforma em
   * pontos. Cada ponto guarda a cor que colheu: o vermelho da nuvem é o
   * vermelho do próprio símbolo.
   */
  function amostrar(W: number, H: number, marca: HTMLImageElement | null): Ponto[] {
    const off = document.createElement("canvas");
    off.width = W;
    off.height = H;
    const o = off.getContext("2d", { willReadFrequently: true });
    if (!o) return [];

    const tamMarca = Math.round(Math.min(Math.max(W * 0.075, 68), 128));
    const corpo = Math.round(Math.min(Math.max(W * 0.072, 34), 96));
    const vao = Math.round(corpo * 0.42);
    const alturaBloco = (marca ? tamMarca + vao : 0) + corpo;
    const topo = Math.round(H / 2 - alturaBloco / 2);

    if (marca) {
      o.drawImage(marca, Math.round(W / 2 - tamMarca / 2), topo, tamMarca, tamMarca);
    }

    o.fillStyle = "#ffffff";
    o.textAlign = "center";
    o.textBaseline = "top";
    o.font = `800 ${corpo}px "Barlow Condensed", "Space Grotesk", system-ui, sans-serif`;
    o.fillText("PROC GROUP", W / 2, topo + (marca ? tamMarca + vao : 0));

    // Recorte generoso ao redor do bloco: ler a tela inteira é desperdício.
    const larguraTexto = Math.min(o.measureText("PROC GROUP").width + 40, W);
    const x0 = Math.max(0, Math.round(W / 2 - larguraTexto / 2) - 10);
    const y0 = Math.max(0, topo - 10);
    const bw = Math.min(W - x0, Math.round(larguraTexto) + 20);
    const bh = Math.min(H - y0, alturaBloco + 20);
    if (bw <= 0 || bh <= 0) return [];

    const dados = o.getImageData(x0, y0, bw, bh).data;

    // O foco luminoso: densidade cheia no miolo, rarefeita nas bordas. É este
    // gradiente que faz a marca emergir da nuvem em vez de piscar pronta.
    const focoX = W / 2;
    const focoY = topo + alturaBloco * 0.42;
    const raio = Math.max(alturaBloco, 1) * 1.5;

    const pontos: Ponto[] = [];
    const passo = 3;

    for (let y = 0; y < bh; y += passo) {
      for (let x = 0; x < bw; x += passo) {
        const i = (y * bw + x) * 4;
        if (dados[i + 3] < 110) continue;

        const gx = x0 + x, gy = y0 + y;
        const dist = Math.hypot(gx - focoX, gy - focoY) / raio;
        const densidade = Math.max(0, 1 - dist * dist * 0.8);
        if (Math.random() > 0.3 + densidade * 0.7) continue;

        // Nasce num anel largo em volta: a nuvem se fecha sobre a imagem.
        const ang = Math.random() * Math.PI * 2;
        const raioIni = 220 + Math.random() * 620;

        pontos.push({
          ax: gx + Math.cos(ang) * raioIni,
          ay: gy + Math.sin(ang) * raioIni * 0.7,
          x: gx,
          y: gy,
          r: dados[i], g: dados[i + 1], b: dados[i + 2],
          a: 0.42 + densidade * 0.58,
          // Escalonado da esquerda para a direita: a marca se escreve.
          d: (x / bw) * ESCALONA + Math.random() * 0.12,
          s: gy < topo + tamMarca ? 2 : 1.8,
          fx: Math.cos(ang) * 0.5 + (Math.random() - 0.5),
          fy: -0.7 - Math.random() * 0.6,
        });
      }
    }

    // Teto de segurança: telas grandes com fonte gorda passariam disso.
    if (pontos.length > TETO_PONTOS) {
      const salto = pontos.length / TETO_PONTOS;
      const cortado: Ponto[] = [];
      for (let i = 0; i < pontos.length; i += salto) cortado.push(pontos[Math.floor(i)]);
      return cortado;
    }
    return pontos;
  }
</script>
